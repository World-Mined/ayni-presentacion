---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'AYNI - El Retorno Sagrado de la Energía',
  description = 'Descubre y conecta con el poder de la naturaleza junto a AYNI.',
} = Astro.props;
---

<!DOCTYPE html>
<!-- `data-layout` acota las reglas globales de v2.css a las páginas del sitio. -->
<html lang="es" data-layout="website">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og-image.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Montserrat:wght@400;600;700&family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="AYNI" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script>
      import { registerSW } from 'virtual:pwa-register';
      if (import.meta.env.DEV) {
        const hadActiveWorker = 'serviceWorker' in navigator && Boolean(navigator.serviceWorker.controller);
        const unregisterWorkers = 'serviceWorker' in navigator
          ? navigator.serviceWorker.getRegistrations().then((registrations) => Promise.all(registrations.map((registration) => registration.unregister())))
          : Promise.resolve([]);
        const clearCaches = 'caches' in window
          ? caches.keys().then((keys) => Promise.all(keys.map((key) => caches.delete(key))))
          : Promise.resolve([]);
        void Promise.all([unregisterWorkers, clearCaches]).then(() => {
          const cleanupKey = 'ayni-dev-pwa-cleanup-v2';
          if (hadActiveWorker && sessionStorage.getItem(cleanupKey) !== 'done') {
            sessionStorage.setItem(cleanupKey, 'done');
            window.location.reload();
          }
        });
      } else {
        // Producción activa cada build nueva de inmediato. Antes se emitían
        // además `pwa-update-available` y `pwa-offline-ready`, que escuchaba
        // PWA.astro para mostrar un aviso; ese componente ya no se monta, así
        // que los eventos no tenían destinatario. Si se recupera esa UI, hay
        // que volver a emitirlos aquí.
        const updateSW = registerSW({
          immediate: true,
          onNeedRefresh() {
            void updateSW(true);
          },
        });
      }
    </script>

    <style is:global>
      :root {
        --color-brand-gold: #f3c864;
      }

      /* Reset base. Vive aquí y no en una hoja aparte porque toda página
         servida por este layout lo necesita, la importe o no: `offline.astro`
         no carga v2.css, y sin esto caía al `margin: 8px` del navegador con un
         marco blanco alrededor. */
      html,
      body {
        margin: 0;
        padding: 0;
        max-width: 100%;
        background: #000;
        color: #fff;
      }
    </style>
  </head>
  <body><slot /></body>
</html>
