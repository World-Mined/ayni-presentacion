---
interface Props {
  title?: string;
  description?: string;
  variant?: 'website' | 'presentation';
}

const {
  title = 'AYNI - El Retorno Sagrado de la Energía',
  description = 'Descubre y conecta con el poder de la naturaleza junto a AYNI.',
  variant = 'presentation',
} = Astro.props;
const viewport = variant === 'website'
  ? 'width=device-width, initial-scale=1.0, viewport-fit=cover'
  : 'width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover';
---

<!DOCTYPE html>
<html lang="es" data-layout={variant}>
  <head>
    <script is:inline>
      (() => {
        if (document.documentElement.dataset.layout !== 'presentation') return;
        const mobileBreakpoint = 1024;
        const tabletBreakpoint = 1440;
        const isTouchDevice = navigator.maxTouchPoints > 0 || window.matchMedia('(pointer: coarse)').matches;
        const isPortrait = window.innerHeight >= window.innerWidth;
        const isMobile = window.innerWidth <= mobileBreakpoint || (isTouchDevice && isPortrait && window.innerWidth <= tabletBreakpoint);
        document.documentElement.dataset.presentationMode = isMobile ? 'mobile' : 'desktop';
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content={viewport} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og-image.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Manrope:wght@400;500;600;700&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="AYNI" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script>
      import { registerSW } from 'virtual:pwa-register';
      if (import.meta.env.DEV) {
        const hadActiveWorker = 'serviceWorker' in navigator && Boolean(navigator.serviceWorker.controller);
        const unregisterWorkers = 'serviceWorker' in navigator
          ? navigator.serviceWorker.getRegistrations().then((registrations) => Promise.all(registrations.map((registration) => registration.unregister())))
          : Promise.resolve([]);
        const clearCaches = 'caches' in window
          ? caches.keys().then((keys) => Promise.all(keys.map((key) => caches.delete(key))))
          : Promise.resolve([]);
        void Promise.all([unregisterWorkers, clearCaches]).then(() => {
          const cleanupKey = 'ayni-dev-pwa-cleanup-v2';
          if (hadActiveWorker && sessionStorage.getItem(cleanupKey) !== 'done') {
            sessionStorage.setItem(cleanupKey, 'done');
            window.location.reload();
          }
        });
      } else {
        // Producción activa cada build nueva de inmediato. Antes se emitían
        // además `pwa-update-available` y `pwa-offline-ready`, que escuchaba
        // PWA.astro para mostrar un aviso; ese componente ya no se monta, así
        // que los eventos no tenían destinatario. Si se recupera esa UI, hay
        // que volver a emitirlos aquí.
        const updateSW = registerSW({
          immediate: true,
          onNeedRefresh() {
            void updateSW(true);
          },
        });
      }
    </script>

    <style is:global>
      :root {
        --color-brand-gold: #f3c864;
        --color-brand-gold-highlight: #e9c267;
        --color-brand-gold-muted: #cba34e;
        --slide-frame-left: 0px;
        --slide-frame-top: 0px;
        --slide-frame-scale: 1;
      }

      /* Reset base, sin distinguir variante. Vive aquí y no en una hoja
         aparte porque toda página servida por este layout lo necesita, la
         importe o no: `offline.astro` no carga v2.css, y sin esto caía al
         `margin: 8px` del navegador con un marco blanco alrededor. */
      html,
      body {
        margin: 0;
        padding: 0;
        max-width: 100%;
        background: #000;
        color: #fff;
      }

      html[data-layout='presentation'],
      html[data-layout='presentation'] body {
        width: 100%;
        height: 100%;
        overflow: hidden;
        overscroll-behavior-x: none;
        font-family: 'Montserrat', sans-serif;
        user-select: none;
        -webkit-user-select: none;
        -webkit-tap-highlight-color: transparent;
      }

      html[data-layout='presentation'] .slide-container {
        position: relative;
        width: 100%;
        max-width: 100%;
        height: 100dvh;
        overflow: hidden;
        background: #000;
      }
      html[data-layout='presentation'][data-presentation-mode='mobile'],
      html[data-layout='presentation'][data-presentation-mode='mobile'] body {
        width: var(--mobile-vw, 100%);
        max-width: 100%;
        height: var(--mobile-vh, 100dvh);
        overflow-x: clip;
      }
      html[data-layout='presentation'] .slide-content-wrapper { position:absolute;inset:0;width:100%;height:100%;background:#000; }
      html[data-layout='presentation'] .slide { position:absolute;inset:0;width:100%;height:100%;opacity:0;pointer-events:none;transition:opacity .5s cubic-bezier(.4,0,.2,1);z-index:1; }
      html[data-layout='presentation'] .slide.active { opacity:1;pointer-events:auto;z-index:10; }
    </style>
  </head>
  <body><slot /></body>
</html>
