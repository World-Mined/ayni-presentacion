---
import { Image } from 'astro:assets';
import ayniLogo from '../../assets/v2/ayni-logo.webp';
import { ROUTES, SECTION_IDS } from '../../data/v2';

export type SiteNavigationItem = 'home' | 'products' | 'pickup' | 'ambassadors' | 'legal';

interface Props {
  active?: SiteNavigationItem;
}

const { active = 'home' } = Astro.props;
// Solo la home tiene las secciones en la propia página; desde las rutas
// propias (productos, puntos de recojo) los anclajes tienen que volver a `/`.
const onLanding = active === 'home';
const sectionHref = (section: string) => onLanding ? `#${section}` : `${ROUTES.home}#${section}`;
---

<header class:list={['site-header', `site-header--${active}`]} data-site-header>
  <div class="site-header__top">
    <div class="site-header__top-inner">
      <span class="site-header__balance" aria-hidden="true"></span>
      <a class="brand" href={sectionHref(SECTION_IDS.home)} aria-label="AYNI, ir al inicio">
        <Image src={ayniLogo} alt="AYNI" widths={[112, 224]} sizes="112px" quality={90} />
      </a>

      <div class="site-header__actions">
        <a href={ROUTES.ambassadors} aria-current={active === 'ambassadors' ? 'page' : undefined}>
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 20V9l8-5 8 5v11M9 20v-6h6v6"/></svg>
          <span>Quiero ser embajador</span>
        </a>
        <a href={sectionHref(SECTION_IDS.tools)}>
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m14.7 6.3 3-3a4.2 4.2 0 0 1-5.5 5.5l-7.8 7.8a2.1 2.1 0 0 0 3 3l7.8-7.8a4.2 4.2 0 0 0 5.5-5.5l-3 3"/></svg>
          <span>Herramientas</span>
        </a>
        <span class="account-icon" aria-label="Cuenta de usuario" role="img">
          <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="9" r="3"/><path d="M6.8 18c1.1-2.4 2.8-3.6 5.2-3.6s4.1 1.2 5.2 3.6"/></svg>
        </span>
      </div>

      <button class="menu-trigger" type="button" aria-expanded="false" aria-controls="site-navigation" aria-label="Abrir menú" data-menu-trigger>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav id="site-navigation" class="site-nav" aria-label="Navegación principal" data-site-nav>
    <!-- Home usa `aria-current="location"` y no `page` porque desde la propia
         home es un ancla dentro de la página, no un destino aparte; Productos
         y Puntos de recojo sí son páginas y llevan `page`. El estado lo fija
         el servidor desde `active`: las tres entradas del nav son destinos, no
         secciones que haya que detectar al vuelo mientras se hace scroll. -->
    <a class:list={{ 'is-active': active === 'home' }} href={sectionHref(SECTION_IDS.home)} aria-current={active === 'home' ? 'location' : undefined} data-nav-link>Home</a>
    <a class:list={{ 'is-active': active === 'products' }} href={ROUTES.products} aria-current={active === 'products' ? 'page' : undefined} data-nav-link>Productos</a>
    <a class:list={{ 'is-active': active === 'pickup' }} href={ROUTES.pickup} aria-current={active === 'pickup' ? 'page' : undefined} data-nav-link>Puntos de recojo</a>
    <div class="site-nav__mobile-actions">
      <a href={ROUTES.ambassadors} aria-current={active === 'ambassadors' ? 'page' : undefined} data-nav-link>Quiero ser embajador</a>
      <a href={sectionHref(SECTION_IDS.tools)} data-nav-link>Herramientas</a>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const trigger = header?.querySelector<HTMLButtonElement>('[data-menu-trigger]');
  const nav = header?.querySelector<HTMLElement>('[data-site-nav]');

  if (header && trigger && nav) {
    const closeMenu = (restoreFocus = false) => {
      header.dataset.menuOpen = 'false';
      trigger.setAttribute('aria-expanded', 'false');
      trigger.setAttribute('aria-label', 'Abrir menú');
      document.body.classList.remove('menu-is-open');
      if (restoreFocus) trigger.focus();
    };
    const openMenu = () => {
      header.dataset.menuOpen = 'true';
      trigger.setAttribute('aria-expanded', 'true');
      trigger.setAttribute('aria-label', 'Cerrar menú');
      document.body.classList.add('menu-is-open');
      nav.querySelector<HTMLAnchorElement>('a')?.focus();
    };
    trigger.addEventListener('click', () => trigger.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu());
    nav.addEventListener('click', (event) => {
      if ((event.target as Element).closest('[data-nav-link]')) closeMenu();
    });
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') closeMenu(true);
    });
    const compactHeader = window.matchMedia('(max-width: 767px), (max-width: 1023px) and (max-height: 600px)');
    compactHeader.addEventListener('change', (event) => {
      if (!event.matches) closeMenu();
    });
  }
</script>

<style>
  .site-header { position:sticky;z-index:100;top:0;width:100%;height:104px;background:#000; }
  .site-header__top { height:64px;background:#000; }
  .site-header__top-inner { display:grid;grid-template-columns:1fr auto 1fr;align-items:center;width:min(100%,1440px);height:64px;margin-inline:auto;padding:12px 64px; }
  .brand { display:flex;width:112px;height:40px;align-items:center;justify-content:center; }
  .brand img { display:block;width:112px;height:auto; }
  .site-header__actions { display:flex;justify-self:end;align-items:center;gap:24px;height:40px; }
  .site-header__actions a { display:flex;min-height:40px;align-items:center;gap:8px;color:#b1a58d;font-family:Poppins,sans-serif;font-size:16px;line-height:40px;text-decoration:none; }
  .site-header__actions svg { display:none;width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round; }
  .account-icon { display:grid;width:40px;height:40px;place-items:center;color:#b1a58d; }
  .account-icon svg { display:block;width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.5; }
  .site-nav { display:flex;width:100%;height:40px;align-items:center;justify-content:center;gap:24px;padding:0 80px;background:#000;box-shadow:inset 0 1px rgba(0,0,0,.08); }
  .site-nav>a { display:flex;height:40px;align-items:center;justify-content:center;padding:0 5px;color:#b1a58d;font-family:Poppins,sans-serif;font-size:16px;line-height:40px;text-decoration:none; }
  .site-nav>a.is-active { color:#f9cb69;font-weight:600; }
  /* Mismo gesto que en el footer: color y un crecimiento leve. Aquí el origen
     va al centro y no a la izquierda porque los enlaces están en fila: así
     crecen sin desplazarse hacia un lado. `:focus-visible` acompaña al hover
     para que con teclado se vea lo mismo. */
  .site-nav>a,.site-header__actions a { transition:color .18s ease,transform .34s cubic-bezier(.22,.61,.36,1); }
  .site-nav>a:hover,.site-nav>a:focus-visible,.site-header__actions a:hover,.site-header__actions a:focus-visible { color:#f9cb69;transform:scale(var(--hover-scale,1.05)); }
  .site-nav__mobile-actions,.menu-trigger { display:none; }

  @media(max-width:767px),(max-width:1023px) and (max-height:600px){
    .site-header { height:64px; }
    .site-header__top-inner { grid-template-columns:44px 1fr 44px;padding:12px 16px; }
    .site-header__balance { display:block; }
    .brand { justify-self:center;width:96px; }
    .brand img { width:96px; }
    .site-header__actions { display:none; }
    .menu-trigger { display:grid;width:44px;height:44px;justify-self:end;place-content:center;gap:5px;padding:0;border:0;color:#b1a58d;background:transparent; }
    .menu-trigger span { display:block;width:23px;height:1px;background:currentColor;transition:transform .18s ease,opacity .18s ease; }
    [data-menu-open='true'] .menu-trigger span:first-child { transform:translateY(6px) rotate(45deg); }
    [data-menu-open='true'] .menu-trigger span:nth-child(2) { opacity:0; }
    [data-menu-open='true'] .menu-trigger span:last-child { transform:translateY(-6px) rotate(-45deg); }
    .site-nav { position:fixed;inset:64px 0 auto;display:grid;height:auto;max-height:calc(100dvh - 64px);justify-content:stretch;gap:0;padding:14px 24px 24px;transform:translateY(-120%);border-top:1px solid rgba(177,165,141,.12);background:#000;opacity:0;visibility:hidden;transition:transform .22s ease,opacity .18s ease,visibility .22s; }
    [data-menu-open='true'] .site-nav { transform:translateY(0);opacity:1;visibility:visible; }
    .site-nav>a { min-height:48px;justify-content:flex-start;border-bottom:1px solid rgba(177,165,141,.12); }
    /* En el desplegable los enlaces ocupan todo el ancho y llevan borde inferior:
       al escalar se saldrían del panel y engordarían esa línea. Solo color. */
    .site-nav>a:hover,.site-nav>a:focus-visible { transform:none; }
    .site-nav__mobile-actions { display:grid;margin-top:12px; }
    .site-nav__mobile-actions a { display:flex;min-height:48px;align-items:center;color:#b1a58d;font-size:14px;text-decoration:none; }
    .site-header--pickup { box-shadow:inset 0 -1px #987c40; }
    .site-header--pickup .brand { width:111px; }
    .site-header--pickup .brand img { width:111px; }
  }

  @media(min-width:768px) and (max-width:1100px) and (min-height:601px){
    .site-header__top-inner { padding-inline:32px; }
    .site-header__actions { gap:12px; }
    .site-header__actions a { font-size:13px; }
    .site-nav { padding-inline:32px; }
  }
</style>
