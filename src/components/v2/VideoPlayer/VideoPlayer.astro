---
interface Props {
  src: string;
  poster?: string;
  ariaLabel: string;
}

const { src, poster, ariaLabel } = Astro.props;
---

<div class="video-player is-paused" data-video-player tabindex="0" role="group" aria-label={ariaLabel}>
  <video
    class="video-player__media"
    data-video-media
    playsinline
    preload="metadata"
    poster={poster}
    aria-label={ariaLabel}
  >
    <source src={src} type="video/mp4" />
  </video>

  <div class="video-player__error" data-video-error role="alert" hidden>
    <p>No pudimos cargar el video.</p>
    <button type="button" data-video-retry>Intentar de nuevo</button>
  </div>

  <button class="video-player__center-play" type="button" data-video-toggle aria-label="Reproducir video">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.2 5.2v13.6L19 12 8.2 5.2Z"></path></svg>
  </button>

  <div class="video-player__controls" data-video-controls>
    <input
      class="video-player__progress"
      data-video-progress
      type="range"
      min="0"
      max="100"
      step="0.1"
      value="0"
      aria-label="Progreso del video"
    />

    <div class="video-player__control-row">
      <button class="video-player__button" type="button" data-video-toggle aria-label="Reproducir video">
        <svg data-icon-play viewBox="0 0 24 24" aria-hidden="true"><path d="M8.2 5.2v13.6L19 12 8.2 5.2Z"></path></svg>
        <svg data-icon-pause viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M7 5h3.5v14H7V5Zm6.5 0H17v14h-3.5V5Z"></path></svg>
      </button>

      <button class="video-player__button video-player__seek" type="button" data-video-seek="-10" aria-label="Retroceder 10 segundos">
        <svg viewBox="0 0 32 32" aria-hidden="true">
          <path d="M10.5 8H5V2.5"></path>
          <path d="M5.5 8A12 12 0 1 1 4.2 20"></path>
          <text x="16" y="20.2">10</text>
        </svg>
      </button>
      <button class="video-player__button video-player__seek" type="button" data-video-seek="10" aria-label="Adelantar 10 segundos">
        <svg viewBox="0 0 32 32" aria-hidden="true">
          <path d="M21.5 8H27V2.5"></path>
          <path d="M26.5 8A12 12 0 1 0 27.8 20"></path>
          <text x="16" y="20.2">10</text>
        </svg>
      </button>

      <button class="video-player__button" type="button" data-video-mute aria-label="Silenciar video">
        <svg data-icon-volume viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.25v5.5h4L13 19V5L8 9.25H4Zm11.2-.95a5 5 0 0 1 0 7.4l1.35 1.48a7 7 0 0 0 0-10.36L15.2 8.3Z"></path></svg>
        <svg data-icon-muted viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M4 9.25v5.5h4L13 19V5L8 9.25H4Zm11.1.15 1.4-1.4 2 2 2-2 1.4 1.4-2 2 2 2-1.4 1.4-2-2-2 2-1.4-1.4 2-2-2-2Z"></path></svg>
      </button>
      <input class="video-player__volume" data-video-volume type="range" min="0" max="1" step="0.05" value="1" aria-label="Volumen" />

      <span class="video-player__time" aria-live="off">
        <span data-video-current>0:00</span><span aria-hidden="true"> / </span><span data-video-duration>0:00</span>
      </span>

      <div class="video-player__spacer"></div>

      <div class="video-player__settings">
        <button class="video-player__button" type="button" data-video-settings aria-label="Velocidad de reproducción" aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m19.14 12.94.04-.94-.04-.94 2.03-1.58-1.92-3.32-2.39.96a7.2 7.2 0 0 0-1.62-.94L14.88 3h-3.84l-.36 3.18c-.58.24-1.12.56-1.62.94l-2.39-.96-1.92 3.32 2.03 1.58-.04.94.04.94-2.03 1.58 1.92 3.32 2.39-.96c.5.38 1.04.7 1.62.94l.36 3.18h3.84l.36-3.18c.58-.24 1.12-.56 1.62-.94l2.39.96 1.92-3.32-2.03-1.58ZM13 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Z"></path></svg>
        </button>
        <div class="video-player__menu" data-video-menu hidden>
          <span>Velocidad</span>
          {[0.75, 1, 1.25, 1.5, 2].map((rate) => (
            <button type="button" data-video-rate={rate} class:list={{ 'is-active': rate === 1 }}>{rate === 1 ? 'Normal' : `${rate}x`}</button>
          ))}
        </div>
      </div>

      <button class="video-player__button" type="button" data-video-fullscreen aria-label="Ver en pantalla completa">
        <svg data-icon-expand viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h5v2H7v3H5V5Zm9 0h5v5h-2V7h-3V5ZM5 14h2v3h3v2H5v-5Zm12 0h2v5h-5v-2h3v-3Z"></path></svg>
        <svg data-icon-collapse viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M10 10H5V8h3V5h2v5Zm4 0V5h2v3h3v2h-5Zm-4 4v5H8v-3H5v-2h5Zm4 0h5v2h-3v3h-2v-5Z"></path></svg>
      </button>
    </div>
  </div>
</div>

<script>
  const formatTime = (seconds: number) => {
    if (!Number.isFinite(seconds)) return '0:00';
    const minutes = Math.floor(seconds / 60);
    return `${minutes}:${Math.floor(seconds % 60).toString().padStart(2, '0')}`;
  };

  // `hidden` es una propiedad de HTMLElement, no de SVGElement: asignarla sobre
  // un <svg> crea un campo suelto en el objeto y no toca el atributo, así que
  // los iconos se quedaban congelados en su estado inicial. El atributo —que es
  // lo que mira el CSS— hay que escribirlo a mano.
  const setIconVisible = (root: Element, selector: string, visible: boolean) => {
    root.querySelectorAll(selector).forEach((icon) => icon.toggleAttribute('hidden', !visible));
  };

  type FullscreenDocument = Document & {
    webkitFullscreenElement?: Element | null;
    webkitExitFullscreen?: () => Promise<void> | void;
  };
  type FullscreenElement = HTMLElement & { webkitRequestFullscreen?: () => Promise<void> | void };

  const fullscreenElement = () => {
    const scope = document as FullscreenDocument;
    return document.fullscreenElement ?? scope.webkitFullscreenElement ?? null;
  };

  document.querySelectorAll<HTMLElement>('[data-video-player]').forEach((player) => {
    if (player.dataset.videoPlayerReady === 'true') return;
    player.dataset.videoPlayerReady = 'true';

    const video = player.querySelector<HTMLVideoElement>('[data-video-media]');
    const progress = player.querySelector<HTMLInputElement>('[data-video-progress]');
    const volume = player.querySelector<HTMLInputElement>('[data-video-volume]');
    const current = player.querySelector<HTMLElement>('[data-video-current]');
    const duration = player.querySelector<HTMLElement>('[data-video-duration]');
    const error = player.querySelector<HTMLElement>('[data-video-error]');
    const menu = player.querySelector<HTMLElement>('[data-video-menu]');
    const settings = player.querySelector<HTMLButtonElement>('[data-video-settings]');
    if (!video || !progress || !volume || !current || !duration || !error || !menu || !settings) return;

    let controlsTimer = 0;
    let clickTimer = 0;

    const setControlsVisible = () => {
      player.classList.remove('are-controls-hidden');
      window.clearTimeout(controlsTimer);
      // Con el menú abierto los controles no se esconden solos: se llevarían por
      // delante el desplegable que el usuario acaba de abrir.
      if (!video.paused && menu.hidden) {
        controlsTimer = window.setTimeout(() => player.classList.add('are-controls-hidden'), 2500);
      }
    };

    const setMenuOpen = (open: boolean) => {
      menu.hidden = !open;
      settings.setAttribute('aria-expanded', String(open));
      settings.classList.toggle('is-active', open);
      if (!open) setControlsVisible();
    };

    const updatePlayback = () => {
      const paused = video.paused;
      player.classList.toggle('is-paused', paused);
      player.classList.toggle('is-playing', !paused);
      setIconVisible(player, '[data-icon-play]', paused);
      setIconVisible(player, '[data-icon-pause]', !paused);
      player.querySelectorAll<HTMLButtonElement>('[data-video-toggle]').forEach((button) => {
        button.setAttribute('aria-label', paused ? 'Reproducir video' : 'Pausar video');
      });
      setControlsVisible();
    };

    const togglePlayback = async () => {
      if (video.paused) {
        try { await video.play(); } catch { error.hidden = false; }
      } else video.pause();
    };

    const updateMuted = () => {
      const muted = video.muted || video.volume === 0;
      setIconVisible(player, '[data-icon-volume]', !muted);
      setIconVisible(player, '[data-icon-muted]', muted);
      const mute = player.querySelector<HTMLButtonElement>('[data-video-mute]');
      mute?.setAttribute('aria-label', muted ? 'Activar sonido' : 'Silenciar video');
      mute?.setAttribute('aria-pressed', String(muted));
      volume.value = muted ? '0' : String(video.volume);
      volume.style.setProperty('--player-volume', `${Number(volume.value) * 100}%`);
    };

    const updateProgress = () => {
      const percent = video.duration ? (video.currentTime / video.duration) * 100 : 0;
      progress.value = String(percent);
      progress.style.setProperty('--player-progress', `${percent}%`);
      current.textContent = formatTime(video.currentTime);
    };

    // La duración también se pinta al arrancar: con los metadatos ya en caché el
    // `durationchange` ocurre antes de que este script llegue a escucharlo y el
    // contador se quedaba en 0:00 con el video entero cargado.
    const updateDuration = () => {
      duration.textContent = formatTime(video.duration);
      updateProgress();
    };

    const toggleFullscreen = async () => {
      const scope = document as FullscreenDocument;
      const target = player as FullscreenElement;
      if (fullscreenElement()) {
        if (document.exitFullscreen) await document.exitFullscreen();
        else await scope.webkitExitFullscreen?.();
      } else if (target.requestFullscreen) await target.requestFullscreen();
      else if (target.webkitRequestFullscreen) await target.webkitRequestFullscreen();
      else if ('webkitEnterFullscreen' in video) (video as HTMLVideoElement & { webkitEnterFullscreen: () => void }).webkitEnterFullscreen();
    };

    const updateFullscreen = () => {
      const active = fullscreenElement() === player;
      player.classList.toggle('is-fullscreen', active);
      setIconVisible(player, '[data-icon-expand]', !active);
      setIconVisible(player, '[data-icon-collapse]', active);
      player.querySelector<HTMLButtonElement>('[data-video-fullscreen]')?.setAttribute(
        'aria-label',
        active ? 'Salir de pantalla completa' : 'Ver en pantalla completa',
      );
    };

    player.querySelectorAll<HTMLButtonElement>('[data-video-toggle]').forEach((button) => button.addEventListener('click', togglePlayback));
    player.querySelectorAll<HTMLButtonElement>('[data-video-seek]').forEach((button) => button.addEventListener('click', () => {
      video.currentTime = Math.min(Math.max(video.currentTime + Number(button.dataset.videoSeek), 0), video.duration || 0);
      updateProgress();
    }));
    player.querySelector<HTMLButtonElement>('[data-video-mute]')?.addEventListener('click', () => {
      video.muted = !video.muted;
      updateMuted();
    });
    player.querySelector<HTMLButtonElement>('[data-video-fullscreen]')?.addEventListener('click', toggleFullscreen);
    player.querySelector<HTMLButtonElement>('[data-video-retry]')?.addEventListener('click', () => {
      error.hidden = true;
      video.load();
    });

    progress.addEventListener('input', () => {
      if (video.duration) video.currentTime = (Number(progress.value) / 100) * video.duration;
      updateProgress();
    });
    volume.addEventListener('input', () => {
      video.muted = false;
      video.volume = Number(volume.value);
      updateMuted();
    });

    settings.addEventListener('click', () => setMenuOpen(menu.hidden));
    player.querySelectorAll<HTMLButtonElement>('[data-video-rate]').forEach((button) => button.addEventListener('click', () => {
      video.playbackRate = Number(button.dataset.videoRate);
      player.querySelectorAll('[data-video-rate]').forEach((item) => item.classList.toggle('is-active', item === button));
      setMenuOpen(false);
    }));

    // El menú se cierra al tocar fuera. El listener vive en el documento porque
    // el clic puede caer en cualquier sitio de la página, y deja pasar el que
    // ocurre dentro del propio desplegable o sobre el botón que lo abre —si no,
    // ese mismo clic lo cerraría justo después de abrirlo.
    document.addEventListener('click', (event) => {
      if (menu.hidden) return;
      const target = event.target as Node | null;
      if (target && (menu.contains(target) || settings.contains(target))) return;
      setMenuOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        setMenuOpen(false);
        settings.focus();
      }
    });

    video.addEventListener('click', () => {
      // Con el menú abierto, el primer clic sobre el video sólo lo cierra: no
      // debería además pausar la reproducción.
      if (!menu.hidden) {
        setMenuOpen(false);
        return;
      }
      window.clearTimeout(clickTimer);
      clickTimer = window.setTimeout(togglePlayback, 220);
    });
    video.addEventListener('dblclick', () => {
      window.clearTimeout(clickTimer);
      toggleFullscreen();
    });
    video.addEventListener('play', updatePlayback);
    video.addEventListener('playing', updatePlayback);
    video.addEventListener('pause', updatePlayback);
    video.addEventListener('ended', updatePlayback);
    video.addEventListener('timeupdate', updateProgress);
    video.addEventListener('loadedmetadata', updateDuration);
    video.addEventListener('durationchange', updateDuration);
    video.addEventListener('volumechange', updateMuted);
    video.addEventListener('ratechange', () => {
      player.querySelectorAll<HTMLButtonElement>('[data-video-rate]').forEach((item) => {
        item.classList.toggle('is-active', Number(item.dataset.videoRate) === video.playbackRate);
      });
    });
    video.addEventListener('canplay', () => error.hidden = true);
    video.addEventListener('error', () => error.hidden = false);
    document.addEventListener('fullscreenchange', updateFullscreen);
    document.addEventListener('webkitfullscreenchange', updateFullscreen);

    player.addEventListener('pointermove', setControlsVisible);
    player.addEventListener('pointerleave', () => {
      if (!video.paused && menu.hidden) player.classList.add('are-controls-hidden');
    });
    player.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement;
      if (target.matches('input, button')) return;
      if (event.code === 'Space' || event.key.toLowerCase() === 'k') { event.preventDefault(); togglePlayback(); }
      else if (event.key === 'ArrowLeft') video.currentTime = Math.max(0, video.currentTime - 10);
      else if (event.key === 'ArrowRight') video.currentTime = Math.min(video.duration || 0, video.currentTime + 10);
      else if (event.key.toLowerCase() === 'm') video.muted = !video.muted;
      else if (event.key.toLowerCase() === 'f') toggleFullscreen();
    });

    updatePlayback();
    updateMuted();
    updateDuration();
    updateFullscreen();
  });
</script>

<style>
  .video-player { position:relative;width:100%;height:100%;overflow:hidden;color:#fff;background:#000;border-radius:inherit;isolation:isolate; }
  .video-player:focus-visible { outline:2px solid #f6c65b;outline-offset:3px; }
  .video-player__media { display:block;width:100%;height:100%;background:#000;object-fit:contain;cursor:pointer; }
  .video-player__center-play { position:absolute;top:50%;left:50%;z-index:3;display:grid;width:clamp(56px,6vw,72px);height:clamp(56px,6vw,72px);place-items:center;padding:0;color:#f6c65b;background:rgba(0,0,0,.72);border:1px solid rgba(246,198,91,.9);border-radius:50%;box-shadow:0 10px 32px rgba(0,0,0,.45);cursor:pointer;transform:translate(-50%,-50%);transition:transform 160ms ease,background 160ms ease; }
  .video-player__center-play:hover { background:rgba(20,16,8,.9);transform:translate(-50%,-50%) scale(1.05); }
  .video-player__center-play svg { width:28px;height:28px;margin-left:3px;fill:currentColor; }
  .video-player.is-playing .video-player__center-play { opacity:0;pointer-events:none; }
  .video-player__controls { position:absolute;right:0;bottom:0;left:0;z-index:4;padding:64px 18px 14px;background:linear-gradient(180deg,transparent 0%,rgba(0,0,0,.62) 55%,rgba(0,0,0,.94) 100%);opacity:0;pointer-events:none;transform:translateY(8px);transition:opacity 180ms ease,transform 180ms ease; }
  .video-player:hover .video-player__controls,.video-player:focus-within .video-player__controls,.video-player.is-paused .video-player__controls { opacity:1;pointer-events:auto;transform:translateY(0); }
  .video-player.are-controls-hidden .video-player__controls { opacity:0;pointer-events:none;transform:translateY(8px); }
  .video-player__progress,.video-player__volume { --player-progress:0%;appearance:none;background:transparent;cursor:pointer; }
  .video-player__progress { display:block;width:100%;height:18px;margin:0 0 2px; }
  .video-player__progress::-webkit-slider-runnable-track { height:4px;background:linear-gradient(90deg,#f6c65b 0%,#f6c65b var(--player-progress),rgba(255,255,255,.4) var(--player-progress),rgba(255,255,255,.4) 100%);border-radius:999px; }
  .video-player__progress::-webkit-slider-thumb,.video-player__volume::-webkit-slider-thumb { width:13px;height:13px;margin-top:-4.5px;background:#f6c65b;border:0;border-radius:50%;appearance:none; }
  .video-player__progress::-moz-range-track,.video-player__volume::-moz-range-track { height:4px;background:rgba(255,255,255,.4);border-radius:999px; }
  .video-player__progress::-moz-range-progress,.video-player__volume::-moz-range-progress { height:4px;background:#f6c65b;border-radius:999px; }
  .video-player__progress::-moz-range-thumb,.video-player__volume::-moz-range-thumb { width:13px;height:13px;background:#f6c65b;border:0;border-radius:50%; }
  .video-player__control-row { display:flex;min-height:36px;align-items:center;gap:5px; }
  .video-player__button { position:relative;display:grid;width:36px;height:36px;flex:0 0 auto;place-items:center;padding:0;color:rgba(255,255,255,.95);background:transparent;border:0;border-radius:50%;cursor:pointer; }
  .video-player__button:hover,.video-player__button.is-active { color:#f6c65b;background:rgba(255,255,255,.12); }
  .video-player__button svg { width:22px;height:22px;fill:currentColor; }
  .video-player__seek svg { overflow:visible;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round; }
  .video-player__seek text { fill:currentColor;stroke:none;font-family:Poppins,sans-serif;font-size:8px;font-weight:700;text-anchor:middle; }
  .video-player__volume { --player-volume:100%;width:78px;height:16px; }
  .video-player__volume::-webkit-slider-runnable-track { height:4px;background:linear-gradient(90deg,#fff 0%,#fff var(--player-volume),rgba(255,255,255,.35) var(--player-volume),rgba(255,255,255,.35) 100%);border-radius:999px; }
  .video-player__time { margin-left:5px;color:rgba(255,255,255,.9);font-family:Poppins,sans-serif;font-size:12px;white-space:nowrap; }
  .video-player__spacer { flex:1; }
  .video-player__settings { position:relative; }
  .video-player__menu { position:absolute;right:0;bottom:44px;width:126px;padding:8px;background:rgba(5,5,5,.94);border:1px solid rgba(246,198,91,.45);border-radius:10px;box-shadow:0 10px 30px rgba(0,0,0,.4); }
  .video-player__menu span { display:block;padding:4px 8px 7px;color:#c4bba8;font-family:Poppins,sans-serif;font-size:11px; }
  .video-player__menu button { display:block;width:100%;padding:6px 8px;color:#fff;background:transparent;border:0;border-radius:6px;font-family:Poppins,sans-serif;text-align:left;cursor:pointer; }
  .video-player__menu button:hover,.video-player__menu button.is-active { color:#f6c65b;background:rgba(246,198,91,.12); }
  .video-player__error { position:absolute;z-index:6;inset:0;display:grid;place-content:center;justify-items:center;background:rgba(0,0,0,.82);font-family:Poppins,sans-serif; }
  .video-player__error[hidden] { display:none; }
  .video-player__error p { margin:0 0 12px; }
  .video-player__error button { padding:9px 16px;color:#f6c65b;background:#000;border:1px solid #f6c65b;border-radius:999px;cursor:pointer; }
  [hidden] { display:none !important; }

  @media(max-width:640px){
    .video-player__controls { padding:44px 10px 8px; }
    .video-player__control-row { gap:1px; }
    .video-player__button { width:32px;height:32px; }
    .video-player__volume,.video-player__settings { display:none; }
    .video-player__time { font-size:10px; }
  }

  @media(prefers-reduced-motion:reduce){
    .video-player__center-play,.video-player__controls { transition:none; }
  }
</style>
