---
import iconCocreacion from '../../../assets/v2/ambassadors-cocreacion.svg';
import iconConexion from '../../../assets/v2/ambassadors-conexion.svg';
import iconProposito from '../../../assets/v2/ambassadors-proposito.svg';
import iconReciprocidad from '../../../assets/v2/ambassadors-reciprocidad.svg';
import iconSabiduria from '../../../assets/v2/ambassadors-sabiduria.svg';
import ambassadorsTexture from '../../../assets/v2/ambassadors-texture.svg';
import videoPoster from '../../../assets/v2/ambassadors-video-poster.webp';
import VideoPlayer from '../VideoPlayer/VideoPlayer.astro';
import { mediaUrl } from '../../../data/media';

// Los cinco pilares viven aquí y no en `data/v2.ts` porque no los comparte
// nadie más: PRODUCT_LINE está allí porque lo pintan dos composiciones. Cada
// icono conserva su tamaño de Figma —no todos son 24px— y el aro de 38px es
// el mismo para los cinco.
const PILLARS = [
  { icon: iconProposito, size: 24, label: 'Propósito global:', copy: 'Lleva nuestro bienestar al mundo.' },
  { icon: iconConexion, size: 24, label: 'Conexión auténtica:', copy: 'Herramientas exclusivas para expandir tu voz.' },
  { icon: iconSabiduria, size: 22, label: 'Sabiduría compartida:', copy: 'Capacitaciones para nutrir tu crecimiento.' },
  { icon: iconCocreacion, size: 21, label: 'Cocreación:', copy: 'Planifica tus metas de la mano de nuestro equipo.' },
  { icon: iconReciprocidad, size: 23, label: 'Reciprocidad:', copy: 'Beneficios que reconocen tu energía y resultados.' },
];
---

<section class="ambassadors-program" aria-labelledby="ambassadors-program-title">
  <div class="ambassadors-program__texture" aria-hidden="true">
    <img src={ambassadorsTexture.src} alt="" />
  </div>

  <div class="ambassadors-program__inner">
    <div class="ambassadors-program__intro">
      <h1 id="ambassadors-program-title">
        El ciclo infinito del<br /><span>crecimiento conjunto</span>?
      </h1>
      <p>
        Conoce nuestro Plan de Compensación, diseñado a tu medida. <strong>Desarrolla tu negocio
        como Embajador IBO independiente</strong> y estructura tu equipo libremente en un esquema
        binario, trinario o tetranario. Un modelo transparente que premia el equilibrio y el trabajo
        en equipo.
      </p>
    </div>

    <div class="ambassadors-program__video">
      <VideoPlayer
        src={mediaUrl('8201_AYNI+-+VIDEO+EMBAJADORES+-+WEB+-+1920_2.mp4')}
        poster={videoPoster.src}
        ariaLabel="Video del programa de embajadores AYNI"
      />
    </div>

    <ul class="ambassadors-program__pillars">
      {PILLARS.map((pillar) => (
        <li class="ambassadors-pillar">
          <div class="ambassadors-pillar__body">
            <span class="ambassadors-pillar__ring">
              <img src={pillar.icon.src} width={pillar.size} height={pillar.size} alt="" />
            </span>
            <p class="ambassadors-pillar__text"><strong>{pillar.label}</strong> {pillar.copy}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .ambassadors-program { position:relative;display:flex;justify-content:center;overflow:hidden;padding:80px;background:#000;isolation:isolate; }
  /* La textura se desborda del bloque igual que en Figma (222% de ancho) y se
     estira en vertical: el SVG viene con `preserveAspectRatio="none"`. */
  .ambassadors-program__texture { position:absolute;z-index:0;inset:-18.38% -61%;pointer-events:none; }
  .ambassadors-program__texture img { display:block;width:100%;height:100%; }
  /* La columna de contenido mide 1280 (1440 menos los 80 de padding a cada
     lado); los 1060 son sólo del video. De ahí que los pilares quepan 3 + 2:
     302 × 3 + 85 × 2 = 1076. */
  .ambassadors-program__inner { position:relative;z-index:1;display:flex;width:min(100%,1280px);flex-direction:column;align-items:center;gap:48px; }
  .ambassadors-program__intro { display:flex;width:100%;flex-direction:column;align-items:center;gap:16px;text-align:center; }
  .ambassadors-program h1 { max-width:806px;margin:0;color:#fff;font-family:Poppins,sans-serif;font-size:40px;font-weight:600;line-height:1.19;letter-spacing:0; }
  /* El tramo dorado del titular es el degradado de marca recortado sobre el
     texto; el resto de la frase se queda en blanco. */
  .ambassadors-program h1 span { background-image:var(--gold-text);-webkit-background-clip:text;background-clip:text;color:transparent; }
  .ambassadors-program__intro p { margin:0;color:#c4bba8;font-family:Poppins,sans-serif;font-size:18px;font-weight:400;line-height:26px; }
  .ambassadors-program__intro strong { color:#fff;font-weight:400; }

  .ambassadors-program__video { position:relative;width:min(100%,1060px);aspect-ratio:16/9;overflow:hidden;border-radius:16px; }

  .ambassadors-program__pillars { display:flex;width:100%;flex-wrap:wrap;justify-content:center;gap:48px 85px;margin:0;padding:0;list-style:none; }
  .ambassadors-pillar { display:flex;width:302px;max-width:100%;flex-direction:column;align-items:center;gap:4px; }
  /* Conector vertical sobre cada icono. En el frame móvil no existe, así que
     desaparece con la propia rejilla. */
  .ambassadors-pillar::before { content:"";width:1px;height:82px;background:#6e582b; }
  .ambassadors-pillar__body { display:flex;width:100%;flex-direction:column;align-items:center;gap:5.217px; }
  .ambassadors-pillar__ring { display:grid;width:38px;height:38px;flex:none;place-items:center;overflow:hidden;border:1px solid #6e582b;border-radius:50%; }
  .ambassadors-pillar__ring img { display:block; }
  .ambassadors-pillar__text { margin:0;color:#ae8e4a;font-family:Poppins,sans-serif;font-size:20px;font-weight:300;line-height:24px;text-align:center; }
  .ambassadors-pillar__text strong { display:block;font-weight:700; }
  /* Propósito global va un punto por debajo del resto: es así en los dos frames. */
  .ambassadors-pillar:first-child .ambassadors-pillar__text { font-size:16px;font-weight:400; }

  @media(max-width:767px){
    .ambassadors-program { padding:40px 16px; }
    .ambassadors-program__texture { inset:-18.1% -61%; }
    .ambassadors-program h1 { font-size:32px; }
    .ambassadors-program__intro p { font-size:16px; }
    .ambassadors-program__video { aspect-ratio:16/9; }
    .ambassadors-program__pillars { flex-direction:column;align-items:center;gap:48px; }
    .ambassadors-pillar::before { display:none; }
  }
</style>
