---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  lead: string;
  highlight: string;
  background: ImageMetadata;
  alt: string;
}

const { lead, highlight, background, alt } = Astro.props;
---

<section class="product-hero">
  <div class="product-hero__scene">
    <Image
      src={background}
      alt={alt}
      widths={[768, 1280, 1440]}
      sizes="100vw"
      quality={78}
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <h1 class="product-hero__title">
    <span>{lead}</span><span class="product-hero__highlight">{highlight}</span>
  </h1>
</section>

<style>
  /* El marco de Figma es 1440×600 con 80 px de padding. Igual que en
     `ProductsBanner`, la altura va en vw sobre ese divisor (600/1440 =
     41.667vw) y se congela con clamp al llegar a 1440. */
  .product-hero { position:relative;display:grid;min-height:clamp(360px,41.667vw,600px);align-items:center;padding:clamp(40px,5.556vw,80px);background:#000;isolation:isolate; }

  /* La misma línea dorada que separa el header del banner de /productos: en
     Figma es un SVG de 1280×1 con degradado transparente → #F9CB69 → transparente. */
  .product-hero::before { content:"";position:absolute;z-index:3;top:0;left:50%;width:min(100%,1280px);height:1px;transform:translateX(-50%);background:linear-gradient(90deg,transparent,#f9cb69 50%,transparent); }

  .product-hero__scene { position:absolute;z-index:0;inset:0; }
  .product-hero__scene :global(img) { display:block;width:100%;height:100%;object-fit:cover;object-position:center; }

  .product-hero__title { position:relative;z-index:2;width:min(100%,1280px);margin:0 auto;color:#ece9e3;font-family:var(--font-title);font-size:clamp(28px,3.333vw,48px);font-weight:500;letter-spacing:0;line-height:1.2084;text-align:center;text-wrap:balance; }

  /* El degradado dorado de marca recortado sobre el texto. `color:transparent`
     con `background-clip:text`; si el navegador no lo soporta se ve en el
     dorado plano del centro del degradado, que es legible igual. */
  .product-hero__highlight { color:#f9cb69;background-image:linear-gradient(90deg,#6e582b 10.512%,#f9cb69 50.363%,#f0c365 58.373%,#d8b05a 69.587%,#b29049 85.607%,#7d6431 103.23%,#6e582b 108.03%);-webkit-background-clip:text;background-clip:text; }
  @supports (background-clip:text) or (-webkit-background-clip:text) {
    .product-hero__highlight { color:transparent; }
  }
</style>
