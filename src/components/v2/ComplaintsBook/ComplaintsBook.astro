---
// Libro de reclamaciones. El formulario reproduce el diseño de Figma; el envío
// necesita un endpoint que todavía no existe: mientras `SUBMIT_ENDPOINT` esté
// vacío el formulario no envía nada y avisa al usuario por dónde reclamar.
const SUBMIT_ENDPOINT = '';

// Figma solo pinta el estado "Seleccionar" de los dos desplegables, así que las
// opciones son las del formato oficial del libro de reclamaciones.
const DOCUMENT_TYPES = ['DNI', 'Carné de extranjería', 'Pasaporte', 'RUC'];
const CLAIM_SUBJECTS = ['Producto', 'Servicio'];
---

<section class="claims">
  <div class="claims__inner">
    <div class="claims__company">
      <span class="claims__rule" aria-hidden="true"></span>
      <div class="claims__company-text">
        <p>FUTURE WORLD PRODUCTS S.A.C.</p>
        <p>RUC: 20614571242 - AYNI WORLD INTERNATIONAL S.A.C.</p>
        <p>Dirección: AV. JAVIER PRADO ESTE NRO. 7176 INT. 2 URB. COVIMA LIMA - LIMA - LA MOLINA</p>
      </div>
    </div>

    <form
      class="claims__form"
      method="post"
      action={SUBMIT_ENDPOINT || undefined}
      data-claims-form
      data-endpoint={SUBMIT_ENDPOINT}
    >
      <h2 class="claims__legend">Información del consumidor</h2>

      <p class="claims__field">
        <label for="claims-nombres">Nombres*</label>
        <input id="claims-nombres" name="nombres" type="text" placeholder="Nombres" required />
      </p>
      <p class="claims__field">
        <label for="claims-apellido-paterno">Apellido paterno*</label>
        <input id="claims-apellido-paterno" name="apellidoPaterno" type="text" placeholder="Apellido paterno" required />
      </p>
      <p class="claims__field">
        <label for="claims-apellido-materno">Apellido materno*</label>
        <input id="claims-apellido-materno" name="apellidoMaterno" type="text" placeholder="Apellido materno" required />
      </p>

      <h3 class="claims__legend claims__legend--sub">En caso de ser menor de edad</h3>
      <p class="claims__field">
        <label for="claims-tutor-nombre">Nombre de padre/madre</label>
        <input id="claims-tutor-nombre" name="tutorNombre" type="text" placeholder="Nombre de padre/madre" />
      </p>
      <p class="claims__field">
        <label for="claims-tutor-apellido">Apellido de padre/madre</label>
        <input id="claims-tutor-apellido" name="tutorApellido" type="text" placeholder="Apellido de padre/madre" />
      </p>

      <p class="claims__field">
        <label for="claims-domicilio">Domicilio*</label>
        <input id="claims-domicilio" name="domicilio" type="text" placeholder="Domicilio" required />
      </p>

      <div class="claims__row">
        <p class="claims__field claims__field--sm">
          <label for="claims-tipo-documento">Tipo de documento*</label>
          <select id="claims-tipo-documento" name="tipoDocumento" required>
            <option value="" selected disabled>Seleccionar</option>
            {DOCUMENT_TYPES.map((type) => <option value={type}>{type}</option>)}
          </select>
        </p>
        <p class="claims__field claims__field--sm">
          <label for="claims-numero-documento">N° de documento*</label>
          <input id="claims-numero-documento" name="numeroDocumento" type="text" placeholder="N° de documento" required />
        </p>
      </div>

      <p class="claims__field">
        <label for="claims-email">Correo electrónico*</label>
        <input id="claims-email" name="email" type="email" placeholder="Correo electrónico" required />
      </p>
      <p class="claims__field claims__field--sm">
        <label for="claims-telefono">N° de teléfono</label>
        <input id="claims-telefono" name="telefono" type="tel" placeholder="N° de teléfono" />
      </p>

      <h2 class="claims__legend">Información del producto o servicio</h2>
      <p class="claims__field claims__field--md">
        <label for="claims-producto">Producto o servicio*</label>
        <select id="claims-producto" name="producto" required>
          <option value="" selected disabled>Seleccionar</option>
          {CLAIM_SUBJECTS.map((subject) => <option value={subject}>{subject}</option>)}
        </select>
      </p>
      <p class="claims__field">
        <label for="claims-cuantia">Cuantía reclamada*</label>
        <input id="claims-cuantia" name="cuantia" type="text" placeholder="Monto objeto de reclamo" required />
      </p>

      <h2 class="claims__legend">Detalle del reclamo</h2>
      <fieldset class="claims__choices">
        <legend class="claims__sr-only">Tipo de disconformidad</legend>
        <label class="claims__choice">
          <input type="radio" name="tipoReclamo" value="reclamo" required />
          <span>Reclamo (Disconformidad relacionada a los productos y/o servicios)</span>
        </label>
        <label class="claims__choice">
          <input type="radio" name="tipoReclamo" value="queja" />
          <span>Queja (Disconformidad no relacionada a los productos y/o servicios o malestar o descontento a la atención al público)</span>
        </label>
      </fieldset>

      <p class="claims__field claims__field--area">
        <label for="claims-hechos">Descripción de los hechos*</label>
        <textarea id="claims-hechos" name="hechos" placeholder="Descripción de los hechos" required></textarea>
      </p>
      <p class="claims__field claims__field--area claims__field--area-sm">
        <label for="claims-solucion">Solicitud de solución*</label>
        <textarea id="claims-solucion" name="solucion" placeholder="Descripción de solicitud de solución" required></textarea>
      </p>

      <p class="claims__notice" data-claims-notice hidden>
        El envío del libro de reclamaciones aún no está habilitado. Escríbenos a <a href="mailto:soporte@ayniworld.com">soporte@ayniworld.com</a>.
      </p>

      <div class="claims__actions">
        <button type="submit">Enviar</button>
      </div>
    </form>
  </div>
</section>

<script>
  // Sin endpoint el navegador reenviaría la página a sí misma y perdería lo
  // escrito, así que se corta el envío y se dice a dónde escribir. En cuanto
  // `SUBMIT_ENDPOINT` tenga valor, el `action` toma el control y esto no actúa.
  const form = document.querySelector<HTMLFormElement>('[data-claims-form]');
  const notice = form?.querySelector<HTMLElement>('[data-claims-notice]');

  if (form && notice && !form.dataset.endpoint) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      notice.hidden = false;
      notice.scrollIntoView({ block: 'nearest' });
    });
  }
</script>

<style>
  .claims { padding:clamp(40px,6vw,80px) clamp(20px,9.45vw,136px) clamp(56px,9vw,120px);background:var(--black);font-family:var(--font-title); }
  .claims__inner { display:flex;width:min(100%,1168px);flex-direction:column;gap:48px;margin-inline:auto; }

  .claims__company { display:flex;align-items:stretch;gap:14px; }
  .claims__rule { width:5px;flex:none;background:#f9cb69; }
  .claims__company-text p { margin:0;color:#fcfcfb;font-size:16px;font-weight:300;line-height:20px; }

  .claims__form { display:flex;flex-direction:column;gap:20px;border-radius:20px; }
  .claims__legend { margin:0;color:#ae8e4a;font-size:16px;font-weight:700;letter-spacing:0;line-height:36px;text-transform:uppercase; }
  .claims__legend--sub { text-transform:none; }

  .claims__field { display:flex;margin:0;flex-direction:column;gap:4px; }
  .claims__field label { color:#ece9e3;font-size:14px;font-weight:500;line-height:20px; }
  .claims__field input,.claims__field select,.claims__field textarea { width:100%;padding:11.5px 16.5px;border:.5px solid #6b6b6b;border-radius:40px;color:#ece9e3;background:transparent;font-family:inherit;font-size:14px;font-weight:500;line-height:20px;appearance:none; }
  .claims__field input::placeholder,.claims__field textarea::placeholder { color:#6b6b6b; }
  .claims__field select:invalid { color:#6b6b6b; }
  /* El `expand_more` del diseño, redibujado con el trazo inline que ya usan
     los iconos de `SiteHeader`, dentro de la misma caja de 24 px. */
  .claims__field select { background:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236b6b6b' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M6.66 9.4 12 14.66 17.34 9.4'/></svg>") no-repeat right 12.5px center/24px 24px; padding-right:44px; }
  .claims__field--sm { width:min(100%,236px); }
  .claims__field--md { width:min(100%,492px); }
  .claims__field--area textarea { height:148px;padding:12.5px 16.5px;border-radius:20px;resize:vertical; }
  .claims__field--area-sm textarea { height:98px; }
  .claims__row { display:flex;flex-wrap:wrap;gap:20px; }

  .claims__choices { display:flex;margin:0;flex-direction:column;gap:20px;padding:0;border:0; }
  .claims__choice { display:flex;align-items:center;gap:8px;color:#8d8584;font-size:16px;font-weight:500;line-height:16px;cursor:pointer; }
  .claims__choice input { width:20px;height:20px;flex:none;margin:6px;accent-color:#f9cb69; }
  .claims__sr-only { position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap; }

  .claims__notice { margin:0;color:#f9cb69;font-size:14px;font-weight:500;line-height:20px; }
  .claims__notice a { color:inherit; }

  .claims__actions { display:flex;justify-content:flex-end; }
  .claims__actions button { width:120px;padding:10px 20px;border:0;border-radius:20px;color:#000;background:#fefaf0;font-family:inherit;font-size:15px;font-weight:700;line-height:1.29;cursor:pointer; }
  .claims__actions button:hover { background:#fff; }

  @media (max-width:767px) {
    .claims { padding-inline:24px; }
    .claims__inner { gap:32px; }
    .claims__field--sm,.claims__field--md { width:100%; }
    .claims__row { flex-direction:column; }
  }
</style>
