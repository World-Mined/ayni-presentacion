<script>
  const bands = [
    ...document.querySelectorAll<HTMLElement>("[data-band-reveal]"),
  ];
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (bands.length && "IntersectionObserver" in window && !reducedMotion) {
    for (const band of bands) band.dataset.revealed = "false";

    const reveal = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const band = entry.target as HTMLElement;
          const screenful = entry.rootBounds
            ? entry.intersectionRect.height / entry.rootBounds.height
            : 0;
          if (entry.intersectionRatio >= 0.6 || screenful >= 0.6)
            band.dataset.revealed = "true";
          else if (!entry.isIntersecting) band.dataset.revealed = "false";
        }
      },
      { threshold: [0, 0.25, 0.4, 0.6, 0.8, 1] },
    );

    for (const band of bands) reveal.observe(band);
  }

  const requirementCards = [
    ...document.querySelectorAll<HTMLElement>(".star-requirement"),
  ];
  if (requirementCards.length) {
    const positionFlares = () => {
      for (const card of requirementCards) {
        const icon = card.querySelector<HTMLElement>(".star-requirement__icon");
        const text = card.querySelector<HTMLElement>("p");
        const flare = card.querySelector<HTMLElement>(
          ".star-requirement__flare",
        );
        if (!icon || !text || !flare) continue;
        const cardRect = card.getBoundingClientRect();
        const iconRect = icon.getBoundingClientRect();
        const textRect = text.getBoundingClientRect();
        const midX = (iconRect.right + textRect.left) / 2;
        const fraction = (midX - cardRect.left) / cardRect.width;
        card.style.setProperty("--flare-x", `${(fraction * 100).toFixed(2)}%`);
      }
    };

    positionFlares();
    window.addEventListener("resize", positionFlares);
    document.fonts?.ready.then(positionFlares).catch(() => {});
  }
</script>
