---
import { Image } from 'astro:assets';
import bonusesBackground from '../../../assets/v2/ambassadors-bonuses-background.png';
import residualFlareTop from '../../../assets/v2/residual-flare-top.svg';
import residualFlareBottom from '../../../assets/v2/residual-flare-bottom.svg';
import bonusFocus from '../../../assets/v2/ambassadors-bonus-focus.webp';
import star1 from '../../../assets/v2/ambassadors-star-1.webp';
import star2 from '../../../assets/v2/ambassadors-star-2.webp';
import star3 from '../../../assets/v2/ambassadors-star-3.webp';
import star4 from '../../../assets/v2/ambassadors-star-4.webp';

const RESIDUAL_BONUS = [
  ['GEN 350', '1,200 pts', '400 pts', '300 pts', '$175', '$350'], ['GEN 1000', '4,800 pts', '1,700 pts', '1,000 pts', '$500', '$1,000'], ['GEN 3000', '22,000 pts', '6,500 pts', '3,700 pts', '$1,500', '$3,000'], ['GEN 5000', '43,500 pts', '13,900 pts', '6,200 pts', '$2,500', '$5,000'], ['GEN 10K', '70,000 pts', '26,000 pts', '10,000 pts', '$5,000', '$10,000'], ['GEN 30K', '200,000 pts', '90,000 pts', '35,000 pts', '$15,000', '$30,000'], ['GEN 60K', '600,000 pts', '190,000 pts', '80,000 pts', '$30,000', '$60,000'], ['GEN 100K', '950,000 pts', '320,000 pts', '125,000 pts', '$50,000', '$100,000'], ['GEN 300K', '3,500,000 pts', '1,200,000 pts', '500,000 pts', '$150,000', '$300,000'], ['GEN 1M', '14,500,000 pts', '5,000,000 pts', '2,000,000 pts', '$500,000', '$1,000,000'],
];
const STAR_PHOTOS = [star1, star2, star3, star4];
---

<div class="ambassadors-bands">
  <section class="ambassadors-bonuses" aria-labelledby="bonuses-title">
    <Image class="ambassadors-bonuses__background" src={bonusesBackground} alt="" aria-hidden="true" loading="lazy" widths={[768, 1440, 2880]} sizes="100vw" />
    <div class="ambassadors-bonuses__content">
      <header class="bonuses-intro"><h2 id="bonuses-title">Bonos AYNI</h2><p class="reconsumption-bonus"><span>Bono<br />Reconsumo</span><strong>15%</strong></p></header>
      <section class="residual-bonus" aria-labelledby="residual-bonus-title">
        <h3 id="residual-bonus-title">Bono de ingreso residual</h3>
        <div class="residual-bonus__table-shell">
          <div class="residual-bonus__table-wrap" tabindex="0" role="region" aria-label="Rangos y ganancias del bono residual">
            <table>
              <colgroup><col class="rank-column" /><col span="3" class="team-column" /><col span="2" class="earnings-column" /></colgroup>
              <thead>
                <tr>
                  <th rowspan="2" scope="col"><span class="th-title">Rangos</span></th>
                  <th rowspan="2" scope="col"><span class="th-title">Binario<br />2 EQUIPOS</span></th>
                  <th rowspan="2" scope="col"><span class="th-title">Trinario<br />3 EQUIPOS</span></th>
                  <th rowspan="2" scope="col"><span class="th-title">Tretanario<br />4 EQUIPOS</span></th>
                  <th colspan="2" scope="colgroup"><span class="th-title">Ganancias</span></th>
                </tr>
                <tr><th scope="col">Quincenales</th><th scope="col">Mensuales</th></tr>
              </thead>
              <tbody>{RESIDUAL_BONUS.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
            </table>
          </div>
          <img class="residual-bonus__flare residual-bonus__flare--top" src={residualFlareTop.src} alt="" aria-hidden="true" />
          <img class="residual-bonus__flare residual-bonus__flare--bottom" src={residualFlareBottom.src} alt="" aria-hidden="true" />
        </div>
        <p class="residual-bonus__note">*Los puntajes mostrados han sido calculados en base a un equipo TRINARIO y TETRANARIO.</p>
      </section>
      <section class="sponsorship-bonus" aria-labelledby="sponsorship-bonus-title">
        <h3 id="sponsorship-bonus-title">Bono patrocinio</h3><p>Convierte tus patrocinados en <strong>recompensas</strong></p>
        <div class="sponsorship-plan" aria-label="Tres equipos patrocinados de 400 puntos generan 60 dólares por equipo y 180 puntos de bono de patrocinio al llegar a GEN 350."><h4>Embajador AYNI</h4><div class="sponsorship-plan__teams">{[1, 2, 3].map((team) => <div class="sponsorship-plan__team"><span class:list={['sponsorship-plan__arrow', `sponsorship-plan__arrow--${team}`]} aria-hidden="true">↘</span><strong>400 pts.</strong><span class="sponsorship-plan__down" aria-hidden="true">↓</span><b>$ 60,00</b></div>)}</div><div class="sponsorship-plan__result"><strong>GEN 350</strong><span aria-hidden="true">↓</span><b>$180 pts.<small>de bono de patrocinio</small></b></div></div>
      </section>
    </div>
  </section>

  <section class="ambassadors-band ambassadors-band--focus" aria-labelledby="bonus-focus-title" data-band-reveal>
    <div class="ambassadors-band__backdrop" aria-hidden="true"><Image src={bonusFocus} alt="" loading="eager" widths={[768, 1440, 2880]} sizes="100vw" /><span></span></div>
    <div class="ambassadors-band__text"><h2 id="bonus-focus-title">Bono Enfoque</h2><p>Al cerrar el año, AYNI te recompensa con un 10% adicional acumulado de tus comisiones. Solo debes mantener tu membresía IBO y estado “Activo” ininterrumpidamente, con un rango menor a GEN 3000 en cada ciclo.</p></div>
  </section>

  <section class="ambassadors-star" aria-labelledby="ayni-star-title"><div class="ambassadors-star__backdrop" aria-hidden="true">{STAR_PHOTOS.map((photo, index) => <Image src={photo} alt="" loading="lazy" widths={[768, 1440, 2880]} sizes="100vw" data-star-slide data-active={index === 0 ? 'true' : 'false'} />)}<span></span></div><div class="ambassadors-star__text"><h2 id="ayni-star-title">AYNI Estrella</h2><p>Tu constancia tiene recompensa. Disfruta de una experiencia de viaje única en nuestra región al consolidar tu liderazgo por 24 ciclos de negocio ininterrumpidos.</p></div></section>
</div>

<style>
  .ambassadors-bonuses { --w:min(100vw,1440px);position:relative;isolation:isolate;min-height:calc(var(--w) * 1.52);overflow:hidden;background:#050504; }.ambassadors-bonuses__background { position:absolute;z-index:-1;inset:0;display:block;width:100%;height:100%;object-fit:cover;object-position:center top; }.ambassadors-bonuses__content { display:flex;min-height:calc(var(--w) * 1.52);width:min(100%,1440px);margin:auto;padding:calc(var(--w) * .05556) calc(var(--w) * .05556) calc(var(--w) * .1);flex-direction:column;align-items:center; }h2,h3,h4,p { margin:0; }.bonuses-intro { display:flex;flex-direction:column;align-items:center;gap:calc(var(--w) * .04167); }.bonuses-intro h2,.residual-bonus h3,.sponsorship-bonus h3 { color:#f3c864;font-family:var(--font-title);font-weight:600;text-align:center;letter-spacing:-.035em; }.bonuses-intro h2 { font-size:calc(var(--w) * .04444);line-height:1.2; }.reconsumption-bonus { position:relative;display:flex;min-width:calc(var(--w) * .18056);padding:calc(var(--w) * .01111);flex-direction:column;align-items:center;border:1px solid #f3c864;border-radius:8px;background:linear-gradient(135deg,rgba(219,168,59,.72),rgba(0,0,0,.48) 23%,rgba(0,0,0,.48) 80%,rgba(219,168,59,.72));color:#f9cb69;font-family:var(--font-title);font-size:calc(var(--w) * .02222);font-weight:700;line-height:1.18;text-align:center; }.reconsumption-bonus::before,.reconsumption-bonus::after { position:absolute;left:50%;width:calc(var(--w) * .068);height:3px;content:'';transform:translateX(-50%);background:radial-gradient(ellipse,rgba(249,203,105,.95),rgba(249,203,105,0) 70%); }.reconsumption-bonus::before { top:-2px; }.reconsumption-bonus::after { bottom:-2px; }.reconsumption-bonus strong { color:#fff9ec;font-size:calc(var(--w) * .01944); }/* Figma 3253:28162: 1280px wide, 94px header and ten 56px rows. */
  .residual-bonus {
    --gold-text:linear-gradient(90deg,#6e582b 10.512%,#f9cb69 50.363%,#f0c365 58.373%,#d8b05a 69.587%,#b29049 85.607%,#7d6431 103.23%,#6e582b 108.03%);
    -webkit-font-smoothing:antialiased;display:flex;width:100%;margin-top:calc(var(--w) * .075);flex-direction:column;align-items:center;
  }
  .residual-bonus h3 { width:min(100%,806px);margin-bottom:48px;font-size:40px;line-height:60px;letter-spacing:0;background:var(--gold-text);background-clip:text;color:transparent;text-align:center; }
  .sponsorship-bonus h3 { font-size:calc(var(--w) * .02778);line-height:1.2; }
  .residual-bonus__table-shell { position:relative;width:100%; }
  .residual-bonus__table-wrap { width:100%;overflow-x:auto;border-radius:8px; }
  .residual-bonus__table-wrap:focus-visible { outline:2px solid #f3c864;outline-offset:4px; }
  table { width:100%;min-width:1000px;border-spacing:0;table-layout:fixed;color:#fff9ec;background:rgba(20,20,20,.75);font-family:var(--font-title);text-align:center; }
  .rank-column { width:10.9375%; }.team-column { width:17.708333%; }.earnings-column { width:17.96875%; }
  th,td { border:0;border-left:1px solid #f3c864;border-bottom:1px solid #f3c864; }
  tr > :last-child { border-right:1px solid #f3c864; }
  .th-title { display:block;background:var(--gold-text);background-clip:text;-webkit-background-clip:text;color:transparent; }
  thead { background:linear-gradient(rgba(48,35,10,.1),rgba(48,35,10,.1)); }
  thead tr:first-child th { height:54px;border-top:1px solid #f3c864;padding:0 16px;background:linear-gradient(130deg,rgba(219,168,59,.8) -21.916%,rgba(0,0,0,.4) 21.243%,rgba(0,0,0,.48) 50.231%,rgba(0,0,0,.4) 80%,rgba(219,168,59,.8) 180%);font-size:24px;font-weight:700;line-height:28px; }
  thead tr:first-child th[rowspan] { height:94px; }
  thead tr:first-child th:first-child { border-top-left-radius:8px; }
  thead tr:first-child th:last-child { padding-top:12px;border-top-right-radius:8px;background:linear-gradient(130deg,rgba(219,168,59,.8) -21.916%,rgba(0,0,0,.4) 21.243%,rgba(0,0,0,.48) 50.231%,rgba(0,0,0,.4) 80%,rgba(219,168,59,.8) 180%); }
  thead tr:last-child th { height:40px;padding:0 8px;background:rgba(0,0,0,.4);font-size:20px;font-weight:500;line-height:24px; }
  tbody td { height:56px;padding:0 16px;background:rgba(48,35,10,.2);font-size:16px;font-weight:500;line-height:24px;white-space:nowrap; }
  tbody tr:last-child td:first-child { border-bottom-left-radius:8px; }
  tbody tr:last-child td:last-child { border-bottom-right-radius:8px; }
  .residual-bonus__flare { position:absolute;z-index:1;display:block;pointer-events:none; }
  .residual-bonus__flare--top { top:-9px;left:0;width:10.9375%;height:18px; }
  .residual-bonus__flare--bottom { bottom:-10px;right:0;width:20.234375%;height:20px; }
  .residual-bonus__note { width:100%;margin-top:24px;color:#c4bba8;font-family:var(--font-title);font-size:18px;font-weight:400;line-height:26px;text-align:center; }
  @media (max-width:1100px) {
    .residual-bonus h3 { margin-bottom:32px;font-size:clamp(24px,3.5vw,40px);line-height:1.5; }
    .residual-bonus__note { font-size:14px;line-height:22px; }
    .residual-bonus__flare--bottom { display:none; }
  }
  .sponsorship-bonus { display:flex;width:100%;margin-top:calc(var(--w) * .10417);flex-direction:column;align-items:center;gap:calc(var(--w) * .01111); }.sponsorship-bonus > p { color:#c4bba8;font-family:var(--font-body);font-size:calc(var(--w) * .01667); }.sponsorship-bonus > p strong { color:#fff9ec; }.sponsorship-plan { display:grid;width:calc(var(--w) * .8125);margin-top:calc(var(--w) * .02222);padding:calc(var(--w) * .02222);grid-template-columns:1fr auto;grid-template-rows:auto 1fr;border:1px solid rgba(255,255,255,.18);border-radius:12px;background:rgba(5,5,4,.22); }.sponsorship-plan h4 { grid-column:1;grid-row:1;color:#fff9ec;font-family:var(--font-title);font-size:calc(var(--w) * .02778);font-weight:700;line-height:1.2;text-align:center; }.sponsorship-plan__teams { display:grid;grid-column:1;grid-row:2;padding-top:calc(var(--w) * .02222);grid-template-columns:repeat(3,1fr);gap:calc(var(--w) * .01389); }.sponsorship-plan__team { display:flex;flex-direction:column;align-items:center; }.sponsorship-plan__arrow { height:calc(var(--w) * .06);color:#f3c864;font-family:Arial,sans-serif;font-size:calc(var(--w) * .06);line-height:.58; }.sponsorship-plan__arrow--2 { transform:rotate(45deg); }.sponsorship-plan__arrow--3 { transform:scaleX(-1); }.sponsorship-plan__team strong,.sponsorship-plan__team b { display:flex;width:100%;height:calc(var(--w) * .04444);align-items:center;justify-content:center;border:1px solid #f3c864;border-radius:8px;background:linear-gradient(135deg,rgba(219,168,59,.55),rgba(0,0,0,.52) 28%,rgba(0,0,0,.52) 76%,rgba(219,168,59,.55));font-family:var(--font-title);font-size:calc(var(--w) * .02222);font-weight:700;line-height:1;color:#f3c864; }.sponsorship-plan__team b { color:#fff9ec; }.sponsorship-plan__down { height:calc(var(--w) * .052);padding-top:calc(var(--w) * .012);color:#f3c864;font-size:calc(var(--w) * .03);line-height:1; }.sponsorship-plan__result { display:flex;grid-column:2;grid-row:1 / span 2;min-width:calc(var(--w) * .125);padding-left:calc(var(--w) * .02222);flex-direction:column;align-items:center;justify-content:space-around;border-left:2px solid #f3c864;color:#f3c864;font-family:var(--font-title);text-align:center; }.sponsorship-plan__result strong,.sponsorship-plan__result b { font-size:calc(var(--w) * .02222);font-weight:700; }.sponsorship-plan__result > span { font-size:calc(var(--w) * .028); }.sponsorship-plan__result small { display:block;font-size:calc(var(--w) * .00833);font-weight:600;white-space:nowrap; }
  .ambassadors-band,.ambassadors-star { --w:min(100vw,1920px,200svh);position:relative;height:calc(var(--w)/2);overflow:hidden;background:#000;isolation:isolate; }.ambassadors-star { --w:min(100vw,1920px,180svh);height:calc(var(--w)/1.8); }.ambassadors-band__backdrop,.ambassadors-star__backdrop { position:absolute;inset:0; }.ambassadors-band__backdrop :global(img),.ambassadors-star__backdrop :global(img) { display:block;width:100%;height:100%;object-fit:cover; }.ambassadors-band__backdrop span { position:absolute;inset:0;background:radial-gradient(100% 400% at 100% 50%,rgba(110,88,43,.2),rgba(0,0,0,0) 70%); }.ambassadors-band__text,.ambassadors-star__text { position:absolute;z-index:1;left:50%;display:flex;width:calc(var(--w) * .8097);flex-direction:column;transform:translate(-50%,-50%); }.ambassadors-band__text { top:50%;align-items:flex-start;gap:calc(var(--w) * .005556); }.ambassadors-band h2 { color:#f9cb69;font-family:Poppins,sans-serif;font-size:calc(var(--w) * .027778);font-weight:600;line-height:1.2; }.ambassadors-band p { width:calc(var(--w) * .3646);color:#fefaf0;font-family:Montserrat,sans-serif;font-size:calc(var(--w) * .013889);line-height:1.2; }
  .ambassadors-band--focus { --whip:1.35s;--whip-ease:cubic-bezier(.16,1,.3,1);--whip-lag:.1s; }.ambassadors-band--focus[data-revealed='true'] .ambassadors-band__text { transition:transform var(--whip) var(--whip-ease); }.ambassadors-band--focus[data-revealed='true'] .ambassadors-band__text p { transition:transform calc(var(--whip) + .1s) var(--whip-ease) var(--whip-lag); }.ambassadors-band--focus[data-revealed='true'] h2 { transition:color .9s ease .5s; }.ambassadors-band--focus[data-revealed='false'] h2 { color:#fff; }.ambassadors-band--focus[data-revealed='false'] .ambassadors-band__text { transform:translate(calc(-50% + var(--w) * -.67153),calc(-50% + var(--w) * -.10833)); }.ambassadors-band--focus[data-revealed='false'] .ambassadors-band__text p { transform:translateX(calc(var(--w) * -.06)); }
  .ambassadors-star__backdrop :global(img) { position:absolute;opacity:0;transition:opacity 1.1s linear; }.ambassadors-star__backdrop :global(img[data-active='true']) { opacity:1; }.ambassadors-star__backdrop span { position:absolute;z-index:1;right:0;bottom:0;left:0;height:68%;background:linear-gradient(180deg,transparent,rgba(0,0,0,.95)); }.ambassadors-star__text { top:73.25%;align-items:flex-end;gap:calc(var(--w) * .01111);text-align:right; }.ambassadors-star h2 { color:#f9cb69;font-family:Montserrat,sans-serif;font-size:calc(var(--w) * .027778);font-weight:700;line-height:1.2;letter-spacing:-.05em; }.ambassadors-star p { width:calc(var(--w) * .3646);color:#fff;font-family:Montserrat,sans-serif;font-size:calc(var(--w) * .0125);line-height:1.444; }
  @media (max-width:767px) { .sponsorship-plan { width:100%;padding:calc(var(--w) * .017);border-radius:8px; }.sponsorship-plan__result { min-width:calc(var(--w) * .12);padding-left:calc(var(--w) * .012); }.sponsorship-plan__team strong,.sponsorship-plan__team b { border-radius:4px; }.residual-bonus__note { max-width:85%; } }
</style>

<script>
  const bands = [...document.querySelectorAll<HTMLElement>('[data-band-reveal]')];
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (bands.length && 'IntersectionObserver' in window && !reducedMotion) {
    for (const band of bands) band.dataset.revealed = 'false';

    const reveal = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const band = entry.target as HTMLElement;
          const screenful = entry.rootBounds ? entry.intersectionRect.height / entry.rootBounds.height : 0;
          if (entry.intersectionRatio >= 0.6 || screenful >= 0.6) band.dataset.revealed = 'true';
          else if (!entry.isIntersecting) band.dataset.revealed = 'false';
        }
      },
      { threshold: [0, 0.25, 0.4, 0.6, 0.8, 1] },
    );

    for (const band of bands) reveal.observe(band);
  }

  const slides = [...document.querySelectorAll<HTMLElement>('[data-star-slide]')];
  if (slides.length > 1 && !reducedMotion) {
    let active = 0;
    setInterval(() => { slides[active].dataset.active = 'false'; active = (active + 1) % slides.length; slides[active].dataset.active = 'true'; }, 4500);
  }
</script>
