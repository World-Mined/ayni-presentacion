---
import { Image, getImage } from 'astro:assets';
import type { ProductDetail } from '../../../data/products';
import capucciBackground from '../../../assets/v2/product-entrepreneur-capucci-background.png';
import capucciPeople from '../../../assets/v2/product-entrepreneur-capucci-people.png';
import moraviBackground from '../../../assets/v2/product-entrepreneur-moravi-background.png';
import moraviPeople from '../../../assets/v2/product-entrepreneur-moravi-people.png';
import moraviGradient from '../../../assets/v2/product-entrepreneur-moravi-gradient.png';
import resetBackground from '../../../assets/v2/product-entrepreneur-background.png';
import resetPeople from '../../../assets/v2/product-entrepreneur-people.png';
import sharedGradient from '../../../assets/v2/product-entrepreneur-gradient.png';
import mobileBlur from '../../../assets/v2/product-entrepreneur-mobile-blur.svg';
import arrowForward from '../../../assets/v2/product-entrepreneur-arrow-forward.svg';
import MotionCta from '../MotionCta/MotionCta.astro';
import { ROUTES } from '../../../data/v2';

interface Props {
  product: ProductDetail;
}

const { product } = Astro.props;
const entrepreneurArt = {
  capucci: { background: capucciBackground, people: capucciPeople, gradient: sharedGradient },
  moravi: { background: moraviBackground, people: moraviPeople, gradient: moraviGradient },
  reset: { background: resetBackground, people: resetPeople, gradient: sharedGradient },
}[product.revealId];
const highlightedDescription = product.entrepreneur.descriptionHighlight;
const [descriptionStart, descriptionEnd] = highlightedDescription
  ? product.entrepreneur.description.split(highlightedDescription)
  : [product.entrepreneur.description, ''];
const optimizedBackgroundMobile = await getImage({ src: entrepreneurArt.background, widths: [1170, 1440], format: 'webp', quality: 90 });
const optimizedPeopleMobile = await getImage({ src: entrepreneurArt.people, widths: [1170, 1440], format: 'webp', quality: 90 });
---

<section class:list={['product-entrepreneur', `product-entrepreneur--${product.revealId}`]} aria-labelledby={`entrepreneur-${product.slug}`}>
  <picture class="product-entrepreneur__background" aria-hidden="true">
    <source media="(max-width: 767px)" srcset={optimizedBackgroundMobile.srcSet.attribute} sizes="316.92vw" />
    <Image src={entrepreneurArt.background} alt="" loading="lazy" widths={[768, 1440]} sizes="100vw" />
  </picture>
  <picture class="product-entrepreneur__people" aria-hidden="true">
    <source media="(max-width: 767px)" srcset={optimizedPeopleMobile.srcSet.attribute} sizes="1440px" />
    <Image src={entrepreneurArt.people} alt="" loading="lazy" widths={[768, 1440]} sizes="100vw" />
  </picture>
  <div class="product-entrepreneur__gradient" aria-hidden="true">
    <Image src={entrepreneurArt.gradient} alt="" loading="lazy" widths={[768, 1440]} sizes="100vw" />
  </div>
  <div class="product-entrepreneur__mobile-shade" aria-hidden="true"></div>
  <Image class="product-entrepreneur__mobile-blur" src={mobileBlur} alt="" aria-hidden="true" />
  <div class="product-entrepreneur__inner">
    <div class="product-entrepreneur__content">
      <div class="product-entrepreneur__text">
        <h2 id={`entrepreneur-${product.slug}`}>{product.entrepreneur.heading}</h2>
        <p class="product-entrepreneur__description-desktop">
          {descriptionStart}
          {highlightedDescription && <strong>{highlightedDescription}</strong>}
          {descriptionEnd}
        </p>
        <p class="product-entrepreneur__description-mobile">
          Comparte lo que ya conoces y <strong>construye una fuente de ingresos</strong> a tu propio ritmo.
        </p>
      </div>
      <MotionCta class="product-entrepreneur__cta" href={ROUTES.ambassadors}>
        <span>Quiero emprender</span>
        <span class="product-entrepreneur__arrow-desktop" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
        <span class="product-entrepreneur__arrow-mobile" aria-hidden="true"><Image src={arrowForward} alt="" /></span>
      </MotionCta>
    </div>
  </div>
</section>

<style>
  .product-entrepreneur { position:relative;display:grid;min-height:480px;overflow:hidden;background:#090806;isolation:isolate; }
  .product-entrepreneur__background,.product-entrepreneur__people,.product-entrepreneur__gradient { position:absolute;inset:0;display:block;pointer-events:none; }
  .product-entrepreneur__background { z-index:0; }
  .product-entrepreneur__people { z-index:1; }
  .product-entrepreneur__gradient { z-index:2; }
  .product-entrepreneur__background :global(img),.product-entrepreneur__gradient :global(img) { display:block;width:100%;height:100%;object-fit:cover; }
  .product-entrepreneur__people { overflow:hidden; }
  .product-entrepreneur__people :global(img) { position:absolute;top:50%;left:50%;display:block;width:1440px;height:480px;max-width:none;object-fit:contain;transform:translate(-50%,-50%); }
  /* Cada PNG conserva su escala nativa de 1440x480. Hasta 1024px centramos
     el grupo visible; después lo llevamos progresivamente a la composición
     desktop para evitar el salto que antes ocurría entre 1023 y 1024px. */
  .product-entrepreneur--reset { --people-visual-center:336px;--people-fluid-left:calc(609.231px - 42.308vw); }
  .product-entrepreneur--capucci { --people-visual-center:341px;--people-fluid-left:calc(591.923px - 41.106vw); }
  .product-entrepreneur--moravi { --people-visual-center:349px;--people-fluid-left:calc(564.231px - 39.183vw); }
  .product-entrepreneur__gradient :global(img) { object-position:right center; }
  .product-entrepreneur__mobile-shade,.product-entrepreneur__mobile-blur { display:none; }
  .product-entrepreneur__inner { position:relative;z-index:3;display:flex;width:min(100%,1280px);padding:80px;align-items:center;justify-content:flex-end;margin:auto; }
  .product-entrepreneur__content { display:flex;width:min(100%,547px);flex-direction:column;align-items:flex-start;gap:24px; }
  .product-entrepreneur__text { display:flex;flex-direction:column;gap:24px; }
  .product-entrepreneur .product-entrepreneur__content h2 { margin:0;color:#f9cb69;font-family:var(--font-title);font-size:clamp(30px,2.778vw,40px);font-weight:600;letter-spacing:-.035em;line-height:1.2; }
  .product-entrepreneur__content p { margin:0;color:#c4bba8;font-family:var(--font-title);font-size:18px;font-weight:300;line-height:26px; }
  .product-entrepreneur__content p strong { color:#fff;font-weight:700; }
  .product-entrepreneur__content p::first-line { color:#c4bba8; }
  .product-entrepreneur__description-mobile { display:none; }
  .product-entrepreneur :global(.product-entrepreneur__cta) { --cta-color:#987c40;--cta-ring:#b1a58d;--cta-ring-w:.75px;--cta-surface:linear-gradient(90deg,#000,#000),linear-gradient(185deg,rgba(135,116,79,.2),rgba(43,43,43,.14)); }
  .product-entrepreneur :global(.product-entrepreneur__arrow-desktop) { display:block;width:24px;height:24px;flex:none; }
  .product-entrepreneur :global(.product-entrepreneur__arrow-desktop svg) { fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round; }
  .product-entrepreneur :global(.product-entrepreneur__arrow-mobile) { display:none; }
  @media (min-width:768px) and (max-width:1024px) {
    .product-entrepreneur__people :global(img) { left:calc(50% - var(--people-visual-center));transform:translateY(-50%); }
  }
  @media (min-width:1025px) and (max-width:1439px) {
    .product-entrepreneur__people :global(img) { left:var(--people-fluid-left);transform:translateY(-50%); }
  }
  @media (max-width:767px) {
    .product-entrepreneur { height:412px;min-height:412px; }
    .product-entrepreneur__background { display:block; }
    .product-entrepreneur__background :global(img) { width:100%;height:100%;object-fit:cover;object-position:center; }
    .product-entrepreneur__people :global(img) { left:calc(50% - var(--people-visual-center));transform:translateY(-50%); }
    .product-entrepreneur__gradient { display:none; }
    .product-entrepreneur__mobile-shade { position:absolute;z-index:2;inset:0;display:block;background:rgba(0,0,0,.7);pointer-events:none; }
    .product-entrepreneur :global(.product-entrepreneur__mobile-blur) { position:absolute;z-index:3;top:50%;left:50%;display:block;width:500px;height:500px;max-width:none;transform:translate(-50%,-50%);pointer-events:none; }
    .product-entrepreneur__inner { z-index:4;width:100%;height:100%;padding:56px 24px;align-items:center;justify-content:center; }
    .product-entrepreneur__content { width:100%;align-items:center;gap:24px;text-align:center; }
    .product-entrepreneur__text { width:100%;align-items:center;gap:16px; }
    .product-entrepreneur .product-entrepreneur__content h2 { width:100%;font-size:28px;letter-spacing:0;line-height:36px; }
    .product-entrepreneur__content p { width:100%;font-size:16px;line-height:22px; }
    .product-entrepreneur__description-desktop { display:none; }
    .product-entrepreneur__description-mobile { display:block; }
    .product-entrepreneur :global(.product-entrepreneur__cta) { --cta-w:220px;--cta-h:48px;--cta-gap:16px;--cta-font-size:16px; }
    .product-entrepreneur :global(.product-entrepreneur__arrow-desktop) { display:none; }
    .product-entrepreneur :global(.product-entrepreneur__arrow-mobile) { display:block;width:24px;height:24px;flex:none; }
    .product-entrepreneur :global(.product-entrepreneur__arrow-mobile img) { display:block;width:24px;height:24px; }
  }
</style>
