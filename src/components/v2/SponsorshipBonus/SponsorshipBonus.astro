---
// Bono patrocinio. El mismo DOM sirve a las dos composiciones de Figma: en
// escritorio es una rejilla de dos columnas (los tres equipos a la izquierda,
// el resultado a la derecha tras un borde vertical) y por debajo de 1024px se
// recompone en una sola columna con tres pares horizontales y la card de
// resultado debajo. Por eso cada equipo lleva dos flechas: la diagonal del
// reparto de escritorio y la de conversión, que en móvil gira a horizontal.
---

<section class="sponsorship-bonus" aria-labelledby="sponsorship-bonus-title">
  <h3 id="sponsorship-bonus-title">Bono patrocinio</h3><p>
    Convierte tus patrocinados en <strong>recompensas</strong>
  </p>
  <div
    class="sponsorship-plan"
    aria-label="Tres equipos patrocinados de 400 puntos generan 60 dólares por equipo y 180 puntos de bono de patrocinio al llegar a GEN 350."
  >
    <h4>Embajador AYNI</h4><div class="sponsorship-plan__teams">
      {
        [1, 2, 3].map((team) => (
          <div class="sponsorship-plan__team">
            <>
              <span
                class:list={[
                  "sponsorship-plan__arrow",
                  `sponsorship-plan__arrow--${team}`,
                ]}
                aria-hidden="true"
              >
                ↘
              </span>
              <strong class="sponsorship-plan__team-points">400 pts.</strong>
              <span class="sponsorship-plan__down" aria-hidden="true">
                ↓
              </span>
              <b class="sponsorship-plan__team-reward">$ 60,00</b>
            </>
          </div>
        ))
      }
    </div><div class="sponsorship-plan__result">
      <strong>GEN 350</strong><span aria-hidden="true">↓</span><b
        >$180 pts.<small>de bono de patrocinio</small></b
      >
    </div>
  </div>
</section>

<style>
  h3,
  h4,
  p {
    margin: 0;
  }
  .sponsorship-bonus {
    display: flex;
    width: 100%;
    margin-top: calc(var(--w) * 0.10417);
    flex-direction: column;
    align-items: center;
    gap: calc(var(--w) * 0.01111);
  }
  .sponsorship-bonus h3 {
    color: #f3c864;
    font-family: var(--font-title);
    font-size: calc(var(--w) * 0.02778);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    letter-spacing: -0.035em;
  }
  .sponsorship-bonus > p {
    color: #c4bba8;
    font-family: var(--font-body);
    font-size: calc(var(--w) * 0.01667);
  }
  .sponsorship-bonus > p strong {
    color: #fff9ec;
  }
  .sponsorship-plan {
    display: grid;
    width: calc(var(--w) * 0.8125);
    margin-top: calc(var(--w) * 0.02222);
    padding: calc(var(--w) * 0.02222);
    grid-template-columns: 1fr auto;
    grid-template-rows: auto 1fr;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 12px;
    background: rgba(5, 5, 4, 0.22);
  }
  .sponsorship-plan h4 {
    grid-column: 1;
    grid-row: 1;
    color: #fff9ec;
    font-family: var(--font-title);
    font-size: calc(var(--w) * 0.02778);
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
  }
  .sponsorship-plan__teams {
    display: grid;
    grid-column: 1;
    grid-row: 2;
    padding-top: calc(var(--w) * 0.02222);
    grid-template-columns: repeat(3, 1fr);
    gap: calc(var(--w) * 0.01389);
  }
  .sponsorship-plan__team {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .sponsorship-plan__arrow {
    height: calc(var(--w) * 0.06);
    color: #f3c864;
    font-family: Arial, sans-serif;
    font-size: calc(var(--w) * 0.06);
    line-height: 0.58;
  }
  .sponsorship-plan__arrow--2 {
    transform: rotate(45deg);
  }
  .sponsorship-plan__arrow--3 {
    transform: scaleX(-1);
  }
  .sponsorship-plan__team-points,
  .sponsorship-plan__team-reward {
    position: relative;
    display: flex;
    width: 100%;
    height: calc(var(--w) * 0.04444);
    align-items: center;
    justify-content: center;
    border: 1px solid #f3c864;
    border-radius: var(--sponsorship-team-radius, 8px);
    background: linear-gradient(
      135deg,
      rgba(219, 168, 59, 0.55),
      rgba(0, 0, 0, 0.52) 28%,
      rgba(0, 0, 0, 0.52) 76%,
      rgba(219, 168, 59, 0.55)
    );
    font-family: var(--font-title);
    font-size: calc(var(--w) * 0.02222);
    font-weight: 700;
    line-height: 1;
  }
  .sponsorship-plan__team-points {
    color: #f3c864;
  }
  .sponsorship-plan__team-reward {
    color: #fff9ec;
  }
  .sponsorship-plan__down {
    height: calc(var(--w) * 0.052);
    padding-top: calc(var(--w) * 0.012);
    color: #f3c864;
    font-size: calc(var(--w) * 0.03);
    line-height: 1;
  }
  .sponsorship-plan__result {
    display: flex;
    grid-column: 2;
    grid-row: 1 / span 2;
    min-width: calc(var(--w) * 0.125);
    padding-left: calc(var(--w) * 0.02222);
    flex-direction: column;
    align-items: center;
    justify-content: space-around;
    border-left: 2px solid #f3c864;
    color: #f3c864;
    font-family: var(--font-title);
    text-align: center;
  }
  .sponsorship-plan__result strong,
  .sponsorship-plan__result b {
    font-size: calc(var(--w) * 0.02222);
    font-weight: 700;
  }
  .sponsorship-plan__result > span {
    font-size: calc(var(--w) * 0.028);
  }
  .sponsorship-plan__result small {
    display: block;
    font-size: calc(var(--w) * 0.00833);
    font-weight: 600;
    white-space: nowrap;
  }

  /* Móvil (Figma 3417:20372): una columna, tres pares `400 pts. → $ 60,00` y el
     resultado como card completa debajo en vez de una segunda columna. */
  @media (max-width: 1023px) {
    .sponsorship-bonus {
      margin-top: 0;
      gap: 12px;
    }
    .sponsorship-bonus h3 {
      background: var(--gold-text);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      font-size: 36px;
      line-height: 44px;
    }
    .sponsorship-bonus > p {
      font-size: 18px;
      line-height: 26px;
      text-align: center;
    }
    .sponsorship-plan {
      width: 100%;
      margin-top: 20px;
      padding: 20px;
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
      gap: 24px;
      border: 1px solid #333;
      border-radius: 16px;
      background: rgba(33, 33, 33, 0.5);
    }
    .sponsorship-plan h4 {
      font-size: 32px;
      font-weight: 600;
      line-height: 38px;
    }
    .sponsorship-plan__teams {
      padding-top: 0;
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .sponsorship-plan__team {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 8px;
    }
    /* La diagonal solo tiene sentido en el reparto de tres columnas. */
    .sponsorship-plan__arrow {
      display: none;
    }
    .sponsorship-plan__down {
      height: auto;
      padding-top: 0;
      font-size: 24px;
      line-height: 1;
      /* Misma flecha, girada: evita meter un SVG nuevo solo para el móvil. */
      transform: rotate(-90deg);
    }
    .sponsorship-plan__team-points,
    .sponsorship-plan__team-reward {
      --sponsorship-team-radius: 8px;
      height: 100px;
      padding: 12px;
      /* Mismas paradas fuera de caja que el badge de reconsumo, con el ángulo
         del frame móvil. */
      background:
        linear-gradient(rgba(48, 35, 10, 0.1), rgba(48, 35, 10, 0.1)),
        linear-gradient(
          115.95deg,
          rgba(219, 168, 59, 0.8) -21.914%,
          rgba(0, 0, 0, 0.402) 21.21%,
          rgba(0, 0, 0, 0.48) 50.186%,
          rgba(0, 0, 0, 0.402) 79.919%,
          rgba(219, 168, 59, 0.8) 129.56%
        );
      font-size: 24px;
      line-height: 28px;
      text-align: center;
    }
    /* La caja ya usa su fondo degradado, así que el texto no puede además
       recortar el degradado dorado: se pinta en el dorado central de la rampa. */
    .sponsorship-plan__team-points {
      color: #f9cb69;
    }
    /* Los destellos de borde, con la misma técnica que el badge de reconsumo. */
    .sponsorship-plan__team-points::before,
    .sponsorship-plan__team-points::after,
    .sponsorship-plan__team-reward::before,
    .sponsorship-plan__team-reward::after {
      position: absolute;
      left: 50%;
      width: 98px;
      height: 3px;
      content: "";
      transform: translateX(-50%);
      background: radial-gradient(
        ellipse,
        rgba(249, 203, 105, 0.95),
        rgba(249, 203, 105, 0) 70%
      );
    }
    .sponsorship-plan__team-points::before,
    .sponsorship-plan__team-reward::before {
      top: -2px;
    }
    .sponsorship-plan__team-points::after,
    .sponsorship-plan__team-reward::after {
      bottom: -2px;
    }
    .sponsorship-plan__result {
      display: flex;
      grid-column: 1;
      grid-row: 3;
      min-width: 0;
      padding: 16px;
      gap: 12px;
      justify-content: flex-start;
      border: 1px solid #f3c864;
      border-radius: 12px;
      background: rgba(28, 27, 31, 0.6);
    }
    .sponsorship-plan__result strong,
    .sponsorship-plan__result b,
    .sponsorship-plan__result small {
      background: var(--gold-text);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
    }
    .sponsorship-plan__result strong {
      font-size: 32px;
      line-height: 38px;
    }
    .sponsorship-plan__result b {
      font-size: 28px;
      line-height: 33px;
    }
    .sponsorship-plan__result small {
      font-size: 12px;
      line-height: 16px;
    }
    /* La flecha vertical del resultado sobra: la card ya va debajo. */
    .sponsorship-plan__result > span {
      display: none;
    }
  }
</style>
