---
import { Image } from 'astro:assets';
import ayniLogo from '../../assets/v2/ayni-logo.webp';
import footerBackgroundDesktop from '../../assets/v2/footer-background-desktop.webp';
import footerBackgroundMobile from '../../assets/v2/footer-background-mobile.webp';
import footerIso9001 from '../../assets/v2/footer-iso9001.png';
import footerLibro from '../../assets/v2/footer-libro.png';
import socialFacebook from '../../assets/v2/social-facebook.svg';
import socialInstagram from '../../assets/v2/social-instagram.svg';
import socialLinkedin from '../../assets/v2/social-linkedin.svg';
import socialYoutube from '../../assets/v2/social-youtube.svg';
import { LEGAL_DOCUMENTS, legalHref } from '../../data/legal';
import { ROUTES, SECTION_IDS } from '../../data/v2';
---

<footer
  class="home-footer"
  style={`--footer-pattern-desktop:url(${footerBackgroundDesktop.src});--footer-pattern-mobile:url(${footerBackgroundMobile.src})`}
>
  <span id={SECTION_IDS.tools} class="home-footer__anchor" aria-hidden="true"></span>
  <div class="home-footer__main">
    <div class="home-footer__brand">
      <Image src={ayniLogo} alt="AYNI" widths={[176, 352]} sizes="176px" quality={90} />
    </div>
    <div class="home-footer__links">
      <section class="home-footer__item">
        <h2>Servicios</h2>
        <div class="home-footer__list">
          <a href={ROUTES.products}>Productos</a>
          <a href={ROUTES.pickup}>Puntos de recojo</a>
        </div>
      </section>
      <section class="home-footer__item home-footer__legal">
        <h2>Legal</h2>
        <div class="home-footer__list">
          {LEGAL_DOCUMENTS.map((document) => (
            <a href={legalHref(document.slug)}>{document.navLabel}</a>
          ))}
        </div>
      </section>
    </div>
    <section class="home-footer__item home-footer__claims">
      <h2>Libro de reclamaciones</h2>
      <!-- El icono va como máscara y no como `<img>` para poder teñirlo: el PNG
           es blanco puro sobre transparente, así que la máscara lo reproduce
           igual y además admite cualquier color. No se pierde nada accesible:
           la imagen era decorativa (`alt=""`) y quien nombra el enlace es su
           `aria-label`. -->
      <a
        class="home-footer__book-link"
        href={ROUTES.complaints}
        aria-label="Libro de reclamaciones"
        style={`--book-icon:url(${footerLibro.src})`}
      >
        <span class="home-footer__book" aria-hidden="true"></span>
      </a>
      <span>FAQ'S</span>
      <img class="home-footer__seal" src={footerIso9001.src} width="88" height="96" alt="Certificación ISO 9001" />
    </section>
  </div>
  <div class="home-footer__bottom">
    <p>Copyright © AYNI 2026 - Todos los derechos reservados.</p>
    <div class="home-footer__social" aria-label="Redes sociales">
      <img src={socialFacebook.src} width="24" height="24" alt="Facebook" />
      <img src={socialLinkedin.src} width="24" height="24" alt="LinkedIn" />
      <img src={socialInstagram.src} width="24" height="24" alt="Instagram" />
      <img src={socialYoutube.src} width="24" height="24" alt="YouTube" />
    </div>
  </div>
</footer>

<style>
  .home-footer {
    position: relative;
    min-height: 390px;
    padding: 62px clamp(28px, 5.5vw, 80px) 20px;
    overflow: hidden;
    background: #070707;
    color: #6b6b6b;
    font-family: Poppins, sans-serif;
    isolation: isolate;
  }

  .home-footer__anchor {
    position: absolute;
    inset: 0 auto auto 0;
  }

  .home-footer::before {
    position: absolute;
    z-index: 0;
    inset: 0;
    background-image: var(--footer-pattern-desktop);
    background-position: center;
    background-size: cover;
    content: '';
    pointer-events: none;
  }

  /* El Figma repite en la entrada del footer el mismo halo cálido que abre la
     sección de puntos de recojo. Se mantiene entre el patrón y el contenido
     para iluminar el fondo sin lavar los textos ni los logotipos. */
  .home-footer::after {
    position: absolute;
    z-index: 0;
    top: 0;
    left: 50%;
    width: min(100%, 1440px);
    height: 211px;
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse 43% 142% at 47.2% -98.6%,
      rgba(249, 203, 105, 1) 0%,
      rgba(206, 168, 86, .75) 25%,
      rgba(163, 133, 68, .5) 50%,
      rgba(77, 62, 30, 0) 100%
    );
    content: '';
    pointer-events: none;
  }

  .home-footer__main {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr .65fr 1.55fr .8fr;
    gap: 44px;
    width: min(100%, 1280px);
    margin-inline: auto;
  }

  .home-footer__links {
    display: contents;
  }

  .home-footer__brand img {
    display: block;
    width: min(100%, 176px);
    height: auto;
  }

  .home-footer__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .home-footer h2 {
    margin: 0;
    color: #c4bba8;
    font-size: 16px;
    font-weight: 600;
    line-height: 24px;
    letter-spacing: 0;
  }

  .home-footer__list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .home-footer a,
  .home-footer span {
    display: block;
    margin: 0;
    color: #6b6b6b;
    font-size: 13px;
    font-weight: 300;
    line-height: 1.35;
    text-decoration: none;
  }

  /* El mismo dorado que usa el header al pasar por encima, para que el sitio
     responda igual arriba y abajo. La regla apunta solo a `a` y no al selector
     de arriba: el estilo base lo comparten con los `span` —"FAQ'S"—, que no
     llevan a ningún sitio y encenderlos prometería un enlace que no existe.
     `:focus-visible` acompaña al hover para que con teclado se vea lo mismo. */
  .home-footer a {
    transition: color .18s ease;
  }

  .home-footer a:hover,
  .home-footer a:focus-visible {
    color: #f9cb69;
  }

  /* Los enlaces de texto crecen igual que el icono del libro. Va acotado a los
     de las listas y no a `.home-footer a` para no alcanzar al enlace del icono:
     ese ya escala su `span` interno, así que heredar esto lo multiplicaría por
     sí mismo. El origen a la izquierda mantiene fija la columna. */
  .home-footer__list a {
    transition:
      color .18s ease,
      transform .34s cubic-bezier(.22, .61, .36, 1);
  }

  .home-footer__list a:hover,
  .home-footer__list a:focus-visible {
    transform: scale(var(--hover-scale, 1.05));
    transform-origin: left center;
  }

  .home-footer__book-link {
    line-height: 0;
  }

  .home-footer__book,
  .home-footer__seal {
    display: block;
    flex: none;
  }

  .home-footer__seal {
    object-fit: fill;
  }

  /* Base: el icono pintado como imagen de fondo, idéntico a como se veía. Si el
     navegador no soporta máscaras se queda exactamente así —crece, pero no se
     tiñe— en vez de arriesgar un rectángulo sólido.
     La curva del escalado es la misma que el hover de las bolsas en
     `ProductsBanner`, que es el gesto de "crecer" que ya usa el sitio. */
  .home-footer__book {
    width: 50px;
    height: 20px;
    background: var(--book-icon) no-repeat center / contain;
    transition:
      transform .34s cubic-bezier(.22, .61, .36, 1),
      background-color .18s ease;
  }

  /* El origen a la izquierda lo deja anclado al borde de la columna, alineado
     con el título de encima, en vez de desplazarse hacia fuera al escalar. */
  .home-footer__book-link:hover .home-footer__book,
  .home-footer__book-link:focus-visible .home-footer__book {
    transform: scale(var(--hover-scale, 1.05));
    transform-origin: left center;
  }

  @supports (mask-image: url('')) or (-webkit-mask-image: url('')) {
    /* Con máscara el color lo pone el fondo, así que el icono puede teñirse del
       mismo dorado que los enlaces de texto. */
    .home-footer__book {
      background: #fff;
      -webkit-mask: var(--book-icon) no-repeat center / contain;
      mask: var(--book-icon) no-repeat center / contain;
    }

    .home-footer__book-link:hover .home-footer__book,
    .home-footer__book-link:focus-visible .home-footer__book {
      background-color: #f9cb69;
    }
  }

  .home-footer__seal {
    width: 88px;
    height: 96px;
  }

  .home-footer__bottom {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: end;
    justify-content: space-between;
    width: min(100%, 1280px);
    margin: 55px auto 0;
  }

  .home-footer__bottom p {
    margin: 0;
    font-family: Montserrat, sans-serif;
    font-size: 11px;
  }

  .home-footer__social {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .home-footer__social img {
    display: block;
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  @media (max-width: 767px) {
    /* En vertical los enlaces largos ya ocupan el ancho de la columna y van a
       dos líneas: al escalar se saldrían unos 30 px —el `transform` no reflota—
       y el hueco de 8 px entre ellos se quedaría en 2. Aquí solo cambia el
       color. El icono del libro sí sigue creciendo: es pequeño y le sobra sitio. */
    .home-footer__list a:hover,
    .home-footer__list a:focus-visible {
      transform: none;
    }

    .home-footer {
      display: flex;
      min-height: 936px;
      flex-direction: column;
      align-items: flex-start;
      gap: 40px;
      padding: 40px 16px 24px;
    }

    .home-footer::before {
      background-image: var(--footer-pattern-mobile);
      background-position: center top;
      background-size: cover;
      background-repeat: no-repeat;
    }

    .home-footer::after {
      width: 160vw;
      height: 170px;
    }

    .home-footer__main {
      display: flex;
      width: 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: 80px;
      margin: 0;
    }

    .home-footer__brand {
      width: 107px;
      height: 24px;
      overflow: hidden;
    }

    .home-footer__brand img {
      width: 107px;
      max-width: none;
      height: auto;
      transform: translateY(-3.5px);
    }

    .home-footer__links {
      display: flex;
      width: 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: 48px;
    }

    .home-footer__item {
      width: 100%;
    }

    .home-footer h2 {
      font-size: 20px;
      line-height: 24px;
    }

    .home-footer a,
    .home-footer span {
      font-size: 16px;
      line-height: 24px;
    }

    .home-footer__claims {
      width: auto;
      min-width: 238px;
    }

    .home-footer__bottom {
      display: flex;
      width: 100%;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      gap: 16px;
      margin: 0;
    }

    .home-footer__bottom p {
      align-self: stretch;
      color: #fff;
      font-size: 12px;
      line-height: 16px;
      white-space: nowrap;
    }
  }

  @media (max-width: 359px) {
    .home-footer__bottom p {
      font-size: 10px;
    }
  }
</style>
