---
import { Image } from 'astro:assets';
import bonusFocus from '../../assets/v2/ambassadors-bonus-focus.webp';
import bonusGlow from '../../assets/v2/ambassadors-bonus-glow.webp';
import bonusSponsorship from '../../assets/v2/ambassadors-bonus-sponsorship.webp';
import star1 from '../../assets/v2/ambassadors-star-1.webp';
import star2 from '../../assets/v2/ambassadors-star-2.webp';
import star3 from '../../assets/v2/ambassadors-star-3.webp';
import star4 from '../../assets/v2/ambassadors-star-4.webp';

// Las cuatro variantes de «Beneficios AYNI» en Figma sólo se diferencian en la
// foto: el titular y el texto son idénticos en todas. Así que el carrusel rota
// la imagen y deja el contenido quieto encima.
const STAR_PHOTOS = [star1, star2, star3, star4];
const STAR_INTERVAL = 4500;
const STAR_FADE = 1100;
---

<div class="ambassadors-bands">
  <section class="ambassadors-band ambassadors-band--sponsorship" aria-labelledby="bonus-sponsorship-title" data-band-reveal>
    <div class="ambassadors-band__backdrop" aria-hidden="true">
      <Image src={bonusSponsorship} alt="" loading="lazy" widths={[768, 1440, 2880]} sizes="100vw" />
      <span class="ambassadors-band__glaze"></span>
      <span class="ambassadors-band__glow">
        <Image src={bonusGlow} alt="" loading="lazy" widths={[768, 1440]} sizes="65vw" />
      </span>
    </div>
    <div class="ambassadors-band__text">
      <h2 id="bonus-sponsorship-title">Bono Patrocinio</h2>
      <p>Gana el 15% del puntaje por la primera compra de tu nuevo socio y un 10% en sus reconsumos.</p>
    </div>
  </section>

  <section class="ambassadors-band ambassadors-band--focus" aria-labelledby="bonus-focus-title" data-band-reveal>
    <div class="ambassadors-band__backdrop" aria-hidden="true">
      <Image src={bonusFocus} alt="" loading="lazy" widths={[768, 1440, 2880]} sizes="100vw" />
      <span class="ambassadors-band__glaze"></span>
    </div>
    <div class="ambassadors-band__text">
      <h2 id="bonus-focus-title">Bono Enfoque</h2>
      <p>
        Al cerrar el año, AYNI te recompensa con un 10% adicional acumulado de tus comisiones. Solo
        debes mantener tu membresía IBO y estado «Activo» ininterrumpidamente, con un rango menor a
        GEN 5000 en cada ciclo.
      </p>
    </div>
  </section>

  <section class="ambassadors-star" aria-labelledby="ayni-star-title">
    <div class="ambassadors-star__backdrop" aria-hidden="true" data-star-carousel data-star-interval={STAR_INTERVAL} data-star-fade={STAR_FADE}>
      {STAR_PHOTOS.map((photo, index) => (
        <Image
          src={photo}
          alt=""
          loading="lazy"
          widths={[768, 1440, 2880]}
          sizes="100vw"
          data-star-slide
          data-active={index === 0 ? 'true' : 'false'}
        />
      ))}
      <span class="ambassadors-star__fade"></span>
    </div>
    <div class="ambassadors-star__text">
      <h2 id="ayni-star-title">AYNI Estrella</h2>
      <p>
        Tu constancia tiene recompensa. Disfruta de una experiencia de viaje única en nuestra región
        al consolidar tu liderazgo por 24 ciclos de negocio ininterrumpidos.
      </p>
    </div>
  </section>
</div>

<style>
  /* Las tres bandas son el mismo bloque escalado: en Figma el frame móvil (390)
     es el de escritorio (1440) multiplicado por 0,2708, tipografías incluidas.
     Por eso aquí no hay un solo breakpoint —todo sale de `--w`, el ancho de
     referencia del diseño— y los coeficientes son la medida de Figma partida
     por 1440: 40px de titular son 0,02778.

     `--w` no es sólo el ancho del viewport. Como la banda conserva su
     proporción, crecer a lo ancho la hace crecer a lo alto: a 1920 la de AYNI
     Estrella pedía 1067px y no cabía en pantalla. Así que el ancho de
     referencia lo limita también la altura disponible —una banda 2:1 sólo puede
     medir 200svh de ancho antes de pasarse, y la 1,8:1, 180svh—, y con él
     encogen a la vez altura, tipografía y posiciones. La imagen sigue ocupando
     el 100% del ancho: lo que sobra lo recorta `cover`.

     Se parte de `vh` y `svh` entra por `@supports`: en una custom property las
     dos declaraciones parsean y ganaría la segunda, así que sin esa guarda un
     navegador sin `svh` dejaría `--w` con un valor inválido y la banda a cero. */
  .ambassadors-band { --w:min(100vw,1920px,200vh);position:relative;height:calc(var(--w) / 2);overflow:hidden;background:#000;isolation:isolate; }
  .ambassadors-star { --w:min(100vw,1920px,180vh);position:relative;height:calc(var(--w) / 1.8);overflow:hidden;background:#000;isolation:isolate; }
  @supports (height:100svh){
    .ambassadors-band { --w:min(100vw,1920px,200svh); }
    .ambassadors-star { --w:min(100vw,1920px,180svh); }
  }

  .ambassadors-band__backdrop,.ambassadors-star__backdrop { position:absolute;z-index:0;inset:0;pointer-events:none; }
  .ambassadors-band__backdrop :global(img) { display:block;width:100%;height:100%;object-fit:cover; }
  /* Velo dorado radial anclado al borde derecho. El original es un rect al 20%
     sobre un radial de 1440×2880, que en relativo son 100% del ancho por 400%
     del alto; las paradas ya llevan ese 20% multiplicado. */
  .ambassadors-band__glaze { position:absolute;inset:0;background:radial-gradient(100% 400% at 100% 50%,rgba(110,88,43,.2) 0%,rgba(83,66,32,.15) 25%,rgba(55,44,22,.1) 50%,rgba(0,0,0,0) 100%); }
  .ambassadors-band__glow { position:absolute;right:0;bottom:0;width:64.72%;height:100%;overflow:hidden;opacity:.9; }
  .ambassadors-band__glow :global(img) { position:absolute;top:-.04%;left:-19.93%;width:119.93%;height:100.08%;max-width:none;object-fit:cover; }

  /* El bloque de texto va centrado en las tres: en Figma el de AYNI Estrella
     arranca en 138 y mide 1166, que es el mismo centrado con 1px de redondeo. */
  .ambassadors-band__text,.ambassadors-star__text { position:absolute;z-index:1;left:50%;display:flex;width:calc(var(--w) * .8097);flex-direction:column;transform:translateX(-50%); }
  .ambassadors-band__text { gap:calc(var(--w) * .005556); }
  .ambassadors-band h2 { margin:0;color:#f9cb69;font-family:Poppins,sans-serif;font-size:calc(var(--w) * .027778);font-weight:600;line-height:1.2;letter-spacing:0;white-space:nowrap; }
  .ambassadors-band p { width:calc(var(--w) * .3646);margin:0;color:#fefaf0;font-family:Montserrat,sans-serif;font-size:calc(var(--w) * .013889);font-weight:400;line-height:1.2; }
  .ambassadors-band--sponsorship .ambassadors-band__text { top:47.08%;align-items:flex-end;text-align:right; }
  .ambassadors-band--focus .ambassadors-band__text { top:50%;align-items:flex-start;transform:translate(-50%,-50%); }

  /* Entrada en látigo. Figma la guarda como una tercera variante de cada banda
     —«Component 148»— que es el mismo bloque colocado fuera del encuadre y en
     blanco: Patrocinio empieza en x=1070 y Enfoque en x=-830, cada uno saliendo
     del borde hacia el lado donde acaba, y los dos 128px más arriba de su sitio.
     Los recorridos van en fracción de `--w` (933/1440, 967/1440…) para que
     escalen igual que el resto de la banda.

     El estado por defecto es el de llegada, y es el script el que marca
     `data-revealed="false"` al cargar: así, sin JS o sin `IntersectionObserver`,
     el texto simplemente está en su sitio en vez de quedarse fuera para
     siempre. Como las bandas viven muy por debajo del pliegue, no hay parpadeo.

     El párrafo lleva un pelo de retraso y de recorrido extra sobre el titular:
     es lo que da el chasquido, la cola llegando después que la punta.
     Las transiciones cuelgan del estado de llegada y no del elemento: así el
     viaje de ida se anima y la vuelta —cuando la banda sale de pantalla y se
     rearma— es instantánea. Si no, al volver a subir rápido se alcanzaría a ver
     el texto retrocediendo. Por el mismo motivo, colocar el estado inicial al
     cargar tampoco anima nada. */
  .ambassadors-band { --whip:1.35s;--whip-ease:cubic-bezier(.16,1,.3,1);--whip-lag:.1s; }
  .ambassadors-band[data-revealed='true'] .ambassadors-band__text { transition:transform var(--whip) var(--whip-ease); }
  .ambassadors-band[data-revealed='true'] .ambassadors-band__text p { transition:transform calc(var(--whip) + .1s) var(--whip-ease) var(--whip-lag); }
  .ambassadors-band[data-revealed='true'] h2 { transition:color .9s ease .5s; }
  .ambassadors-band[data-revealed='true'] .ambassadors-band__glow { transition:opacity 1.1s ease .45s; }

  .ambassadors-band[data-revealed='false'] h2 { color:#fff; }
  .ambassadors-band[data-revealed='false'] .ambassadors-band__glow { opacity:0; }
  .ambassadors-band--sponsorship[data-revealed='false'] .ambassadors-band__text { transform:translate(calc(-50% + var(--w) * .64792),calc(var(--w) * -.14653)); }
  .ambassadors-band--sponsorship[data-revealed='false'] .ambassadors-band__text p { transform:translateX(calc(var(--w) * .06)); }
  .ambassadors-band--focus[data-revealed='false'] .ambassadors-band__text { transform:translate(calc(-50% + var(--w) * -.67153),calc(-50% + var(--w) * -.10833)); }
  .ambassadors-band--focus[data-revealed='false'] .ambassadors-band__text p { transform:translateX(calc(var(--w) * -.06)); }

  /* Las cuatro fotos van apiladas y sólo se ve la marcada como activa. El 101%
     de alto es el 808/800 del original: el sobrante lo recorta la banda.

     Mientras está a la vista, la foto activa deriva muy despacio —un punto de
     zoom y un roce lateral— para que la banda respire en vez de quedarse como
     una lámina quieta. La deriva dura lo que la foto en pantalla (el intervalo
     más el fundido) y va en lineal a propósito: cualquier curva se notaría como
     un arranque o un frenazo. El sentido se alterna entre fotos para que no
     parezca un tic mecánico.

     El `transform` sólo transiciona en el estado activo: al desactivarse, la
     foto vuelve a su encuadre de golpe —invisible, porque ya está a opacidad
     cero— y la siguiente vuelta arranca otra vez desde el principio. La
     opacidad sí transiciona en los dos sentidos, que para eso es un cruce. */
  .ambassadors-star__backdrop { --fade:1.1s;--drift:5.6s; }
  .ambassadors-star__backdrop :global(img) { position:absolute;top:0;left:0;z-index:0;display:block;width:100%;height:101%;opacity:0;object-fit:cover;object-position:bottom;transform:scale(1);transition:opacity var(--fade) linear; }
  /* La entrante se funde por encima de una foto que sigue opaca debajo, así que
     el cruce no pasa nunca por el fondo negro —cosa que sí ocurría al volver de
     la última a la primera, cuando el orden del DOM dejaba la entrante debajo—.
     Por eso el fundido va en lineal: al no haber mezcla de semitransparencias,
     cualquier curva sólo se notaría como un tirón al arrancar o al frenar. */
  .ambassadors-star__backdrop :global(img[data-active='true']) { z-index:2;opacity:1;transform:scale(1.06) translateX(-1%);transition:opacity var(--fade) linear,transform var(--drift) linear; }
  /* Estado de salida: aguanta debajo, con su deriva intacta, hasta que la
     entrante la ha tapado del todo; sólo entonces desaparece (opacidad con
     duración cero y retraso igual al fundido). Sin este paso intermedio, la
     saliente pegaba el tirón de volver a su encuadre a plena vista. */
  .ambassadors-star__backdrop :global(img[data-active='leaving']) { z-index:1;opacity:0;transform:scale(1.06) translateX(-1%);transition:opacity 0s linear var(--fade),transform var(--drift) linear; }
  .ambassadors-star__backdrop :global(img:nth-child(even)[data-active='true']),.ambassadors-star__backdrop :global(img:nth-child(even)[data-active='leaving']) { transform:scale(1.06) translateX(1%); }
  @media(prefers-reduced-motion:reduce){
    .ambassadors-star__backdrop :global(img),.ambassadors-star__backdrop :global(img[data-active='true']),.ambassadors-star__backdrop :global(img[data-active='leaving']) { transform:none;transition:none; }
  }
  .ambassadors-star__fade { position:absolute;z-index:3;right:0;bottom:0;left:0;height:68%;background:linear-gradient(180deg,rgba(0,0,0,0) 0%,rgba(0,0,0,.95) 100%); }
  .ambassadors-star__text { top:73.25%;align-items:flex-end;gap:calc(var(--w) * .01111);text-align:right; }
  .ambassadors-star h2 { margin:0;color:#f9cb69;font-family:Montserrat,sans-serif;font-size:calc(var(--w) * .027778);font-weight:700;line-height:1.2;letter-spacing:-.05em;white-space:nowrap; }
  .ambassadors-star p { width:calc(var(--w) * .3646);margin:0;color:#fff;font-family:Montserrat,sans-serif;font-size:calc(var(--w) * .0125);font-weight:400;line-height:1.444; }
</style>

<script>
  // Entrada en látigo de las dos bandas de bono. El HTML sale ya en su estado
  // final: es este script el que lo retira fuera del encuadre y sólo si puede
  // devolverlo, de modo que sin JS, sin `IntersectionObserver` o con el sistema
  // pidiendo menos movimiento, el texto se queda donde debe.
  const bands = [...document.querySelectorAll<HTMLElement>('[data-band-reveal]')];
  const quiet = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (bands.length && 'IntersectionObserver' in window && !quiet) {
    for (const band of bands) band.dataset.revealed = 'false';

    // Dos umbrales distintos a propósito: entra cuando la banda ya ocupa la
    // pantalla de verdad y sólo se rearma cuando ha salido entera. Con un único
    // umbral el texto entraría y saldría a cada temblor del scroll sobre el
    // borde; y con el listón bajo, la animación se gastaba mientras la banda
    // todavía asomaba por abajo y no daba tiempo a verla.
    //
    // Se mira por dos caminos porque `intersectionRatio` es la fracción de la
    // banda visible, no de la pantalla ocupada: si alguna vez una banda acaba
    // siendo más alta que la ventana, ese ratio no llegaría nunca al 60% y el
    // texto se quedaría fuera para siempre. La segunda condición —cuánta
    // pantalla cubre— cierra ese agujero.
    const ENTRY = 0.6;
    const reveal = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const band = entry.target as HTMLElement;
          const screenful = entry.rootBounds
            ? entry.intersectionRect.height / entry.rootBounds.height
            : 0;

          if (entry.intersectionRatio >= ENTRY || screenful >= ENTRY) band.dataset.revealed = 'true';
          else if (!entry.isIntersecting) band.dataset.revealed = 'false';
        }
      },
      { threshold: [0, 0.25, 0.4, 0.6, 0.8, 1] },
    );

    for (const band of bands) reveal.observe(band);
  }

  // El carrusel es decorativo —las cuatro fotos comparten texto— así que no
  // lleva controles ni anuncia nada: el contenedor ya va con `aria-hidden`.
  // Sólo corre mientras la banda está a la vista, y no corre en absoluto si el
  // sistema pide menos movimiento.
  const carousel = document.querySelector<HTMLElement>('[data-star-carousel]');
  const slides = carousel ? [...carousel.querySelectorAll<HTMLElement>('[data-star-slide]')] : [];

  if (carousel && slides.length > 1) {
    const interval = Number(carousel.dataset.starInterval);
    const fade = Number(carousel.dataset.starFade);
    // La deriva dura lo que la foto a la vista: se calcula en vez de repetirla
    // en el CSS, para que tocar el ritmo no deje descolgado el movimiento. Los
    // valores del CSS quedan de respaldo.
    carousel.style.setProperty('--fade', `${fade}ms`);
    carousel.style.setProperty('--drift', `${interval + fade}ms`);
    const stillness = matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    const advance = () => {
      // La anterior pasa por «leaving» y no directamente a apagada: ahí es
      // donde aguanta mientras la nueva se funde encima. La de la vuelta pasada
      // ya cumplió, y al retirarla ahora —invisible desde hace rato— recupera
      // su encuadre para cuando le toque de nuevo.
      for (const slide of slides) if (slide.dataset.active === 'leaving') slide.dataset.active = 'false';
      slides[current].dataset.active = 'leaving';
      current = (current + 1) % slides.length;
      slides[current].dataset.active = 'true';
    };

    const start = () => {
      if (timer || stillness.matches) return;
      timer = setInterval(advance, interval);
    };

    const stop = () => {
      clearInterval(timer);
      timer = undefined;
    };

    // Arranca de entrada y el observador sólo sirve para pausar fuera de
    // pantalla: al revés —esperando a que avise de que se ve— un navegador que
    // no entregue el callback dejaría el carrusel congelado para siempre.
    start();
    new IntersectionObserver(([entry]) => (entry.isIntersecting ? start() : stop())).observe(carousel);
    stillness.addEventListener('change', () => (stillness.matches ? stop() : start()));
  }
</script>
