---
---

<style>
  .brand-gold-border {
    border-color: var(--color-brand-gold);
  }

  .brand-gold-text {
    color: var(--color-brand-gold);
  }

  .brand-gold-background {
    background-color: var(--color-brand-gold);
  }
</style>

<!-- PWA Update Toast Notification -->
<div 
  id="pwa-update-toast" 
  class="brand-gold-border fixed bottom-6 right-6 z-[9999] hidden max-w-sm rounded-xl border bg-black/90 p-4 shadow-[0px_0px_30px_0px_rgba(243,200,100,0.3)] backdrop-blur-md transition-all duration-300 translate-y-10 opacity-0"
>
  <div class="flex items-start gap-3">
    <div class="brand-gold-text flex-shrink-0 mt-0.5">
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 8H18.5M7 16H4m0 0v3m0-3h3m1.879-11.879a3 3 0 11-4.243 4.243m16.97 0a3 3 0 11-4.243-4.243M12 18a6 6 0 100-12 6 6 0 000 12z" />
      </svg>
    </div>
    <div class="flex-grow">
      <h3 class="brand-gold-text text-sm font-semibold">Nueva versión disponible</h3>
      <p class="mt-1 text-xs text-gray-300">Hay una nueva versión de la presentación. Haz clic abajo para actualizar al instante.</p>
      <div class="mt-3 flex gap-2">
        <button 
          id="pwa-update-btn" 
          class="brand-gold-background rounded-lg px-3 py-1.5 text-xs font-bold text-black shadow-md hover:bg-white hover:text-black transition-colors"
        >
          Actualizar ahora
        </button>
        <button 
          id="pwa-close-toast-btn" 
          class="rounded-lg border border-gray-600 px-3 py-1.5 text-xs font-medium text-gray-300 hover:bg-white/10 hover:text-white transition-colors"
        >
          Cerrar
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  let updateSWFunc: ((reload?: boolean) => Promise<void>) | null = null;

  window.addEventListener('pwa-update-available', (event: any) => {
    updateSWFunc = event.detail.updateSW;
    const toast = document.getElementById('pwa-update-toast');
    if (toast) {
      toast.classList.remove('hidden');
      // Trigger animations
      setTimeout(() => {
        toast.classList.remove('translate-y-10', 'opacity-0');
      }, 50);
    }
  });

  // Handle update click
  document.getElementById('pwa-update-btn')?.addEventListener('click', () => {
    if (updateSWFunc) {
      updateSWFunc(true);
    }
  });

  // Handle close click
  document.getElementById('pwa-close-toast-btn')?.addEventListener('click', () => {
    const toast = document.getElementById('pwa-update-toast');
    if (toast) {
      toast.classList.add('translate-y-10', 'opacity-0');
      setTimeout(() => {
        toast.classList.add('hidden');
      }, 300);
    }
  });
</script>
