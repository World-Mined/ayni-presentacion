---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  name: string;
  isProduct: boolean;
  isFormula: boolean;
}

const { image, name, isProduct, isFormula } = Astro.props;
---

<div class:list={[
  'mobile-scene',
  'mobile-image-scene',
  isProduct && 'mobile-image-scene--product',
  isFormula && 'mobile-image-scene--formula',
]}>
  <Image
    src={image}
    alt={name}
    class:list={['mobile-slide-image', isProduct && 'mobile-slide-image--product']}
    widths={[390, 780, 1080]}
    sizes={isProduct ? '125vw' : '100vw'}
    quality={82}
  />
</div>

<style is:global>
  .mobile-image-scene {
    display: block;
    width: 100%;
  }

  .mobile-slide-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .slide:is([data-slide-id='bonos-1'], [data-slide-id='bonos-2']) .mobile-image-scene {
    position: relative;
    left: 50%;
    width: max(100%, calc(var(--mobile-vh) * 0.5625));
    max-width: none;
    transform: translateX(-50%);
  }

  .slide:is([data-slide-id='bonos-1'], [data-slide-id='bonos-2']) .mobile-slide-image {
    width: 100%;
    height: auto;
    max-width: none;
  }

  /*
   * Cada escena de producto se encuadra con dos valores:
   *   --scene-offset: cuánto se desplaza en vertical.
   *   --scene-min-width: ancho mínimo que exige el encuadre horizontal.
   * El ancho final se deriva del offset, así la imagen siempre llega al borde
   * inferior y no queda franja negra por debajo.
   *
   * Doble clase a propósito: estas escenas se desbordan del viewport y deben
   * ganarle al `max-width: 100%` de `.mobile-scene`, que vive en otro componente
   * y por tanto en una hoja cuyo orden no controlamos.
   */
  .mobile-scene.mobile-image-scene--product {
    --scene-offset: 0px;
    --scene-min-width: 125vw;

    position: relative;
    left: 50%;
    display: block;
    width: max(
      var(--scene-min-width),
      100vw,
      calc((var(--mobile-vh) - var(--scene-offset)) * 0.5625)
    );
    max-width: none;
    margin-top: var(--scene-offset);
    transform: translateX(-50%);
  }

  .slide[data-slide-id='reset-360'] .mobile-image-scene--product {
    --scene-offset: -6px;
    --scene-min-width: 122vw;

    left: calc(50% + 8px);
    margin-left: 0;
  }

  .mobile-scene.mobile-image-scene--product.mobile-image-scene--formula {
    --scene-offset: 56px;
    --scene-min-width: 106vw;
  }

  .slide[data-slide-id='moravi-formula'] .mobile-image-scene--formula {
    --scene-offset: 9px;
    --scene-min-width: 112vw;

    left: calc(50% - 7px);
    margin-right: 0;
  }

  .slide[data-slide-id='reset-formula'] .mobile-image-scene--formula {
    --scene-offset: 19px;
    --scene-min-width: 112vw;
  }

  @media (max-width: 430px) and (max-height: 700px) {
    .mobile-scene.mobile-image-scene--product,
    .slide[data-slide-id='reset-360'] .mobile-image-scene--product,
    .mobile-scene.mobile-image-scene--product.mobile-image-scene--formula,
    .slide[data-slide-id='moravi-formula'] .mobile-image-scene--formula,
    .slide[data-slide-id='reset-formula'] .mobile-image-scene--formula {
      --scene-min-width: 100vw;
    }
  }

  .mobile-slide-image--product {
    display: block;
    width: 100%;
    height: auto;
    max-width: none;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }
</style>
