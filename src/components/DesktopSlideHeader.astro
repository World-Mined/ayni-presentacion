---
import type { SlideHeader } from '../data/slides';
import { SlideId } from '../data/slide-ids';

interface Props {
  header: SlideHeader;
}

const { header } = Astro.props;
---

<header class="desktop-slide-header">
  <div class="header-left">
    {header.showClose && (
      (header.disableClose || !header.closeTo) ? (
        <div class="header-btn close-btn disabled" title="Cerrar deshabilitado">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" class="material-close-icon" aria-hidden="true">
            <path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z" />
          </svg>
        </div>
      ) : (
        <a href={`#${header.closeTo}`} class="header-btn close-btn" title="Cerrar" aria-label="Cerrar">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" class="material-close-icon" aria-hidden="true">
            <path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z" />
          </svg>
        </a>
      )
    )}

    {header.showArrows && (
      <>
        {(header.disableArrows || header.disablePrevArrow || !header.prevSlide) ? (
          <div class="header-btn arrow-btn disabled" title="Anterior deshabilitado">
            <img src="/assets/arrow_left.svg" alt="" />
          </div>
        ) : (
          <a href={`#${header.prevSlide}`} class="header-btn arrow-btn" title="Anterior" aria-label="Anterior">
            <img src="/assets/arrow_left.svg" alt="" />
          </a>
        )}

        {(header.disableArrows || header.disableNextArrow || !header.nextSlide) ? (
          <div class="header-btn arrow-btn disabled" title="Siguiente deshabilitado">
            <img src="/assets/arrow_right.svg" alt="" />
          </div>
        ) : (
          <a href={`#${header.nextSlide}`} class="header-btn arrow-btn" title="Siguiente" aria-label="Siguiente">
            <img src="/assets/arrow_right.svg" alt="" />
          </a>
        )}
      </>
    )}
  </div>

  {header.activeTab && (
    <nav class="header-center" aria-label="Productos AYNI">
      <div class="product-tabs">
        <a
          href={`#${SlideId.Capucci}`}
          class:list={['tab-pill', header.activeTab === 'capucci' && 'active', header.disabledTabs?.includes('capucci') && 'disabled']}
        >
          Capucci 360
        </a>
        <a
          href={`#${SlideId.Moravi}`}
          class:list={['tab-pill', header.activeTab === 'moravi' && 'active', header.disabledTabs?.includes('moravi') && 'disabled']}
        >
          Moravi 360
        </a>
        <a
          href={`#${SlideId.Reset}`}
          class:list={['tab-pill', header.activeTab === 'reset' && 'active', header.disabledTabs?.includes('reset') && 'disabled']}
        >
          Reset 360
        </a>
      </div>
    </nav>
  )}
</header>

<style>
  .desktop-slide-header {
    position: absolute;
    top: clamp(14px, 1.5vw, 28px);
    right: clamp(16px, 2.5vw, 48px);
    left: clamp(16px, 2.5vw, 48px);
    z-index: 40;
    display: flex;
    height: clamp(38px, 3vw, 48px);
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
  }

  :global(html[data-presentation-mode='mobile']) .desktop-slide-header {
    display: none;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: clamp(6px, 0.55vw, 10px);
    pointer-events: auto;
  }

  .header-btn {
    display: flex;
    width: clamp(36px, 2.5vw, 46px);
    height: clamp(36px, 2.5vw, 46px);
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(243, 200, 100, 0.35);
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0.68);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.42);
    transition: background-color 0.2s, border-color 0.2s, transform 0.2s;
  }

  .header-btn img,
  .header-btn svg {
    width: clamp(18px, 1.25vw, 22px);
    height: clamp(18px, 1.25vw, 22px);
    pointer-events: none;
  }

  .material-close-icon {
    fill: #ffffff;
    transition: fill 0.2s;
  }

  .header-btn:hover {
    border-color: rgba(243, 200, 100, 0.8);
    background-color: rgba(243, 200, 100, 0.12);
    transform: scale(1.05);
  }

  .header-btn:hover .material-close-icon {
    fill: var(--color-brand-gold);
  }

  .header-btn:active {
    transform: scale(0.95);
  }

  .header-btn:focus-visible,
  .tab-pill:focus-visible {
    outline: 2px solid var(--color-brand-gold);
    outline-offset: 3px;
  }

  .header-btn.disabled {
    border-color: rgba(255, 255, 255, 0.12);
    opacity: 0.22;
    pointer-events: none;
  }

  .header-center {
    position: absolute;
    left: 50%;
    display: flex;
    align-items: center;
    transform: translateX(-50%);
    pointer-events: auto;
  }

  .product-tabs {
    display: flex;
    align-items: center;
    padding: 2px;
    border: 1px solid var(--color-brand-gold);
    border-radius: 100px;
    background-color: rgba(0, 0, 0, 0.58);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5), inset 0 0 10px rgba(243, 200, 100, 0.1);
    backdrop-filter: blur(6px);
  }

  .tab-pill {
    display: flex;
    height: clamp(32px, 2.35vw, 40px);
    align-items: center;
    justify-content: center;
    padding: 0 clamp(14px, 1.35vw, 24px);
    border-radius: 100px;
    color: rgba(243, 200, 100, 0.72);
    font-size: clamp(12px, 0.9vw, 16px);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s, background-color 0.2s, box-shadow 0.2s;
  }

  .tab-pill:hover {
    color: var(--color-brand-gold);
    background-color: rgba(243, 200, 100, 0.1);
  }

  .tab-pill.active {
    color: #000000;
    background-color: var(--color-brand-gold);
    box-shadow: 0 2px 10px rgba(243, 200, 100, 0.4);
    font-weight: 700;
  }

  .tab-pill.disabled {
    opacity: 0.28;
    pointer-events: none;
  }

  @media (max-width: 1180px) {
    .desktop-slide-header {
      right: 14px;
      left: 14px;
    }

    .tab-pill {
      padding-inline: 12px;
    }
  }
</style>
