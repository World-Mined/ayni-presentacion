---
import { NUTRITION_DISCLAIMER, type NutritionFacts, type NutrientRow } from '../data/nutrition';

interface Props {
  facts: NutritionFacts;
  anchor: 'viewport' | 'image';
}

const { facts, anchor } = Astro.props;

const rowClass = (row: NutrientRow) => ['nutrition-row', row.variant && `nutrition-row--${row.variant}`];
---

<div class="nutrition-layer" data-nutrition-anchor={anchor}>
  <div class="nutrition-backdrop" aria-hidden="true"></div>
  <div class="nutrition-dock">
<aside
  class="nutrition-sidebar"
  data-nutrition-panel
  data-page="0"
  role="dialog"
  aria-label="Información nutricional"
  aria-hidden="true"
>
  <button type="button" class="nutrition-close-icon" data-nutrition-close aria-label="Cerrar tabla nutricional">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" aria-hidden="true">
      <path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z" />
    </svg>
  </button>

  <div class="nutrition-body">
    <div class="nutrition-header">
      <div class="nutrition-title-row">
        <span class="nutrition-decorator" aria-hidden="true"></span>
        <h2 class="nutrition-title">Información nutricional</h2>
      </div>
      <div class="nutrition-divider" aria-hidden="true"></div>
    </div>

    <div class="nutrition-serving">
      <div class="nutrition-serving-line">
        <span class="nutrition-serving-label">Porción:</span>
        <span class="nutrition-serving-value">{facts.servingSize}</span>
      </div>
      <div class="nutrition-serving-line">
        <span class="nutrition-serving-label">Porciones por envase:</span>
        <span class="nutrition-serving-value">{facts.servingsPerContainer}</span>
      </div>
    </div>

    <div class="nutrition-table-head">
      <span class="nutrition-cell-name">Nutriente</span>
      <span class="nutrition-cell-value">Por 100g</span>
      <span class="nutrition-cell-value">{facts.servingColumnLabel}</span>
      <span class="nutrition-cell-value">%VD*</span>
    </div>

    <div class="nutrition-rows" data-nutrition-rows>
      <div class:list={rowClass(facts.energyRow)} data-nutrition-pinned>
        <span class="nutrition-cell-name">{facts.energyRow.name}</span>
        <span class="nutrition-cell-value">{facts.energyRow.per100g}</span>
        <span class="nutrition-cell-value">{facts.energyRow.perServing}</span>
        <span class="nutrition-cell-value">{facts.energyRow.vd}</span>
      </div>
      {facts.rows.map((row) => (
        <div class:list={rowClass(row)}>
          <span class="nutrition-cell-name">{row.name}</span>
          <span class="nutrition-cell-value">{row.per100g}</span>
          <span class="nutrition-cell-value">{row.perServing}</span>
          <span class="nutrition-cell-value">{row.vd}</span>
        </div>
      ))}
    </div>

    <p class="nutrition-disclaimer">{NUTRITION_DISCLAIMER}</p>
  </div>

  <div class="nutrition-pager" data-nutrition-pager hidden></div>

  <div class="nutrition-footer">
    <button type="button" class="nutrition-close-text" data-nutrition-close>Cerrar tabla</button>
  </div>
</aside>
  </div>
</div>

<script>
  // La tabla se pagina midiendo el alto real disponible, así aprovecha toda la
  // altura del panel y admite cualquier cantidad de nutrientes sin scroll.
  function paginate(panel: HTMLElement) {
    const list = panel.querySelector<HTMLElement>('[data-nutrition-rows]');
    const pager = panel.querySelector<HTMLElement>('[data-nutrition-pager]');
    if (!list || !pager) return;

    const pinned = list.querySelector<HTMLElement>('[data-nutrition-pinned]');
    const rows = [...list.querySelectorAll<HTMLElement>('.nutrition-row')].filter((r) => r !== pinned);
    if (!rows.length) return;

    // Con todas las filas visibles el contenedor da su alto disponible real.
    rows.forEach((row) => row.removeAttribute('hidden'));
    const available = list.clientHeight - (pinned?.offsetHeight ?? 0);
    if (available <= 0) return;

    let page = 0;
    let used = 0;
    rows.forEach((row) => {
      const height = row.offsetHeight;
      if (used > 0 && used + height > available) {
        page += 1;
        used = 0;
      }
      row.dataset.page = String(page);
      used += height;
    });

    const pageCount = page + 1;
    const current = Math.min(Number(panel.dataset.page ?? 0), pageCount - 1);
    panel.dataset.page = String(current);
    panel.dataset.pageCount = String(pageCount);

    if (pageCount > 1 && pager.childElementCount !== pageCount) {
      // Los estilos del componente están scopeados por atributo, así que los
      // botones creados a mano deben heredarlo del panel.
      const scope = [...panel.attributes]
        .map((attr) => attr.name)
        .find((name) => name.startsWith('data-astro-cid-'));

      pager.replaceChildren(
        ...Array.from({ length: pageCount }, (_, index) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'nutrition-pager-btn';
          button.dataset.nutritionPage = String(index);
          button.setAttribute('aria-label', `Página ${index + 1}`);
          button.textContent = String(index + 1);
          if (scope) button.setAttribute(scope, '');
          return button;
        })
      );
    }
    if (pageCount <= 1) pager.replaceChildren();
    pager.hidden = pageCount <= 1;

    showPage(panel, current);
  }

  function showPage(panel: HTMLElement, index: number) {
    panel.dataset.page = String(index);
    panel.querySelectorAll<HTMLElement>('.nutrition-row[data-page]').forEach((row) => {
      row.toggleAttribute('hidden', row.dataset.page !== String(index));
    });
    panel.querySelectorAll<HTMLElement>('.nutrition-pager-btn').forEach((button) => {
      button.classList.toggle('is-active', button.dataset.nutritionPage === String(index));
    });
    const list = panel.querySelector<HTMLElement>('[data-nutrition-rows]');
    if (list) list.scrollTop = 0;
  }

  function paginateAll() {
    document.querySelectorAll<HTMLElement>('[data-nutrition-panel]').forEach(paginate);
  }

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest<HTMLElement>('.nutrition-pager-btn');
    const panel = button?.closest<HTMLElement>('[data-nutrition-panel]');
    if (button && panel) showPage(panel, Number(button.dataset.nutritionPage));
  });

  // El alto del panel depende de la escala de la presentación, que index.astro
  // recalcula en cada resize y antes de abrir la tabla.
  document.addEventListener('nutrition:layout', paginateAll);
  window.addEventListener('resize', paginateAll);
  requestAnimationFrame(paginateAll);
</script>

<style>
  .nutrition-layer {
    /* Tipografía en el espacio de diseño 1920x1080, para que se lea al mismo
       tamaño aparente que los textos incrustados en la imagen de la slide. */
    /* Proporciones del diseño original; solo la tipografía sube un ~30%
       respecto a Figma para que se lea mejor en proyección. */
    --nut-width: 560px;
    --nut-fs-title: 20px;
    --nut-fs-label: 15px;
    --nut-fs-head: 13px;
    --nut-fs-row: 12px;
    --nut-fs-energy: 14px;
    --nut-fs-note: 12px;

    position: absolute;
    z-index: 41;
    inset: 0;
    pointer-events: none;
  }

  :global(html[data-presentation-mode='mobile']) .nutrition-layer {
    display: none;
  }

  .nutrition-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    opacity: 0;
    transition: opacity 0.28s ease, visibility 0.28s;
    visibility: hidden;
  }

  :global(.slide.nutrition-open) .nutrition-backdrop {
    opacity: 1;
    visibility: visible;
  }

  /* El dock aplica la escala de la presentación (estática) y recorta el
     deslizamiento de entrada; el panel solo anima su translate. */
  .nutrition-dock {
    position: absolute;
    width: var(--nut-width);
    overflow: hidden;
    transform-origin: top right;
    transform: scale(var(--slide-frame-scale, 1));
  }

  [data-nutrition-anchor='viewport'] .nutrition-dock {
    top: 0;
    right: 0;
    height: calc(100% / var(--slide-frame-scale, 1));
  }

  [data-nutrition-anchor='image'] .nutrition-dock {
    top: calc(50% - var(--slide-rendered-height) / 2);
    right: calc(50% - var(--slide-rendered-width) / 2);
    height: calc(var(--slide-rendered-height) / var(--slide-frame-scale, 1));
  }

  .nutrition-sidebar {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: flex-start;
    padding: 40px 20px 20px;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px 0 0 8px;
    background: #151619;
    box-shadow: -18px 0 48px rgba(0, 0, 0, 0.55);
    font-family: 'Montserrat', sans-serif;
    gap: 20px;
    pointer-events: auto;
    transform: translateX(100%);
    transition: transform 0.28s ease, visibility 0.28s;
    visibility: hidden;
  }

  :global(.slide.nutrition-open) .nutrition-sidebar {
    transform: translateX(0);
    visibility: visible;
  }

  .nutrition-body {
    display: flex;
    width: 100%;
    min-height: 0;
    flex: 1;
    flex-direction: column;
    gap: 16px;
  }

  /* Header */

  .nutrition-header {
    display: flex;
    width: 100%;
    flex: none;
    flex-direction: column;
    gap: 12px;
  }

  .nutrition-title-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nutrition-decorator {
    width: 4px;
    height: 22px;
    flex: none;
    border-radius: 2px;
    background: #e9c267;
  }

  .nutrition-title {
    margin: 0;
    color: #e9c267;
    font-size: var(--nut-fs-title);
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .nutrition-divider {
    width: 100%;
    border-top: 1px solid #e9c267;
  }

  /* Serving info */

  .nutrition-serving {
    display: flex;
    width: 100%;
    flex: none;
    flex-direction: column;
    gap: 6px;
  }

  .nutrition-serving-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 4px 0;
  }

  .nutrition-serving-label {
    color: #a1a1ab;
    font-size: var(--nut-fs-label);
    font-weight: 600;
    line-height: 1.25;
  }

  .nutrition-serving-value {
    color: #f5f5f7;
    font-size: var(--nut-fs-label);
    font-weight: 600;
    line-height: 1.25;
  }

  /* Table */

  .nutrition-table-head,
  .nutrition-row {
    display: flex;
    width: 100%;
    box-sizing: border-box;
    align-items: center;
    padding: 16px 12px;
    gap: 8px;
  }

  .nutrition-table-head {
    align-items: flex-start;
    flex: none;
    border: 1px solid rgba(255, 255, 255, 0.07);
  }

  .nutrition-table-head .nutrition-cell-name {
    color: #a1a1ab;
    font-size: var(--nut-fs-head);
    font-weight: 600;
    line-height: 1.25;
  }

  .nutrition-table-head .nutrition-cell-value {
    color: #a1a1ab;
    font-size: var(--nut-fs-head);
    font-weight: 600;
    line-height: 1.25;
  }

  .nutrition-rows {
    display: flex;
    width: 100%;
    min-height: 0;
    flex: 1;
    flex-direction: column;
    /* Moravi y Reset no entran completos en 1080px: la barra queda siempre
       visible para que se note que la lista continúa. */
    overflow-y: auto;
    scrollbar-color: #cba34e rgba(255, 255, 255, 0.06);
    scrollbar-width: thin;
  }

  .nutrition-rows::-webkit-scrollbar {
    width: 6px;
  }

  .nutrition-rows::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.06);
  }

  .nutrition-rows::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background: #cba34e;
  }

  .nutrition-row {
    flex: none;
  }

  .nutrition-row[hidden] {
    display: none;
  }

  .nutrition-row {
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .nutrition-cell-name {
    width: 122px;
    flex: none;
    color: #ffffff;
    font-size: var(--nut-fs-row);
    font-weight: 400;
    line-height: 1.25;
    /* Los valores traen "\n" para partir kcal/kj en dos líneas */
    white-space: pre-line;
  }

  .nutrition-cell-value {
    flex: 1;
    color: #ffffff;
    font-size: var(--nut-fs-row);
    font-weight: 400;
    line-height: 1.25;
    text-align: right;
    white-space: pre-line;
  }

  .nutrition-cell-value:last-child {
    font-weight: 600;
  }

  .nutrition-row--group .nutrition-cell-name {
    font-weight: 600;
  }

  .nutrition-row--sub {
    padding-left: 16px;
  }

  .nutrition-row--sub .nutrition-cell-name {
    width: 118px;
  }

  .nutrition-row--energy .nutrition-cell-name {
    color: #cba34e;
    font-size: var(--nut-fs-energy);
    font-weight: 600;
    line-height: 1.25;
  }

  .nutrition-row--energy .nutrition-cell-value {
    font-size: var(--nut-fs-energy);
    font-weight: 600;
    line-height: 1.25;
  }

  .nutrition-disclaimer {
    flex: none;
    margin: 8px 0 0;
    color: #71717a;
    font-size: var(--nut-fs-note);
    font-weight: 400;
    line-height: 1.4;
  }

  /* Pager */

  .nutrition-pager {
    display: flex;
    flex: none;
    align-items: center;
    align-self: center;
    gap: 12px;
  }

  .nutrition-pager-btn {
    display: flex;
    width: 38px;
    height: 32px;
    box-sizing: border-box;
    align-items: center;
    justify-content: center;
    padding: 4px 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    background: transparent;
    color: #ffffff;
    cursor: pointer;
    font-family: inherit;
    font-size: var(--nut-fs-label);
    font-weight: 400;
    line-height: 1.2;
    transition: background-color 0.2s, border-color 0.2s;
  }

  .nutrition-pager-btn.is-active {
    border-color: #ffffff;
    background: rgba(255, 255, 255, 0.05);
    font-weight: 600;
  }

  .nutrition-pager[hidden] {
    display: none;
  }

  /* Close controls */

  .nutrition-close-icon {
    position: absolute;
    top: 6px;
    right: 6px;
    display: flex;
    width: 30px;
    height: 30px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
  }

  .nutrition-close-icon svg {
    width: 18px;
    height: 18px;
    fill: #ffffff;
    transition: fill 0.2s;
  }

  .nutrition-close-icon:hover svg {
    fill: #e9c267;
  }

  .nutrition-footer {
    display: flex;
    width: 100%;
    flex: none;
    justify-content: center;
    padding: 12px;
  }

  .nutrition-close-text {
    padding: 0;
    border: none;
    background: transparent;
    color: #ffffff;
    cursor: pointer;
    font-family: inherit;
    font-size: var(--nut-fs-label);
    font-weight: 600;
    line-height: 1.25;
    text-decoration: underline;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .nutrition-close-text:hover {
    color: #e9c267;
  }

  .nutrition-close-icon:focus-visible,
  .nutrition-close-text:focus-visible,
  .nutrition-pager-btn:focus-visible {
    outline: 2px solid #e9c267;
    outline-offset: 3px;
  }
</style>
