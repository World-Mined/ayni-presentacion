---
---

<style>
  .brand-gold-text {
    color: var(--color-brand-gold);
  }

  .brand-gold-background {
    background-color: var(--color-brand-gold);
  }

  .install-button {
    border-color: var(--color-brand-gold);
    color: var(--color-brand-gold);
  }

  .install-button:hover {
    background-color: var(--color-brand-gold);
  }

  @media (max-width: 1024px) {
    .fixed.top-6.right-6.z-\[9998\].flex.flex-col.gap-3.pointer-events-none {
      display: none !important;
    }

    #connectivity-status,
    #pwa-install-btn {
      display: none !important;
    }
  }
</style>

<!-- Install Prompt & Connectivity Toast Container -->
<div class="fixed top-6 right-6 z-[9998] flex flex-col gap-3 pointer-events-none">
  
  <!-- Online/Offline Connection Status Indicator (Sleek Glassmorphic Pill) -->
  <div 
    id="connectivity-status" 
    class="flex items-center gap-2 rounded-full border border-gray-700 bg-black/80 px-4 py-2 text-xs font-semibold text-gray-300 shadow-[0_4px_12px_rgba(0,0,0,0.5)] backdrop-blur-md opacity-0 pointer-events-auto transition-all duration-300 transform -translate-y-4"
  >
    <span id="status-dot" class="h-2 w-2 rounded-full bg-green-500"></span>
    <span id="status-text">Conectado</span>
  </div>

  <!-- Install App Button (Hidden by default, shown when installable) -->
  <button
    id="pwa-install-btn"
    class="install-button hidden flex items-center gap-2 rounded-full border bg-black/90 px-5 py-2.5 text-xs font-bold shadow-[0_0_20px_rgba(243,200,100,0.2)] hover:shadow-[0_0_30px_rgba(243,200,100,0.4)] backdrop-blur-md pointer-events-auto hover:text-black transition-all duration-300"
  >
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
    </svg>
    Instalar Diapositivas Offline
  </button>
</div>

<!-- iOS Install Manual Instructions Overlay Modal -->
<div 
  id="ios-install-modal" 
  class="fixed inset-0 z-[10000] hidden items-center justify-center bg-black/80 px-4 backdrop-blur-sm"
>
  <div class="w-full max-w-sm rounded-2xl border border-gray-800 bg-[#121212] p-6 shadow-2xl">
    <div class="flex items-center justify-between border-b border-gray-800 pb-3">
      <h3 class="brand-gold-text text-base font-bold">Instalar en tu iPhone/iPad</h3>
      <button id="close-ios-modal-btn" class="text-gray-400 hover:text-white">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="mt-4 space-y-4 text-sm text-gray-300 leading-relaxed">
      <p>Para tener acceso sin conexión a esta presentación desde la pantalla de inicio, sigue estos pasos:</p>
      
      <div class="flex gap-3 items-center bg-white/5 p-3 rounded-lg border border-white/10">
        <div class="flex-shrink-0 flex items-center justify-center h-8 w-8 rounded-full bg-white/10 text-white font-bold">1</div>
        <div>
          Pulsa el botón de <strong>Compartir</strong> en la barra inferior de Safari:
          <div class="mt-1.5 flex justify-center">
            <!-- iOS Safari Share Icon -->
            <svg class="brand-gold-text h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" />
              <polyline points="16 6 12 2 8 6" />
              <line x1="12" y1="2" x2="12" y2="15" />
            </svg>
          </div>
        </div>
      </div>

      <div class="flex gap-3 items-center bg-white/5 p-3 rounded-lg border border-white/10">
        <div class="flex-shrink-0 flex items-center justify-center h-8 w-8 rounded-full bg-white/10 text-white font-bold">2</div>
        <div>
          Desplázate hacia abajo y selecciona <strong>Añadir a pantalla de inicio</strong>.
        </div>
      </div>
    </div>
    <button 
      id="close-ios-modal-btn-confirm" 
      class="brand-gold-background mt-6 w-full rounded-xl py-3 text-sm font-bold text-black hover:bg-white transition-colors"
    >
      Entendido
    </button>
  </div>
</div>

<script>
  // Detect if already installed / in standalone mode
  const isStandalone = () => {
    return window.matchMedia('(display-mode: standalone)').matches || (window.navigator as any).standalone === true;
  };

  // Detect iOS Safari
  const isIOS = () => {
    return /iPad|iPhone|iPod/.test(navigator.userAgent) && !(window as any).MSStream;
  };

  // 1. Connection Status Handler
  const statusEl = document.getElementById('connectivity-status');
  const statusDot = document.getElementById('status-dot');
  const statusText = document.getElementById('status-text');

  function updateConnectionStatus() {
    if (!statusEl || !statusDot || !statusText) return;

    if (navigator.onLine) {
      statusDot.className = 'h-2 w-2 rounded-full bg-green-500';
      statusText.innerText = 'En línea';
      
      // Temporarily show the connected toast and then hide it
      statusEl.classList.remove('opacity-0', '-translate-y-4');
      setTimeout(() => {
        statusEl.classList.add('opacity-0', '-translate-y-4');
      }, 3000);
    } else {
      statusDot.className = 'h-2 w-2 rounded-full bg-red-500 animate-pulse';
      statusText.innerText = 'Sin conexión (Modo Offline)';
      
      // Permanently show offline status until reconnected
      statusEl.classList.remove('opacity-0', '-translate-y-4');
    }
  }

  window.addEventListener('online', updateConnectionStatus);
  window.addEventListener('offline', updateConnectionStatus);
  
  // Initial check
  if (!navigator.onLine) {
    updateConnectionStatus();
  }

  // 2. Install Prompt Handler
  let deferredPrompt: any = null;
  const installBtn = document.getElementById('pwa-install-btn');
  const iosModal = document.getElementById('ios-install-modal');

  // Only run installation logic if not already standalone
  if (!isStandalone()) {
    // A. Android / Desktop flow using standard beforeinstallprompt
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      if (installBtn) {
        installBtn.classList.remove('hidden');
      }
    });

    // B. iOS Safari flow
    if (isIOS() && installBtn) {
      installBtn.classList.remove('hidden');
      installBtn.addEventListener('click', () => {
        if (iosModal) {
          iosModal.classList.remove('hidden');
          iosModal.classList.add('flex');
        }
      });
    }

    // Install button click trigger
    installBtn?.addEventListener('click', async () => {
      if (isIOS()) return; // Handled by standard flow above

      if (deferredPrompt) {
        deferredPrompt.prompt();
        const { outcome } = await deferredPrompt.userChoice;
        console.log(`User response to install: ${outcome}`);
        deferredPrompt = null;
        installBtn.classList.add('hidden');
      }
    });
  }

  // Close iOS modal handlers
  const closeIOSModal = () => {
    if (iosModal) {
      iosModal.classList.add('hidden');
      iosModal.classList.remove('flex');
    }
  };

  document.getElementById('close-ios-modal-btn')?.addEventListener('click', closeIOSModal);
  document.getElementById('close-ios-modal-btn-confirm')?.addEventListener('click', closeIOSModal);
  iosModal?.addEventListener('click', (e) => {
    if (e.target === iosModal) {
      closeIOSModal();
    }
  });
</script>
