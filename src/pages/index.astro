---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PWA from '../components/PWA.astro';
import InstallPrompt from '../components/InstallPrompt.astro';
import DesktopSlideHeader from '../components/DesktopSlideHeader.astro';
import NutritionSidebar from '../components/NutritionSidebar.astro';
import WorldGenLogo from '../components/WorldGenLogo.astro';
import MobileMenu from '../components/mobile/MobileMenu.astro';
import MobileStage from '../components/mobile/MobileStage.astro';
import { SLIDES } from '../data/slides';
import { SlideId } from '../data/slide-ids';
import { NUTRITION_FACTS, NUTRITION_SIDEBAR_ANCHOR } from '../data/nutrition';
import { getMobileBackAction, getMobileNextAction } from '../data/mobile-scenes';

---

<Layout title="AYNI - El Retorno Sagrado de la Energía">
  
  <!-- Presentation Viewport Container -->
  <div class="slide-container">
    <div id="presentation-wrapper" class="slide-content-wrapper">
      
      {SLIDES.map((slide) => {
        const mobileBackAction = getMobileBackAction(slide);
        const mobileNextAction = getMobileNextAction(slide);
        const isInitialSlide = slide.id === SlideId.Home;
        const isMobileFormulaImage = slide.id.endsWith('-formula');
        const nutritionFacts = NUTRITION_FACTS[slide.id];
        const ingredientsLink = (slide.header?.activeTab && !isMobileFormulaImage)
          ? slide.header.nextSlide
          : undefined;

        return (
          <section
            id={`slide-${slide.id}`}
            class="slide"
            data-slide-id={slide.id}
            data-prev={(slide.header?.disableArrows || slide.header?.disablePrevArrow) ? "" : (slide.header?.prevSlide || "")}
            data-next={(slide.header?.disableArrows || slide.header?.disableNextArrow) ? "" : (slide.header?.nextSlide || "")}
            data-close={slide.header?.disableClose ? "" : (slide.header?.closeTo || "")}
            data-mobile-prev={mobileBackAction?.target || ""}
            data-mobile-next={mobileNextAction?.target || ""}
          >
            <div class="slide-backdrop" aria-hidden="true">
              <Image
                src={slide.bgImage}
                alt=""
                class="slide-backdrop-img"
                widths={[960, 1440, 1920]}
                sizes="100vw"
                quality={82}
              />
            </div>

            <div class="desktop-scroll-canvas">
            <div class="slide-frame">
              <!-- Slide Background Artwork -->
              <div class="slide-bg">
                <Image
                  src={slide.bgImage}
                  alt={slide.name}
                  class="slide-bg-img"
                  widths={[960, 1440, 1920]}
                  sizes="100vw"
                  quality={82}
                  priority={isInitialSlide}
                />
              </div>

              {slide.buttons && (
                <div class="buttons-container">
                  {slide.buttons.map((btn) => (
                    btn.disabled ? (
                      <div
                        class="interactive-btn disabled"
                        style={`left: ${btn.x}px; top: ${btn.y}px; width: ${btn.width}px; height: ${btn.height}px;`}
                      >
                        <Image
                          src={btn.image}
                          alt={btn.name}
                          class="btn-card-img"
                          widths={[250, 375, 500]}
                          sizes="26vw"
                          quality={82}
                        />
                      </div>
                    ) : (
                      <a
                        href={`#${btn.linkTo}`}
                        class="interactive-btn"
                        style={`left: ${btn.x}px; top: ${btn.y}px; width: ${btn.width}px; height: ${btn.height}px;`}
                      >
                        <Image
                          src={btn.image}
                          alt={btn.name}
                          class="btn-card-img"
                          widths={[250, 375, 500]}
                          sizes="26vw"
                          quality={82}
                        />
                      </a>
                    )
                  ))}
                </div>
              )}

              {ingredientsLink && (
                <a href={`#${ingredientsLink}`} class="slide-pill slide-pill--ingredients">
                  <span>Ver ingredientes</span>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" aria-hidden="true">
                    <path d="M647-440H160v-80h487L423-744l57-56 320 320-320 320-57-56 224-224Z" />
                  </svg>
                </a>
              )}

              {nutritionFacts && (
                <button type="button" class="slide-pill slide-pill--nutrition" data-nutrition-open>
                  <span>Ver tabla nutricional</span>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" aria-hidden="true">
                    <path d="M647-440H160v-80h487L423-744l57-56 320 320-320 320-57-56 224-224Z" />
                  </svg>
                </button>
              )}

              <WorldGenLogo />
            </div>
            </div>

            {slide.header && <DesktopSlideHeader header={slide.header} />}

            {nutritionFacts && (
              <NutritionSidebar facts={nutritionFacts} anchor={NUTRITION_SIDEBAR_ANCHOR} />
            )}

            <MobileStage
              slide={slide}
              backAction={mobileBackAction}
              nextAction={mobileNextAction}
              priority={isInitialSlide}
            />
          </section>
        );
      })}

    </div>
  </div>

  <MobileMenu />
  <!-- PWA components -->
  <PWA />
  <InstallPrompt />

</Layout>

<style>
  .slide-backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-color: #000000;
  }

  .slide-backdrop-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(26px) brightness(0.34) saturate(0.86);
    transform: scale(1.08);
    opacity: 0.92;
    pointer-events: none;
  }

  .slide-pill {
    position: absolute;
    right: 120px;
    bottom: 40px;
    z-index: 30;
    display: flex;
    height: 48px;
    box-sizing: border-box;
    align-items: center;
    justify-content: center;
    padding: 12px 16px 12px 20px;
    border: 1px solid var(--color-brand-gold);
    border-radius: 100px;
    background: rgba(0, 0, 0, 0.25);
    color: var(--color-brand-gold);
    cursor: pointer;
    font-family: 'Montserrat', sans-serif;
    font-size: 20px;
    font-weight: 600;
    gap: 10px;
    line-height: 24px;
    text-decoration: none;
    transition: background-color 0.2s, border-color 0.2s, transform 0.2s;
  }

  .slide-pill span {
    text-decoration: underline;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .slide-pill svg {
    width: 24px;
    height: 24px;
    flex: none;
    fill: var(--color-brand-gold);
  }

  .slide-pill--ingredients {
    width: 275px;
  }

  .slide-pill--nutrition {
    width: 338px;
  }

  .slide-pill:hover {
    background: rgba(243, 200, 100, 0.14);
    transform: scale(1.02);
  }

  .slide-pill:active {
    transform: scale(0.98);
  }

  .slide-pill:focus-visible {
    outline: 2px solid var(--color-brand-gold);
    outline-offset: 3px;
  }

  html[data-presentation-mode='mobile'] .slide-pill {
    display: none;
  }

  .slide.nutrition-open .slide-pill--nutrition {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }

  .slide-frame {
    position: absolute;
    top: 0;
    left: 0;
    width: 1920px;
    height: 1080px;
    transform-origin: top left;
    transform: translate3d(var(--slide-frame-left), var(--slide-frame-top), 0) scale(var(--slide-frame-scale));
    will-change: transform;
  }

  /* La navegación queda inerte: con la tabla abierta no se cambia de producto.
     El header vive en otro componente, de ahí el :global. */
  .slide.nutrition-open .buttons-container,
  .slide.nutrition-open .slide-pill,
  .slide.nutrition-open :global(.worldgen-logo) {
    pointer-events: none;
  }

  .slide.nutrition-open :global(.desktop-slide-header) {
    opacity: 0.35;
    pointer-events: none;
    transition: opacity 0.28s ease;
  }

  .slide.nutrition-open :global(.header-left),
  .slide.nutrition-open :global(.header-center) {
    pointer-events: none;
  }

  .desktop-scroll-canvas {
    display: contents;
  }

  html[data-presentation-mode='desktop'] .slide {
    overflow: auto;
    overscroll-behavior: auto;
    scrollbar-color: var(--color-brand-gold) rgba(0, 0, 0, 0.72);
    scrollbar-width: thin;
  }

  html[data-presentation-mode='desktop'][data-desktop-scale-mode='contain'] .slide {
    overflow: hidden;
  }

  html[data-presentation-mode='desktop'] .slide::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  html[data-presentation-mode='desktop'] .slide::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.72);
  }

  html[data-presentation-mode='desktop'] .slide::-webkit-scrollbar-thumb {
    border: 2px solid rgba(0, 0, 0, 0.72);
    border-radius: 999px;
    background: var(--color-brand-gold);
  }

  html[data-presentation-mode='desktop'] .slide .desktop-scroll-canvas {
    position: relative;
    display: block;
    width: max(100%, var(--slide-rendered-width));
    height: max(100%, var(--slide-rendered-height));
  }

  html[data-presentation-mode='desktop'] .slide .slide-frame {
    top: 50%;
    left: 50%;
    transform-origin: center;
    transform: translate3d(-50%, -50%, 0) scale(var(--slide-frame-scale));
  }

  /* Layout & Scaling Wrapper */
  .slide-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  
  .slide-bg-img {
    width: 100%;
    height: 100%;
    object-fit: fill;
    pointer-events: none;
  }

  html[data-presentation-mode='compact'] .slide-backdrop-img {
    filter: blur(18px) brightness(0.3) saturate(0.82);
    transform: scale(1.12);
  }

  /* Interactive overlay buttons */
  .buttons-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 5;
    pointer-events: none;
  }

  .interactive-btn {
    position: absolute;
    display: block;
    pointer-events: auto;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    transform: scale(1);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.3s ease;
  }

  .interactive-btn:hover {
    transform: scale(1.03);
    box-shadow: 0 0 35px rgba(243, 200, 100, 0.4);
  }

  .interactive-btn:active {
    transform: scale(0.98);
  }

  .interactive-btn.disabled {
    pointer-events: none;
    opacity: 0.3;
    filter: grayscale(100%);
    box-shadow: none;
  }

  .btn-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

</style>

<script>
  const root = document.documentElement;
  const wrapper = document.getElementById('presentation-wrapper');
  const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
  const mobileBreakpoint = 1024;
  const tabletBreakpoint = 1440;
  const coarsePointerQuery = window.matchMedia('(pointer: coarse)');

  function setMobileMenuOpen(isOpen) {
    const shouldOpen = Boolean(isOpen) && root.dataset.presentationMode === 'mobile';
    root.classList.toggle('mobile-menu-open', shouldOpen);
    if (mobileMenuOverlay) {
      mobileMenuOverlay.hidden = !shouldOpen;
    }
  }

  function positionDesktopSlide(slide) {
    if (!(slide instanceof HTMLElement)) return;

    slide.scrollTo({
      left: 0,
      top: 0,
    });
  }

  function resizePresentation() {
    if (!wrapper) return;

    const baseWidth = 1920;
    const baseHeight = 1080;
    const visualViewport = window.visualViewport;
    const windowWidth = Math.round(visualViewport?.width || window.innerWidth);
    const windowHeight = Math.round(visualViewport?.height || window.innerHeight);
    const isTouchDevice = navigator.maxTouchPoints > 0 || coarsePointerQuery.matches;
    const isPortrait = windowHeight >= windowWidth;
    const isMobile = windowWidth <= mobileBreakpoint
      || (isTouchDevice && isPortrait && windowWidth <= tabletBreakpoint);

    if (isMobile) {
      root.dataset.presentationMode = 'mobile';
      delete root.dataset.desktopScaleMode;
      root.style.setProperty('--slide-frame-scale', '1');
      root.style.setProperty('--slide-frame-left', '0px');
      root.style.setProperty('--slide-frame-top', '0px');
      root.style.setProperty('--slide-rendered-width', `${baseWidth}px`);
      root.style.setProperty('--slide-rendered-height', `${baseHeight}px`);
      root.style.setProperty('--mobile-vw', `${windowWidth}px`);
      root.style.setProperty('--mobile-vh', `${windowHeight}px`);
      return;
    }

    const widthScale = windowWidth / baseWidth;
    const heightScale = windowHeight / baseHeight;
    const containScale = Math.min(widthScale, heightScale);
    // Every desktop slide shares the same 16:9 contain scale. This keeps
    // navigation, text and imagery visually consistent between routes.
    const scale = containScale;
    const frameWidth = baseWidth * scale;
    const frameHeight = baseHeight * scale;

    setMobileMenuOpen(false);
    root.dataset.presentationMode = 'desktop';
    root.dataset.desktopScaleMode = 'contain';
    root.style.setProperty('--slide-frame-scale', String(scale));
    root.style.setProperty('--slide-frame-left', '0px');
    root.style.setProperty('--slide-frame-top', '0px');
    root.style.setProperty('--slide-rendered-width', `${frameWidth}px`);
    root.style.setProperty('--slide-rendered-height', `${frameHeight}px`);
    requestAnimationFrame(() => {
      const slide = document.querySelector('.slide.active');
      positionDesktopSlide(slide);
    });
  }

  window.addEventListener('resize', resizePresentation);
  window.visualViewport?.addEventListener('resize', resizePresentation);
  resizePresentation();
  document.addEventListener('DOMContentLoaded', resizePresentation);


  let activeSlideId = 'home';

  function route() {
    const hash = window.location.hash.substring(1);
    const targetId = hash || 'home';
    const targetSlide = document.getElementById(`slide-${targetId}`);

    if (targetSlide) {
      document.querySelectorAll('.slide.active').forEach((slide) => {
        slide.classList.remove('active');
        slide.setAttribute('aria-hidden', 'true');
      });

      targetSlide.classList.add('active');
      targetSlide.setAttribute('aria-hidden', 'false');
      activeSlideId = targetId;
      setMobileMenuOpen(false);
      closeAllNutritionPanels();

      // Each slide opens at the top and stays horizontally locked to the
      // viewport. Only vertical content scrolling is allowed on mobile.
      const scroller = targetSlide.querySelector('.mobile-scroll');
      if (scroller) {
        scroller.scrollTop = 0;
        scroller.scrollLeft = 0;
      }

      resizePresentation();
      requestAnimationFrame(() => {
        if (root.dataset.presentationMode !== 'desktop') return;
        positionDesktopSlide(targetSlide);
      });
    }
  }

  window.addEventListener('hashchange', route);
  route();

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    if (target.closest('[data-mobile-menu-open]')) {
      setMobileMenuOpen(true);
      return;
    }

    if (target.closest('[data-mobile-menu-close]') || target.closest('[data-mobile-menu-link]')) {
      setMobileMenuOpen(false);
      return;
    }

    if (target === mobileMenuOverlay) {
      setMobileMenuOpen(false);
      return;
    }

    const openTrigger = target.closest('[data-nutrition-open]');
    if (openTrigger) {
      setNutritionOpen(openTrigger.closest('.slide'), true);
      return;
    }

    if (target.closest('[data-nutrition-close]')) {
      setNutritionOpen(target.closest('.slide'), false);
    }
  });

  // Con la tabla abierta, cualquier clic fuera del panel solo la cierra: no debe
  // llegar a los tabs de producto ni a ningún otro control de la slide.
  document.addEventListener('click', (event) => {
    const openSlide = document.querySelector('.slide.nutrition-open');
    if (!openSlide) return;

    const target = event.target;
    if (target instanceof Element && target.closest('[data-nutrition-panel]')) return;

    event.preventDefault();
    event.stopPropagation();
    setNutritionOpen(openSlide, false);
  }, true);

  function setNutritionOpen(slide, isOpen) {
    if (!slide) return;
    slide.classList.toggle('nutrition-open', isOpen);
    const panel = slide.querySelector('[data-nutrition-panel]');
    if (panel) panel.setAttribute('aria-hidden', String(!isOpen));
    // El panel repagina contra el alto disponible, que depende de la escala.
    if (isOpen) document.dispatchEvent(new CustomEvent('nutrition:layout'));
  }

  function closeAllNutritionPanels() {
    document.querySelectorAll('.slide.nutrition-open').forEach((slide) => {
      setNutritionOpen(slide, false);
    });
  }

  window.addEventListener('keydown', (e) => {
    if (root.classList.contains('mobile-menu-open')) {
      if (e.key === 'Escape') {
        e.preventDefault();
        setMobileMenuOpen(false);
      }
      return;
    }

    const openPanelSlide = document.querySelector('.slide.nutrition-open');
    if (openPanelSlide) {
      if (e.key === 'Escape') {
        e.preventDefault();
        setNutritionOpen(openPanelSlide, false);
      }
      return;
    }

    const currentSlide = document.getElementById(`slide-${activeSlideId}`);
    if (!currentSlide) return;

    const prev = currentSlide.getAttribute('data-prev');
    const next = currentSlide.getAttribute('data-next');
    const close = currentSlide.getAttribute('data-close');

    if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'Enter') {
      if (next) {
        e.preventDefault();
        window.location.hash = `#${next}`;
      }
    } else if (e.key === 'ArrowLeft' || e.key === 'Backspace') {
      if (prev) {
        e.preventDefault();
        window.location.hash = `#${prev}`;
      }
    } else if (e.key === 'Escape') {
      if (close) {
        e.preventDefault();
        window.location.hash = `#${close}`;
      }
    }
  });


  let touchStartX = 0;
  let touchStartY = 0;
  let touchEndX = 0;
  let touchEndY = 0;

  document.addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].screenX;
    touchStartY = e.changedTouches[0].screenY;
  }, { passive: true });

  document.addEventListener('touchend', (e) => {
    touchEndX = e.changedTouches[0].screenX;
    touchEndY = e.changedTouches[0].screenY;
    handleSwipeGesture();
  }, { passive: true });

  function handleSwipeGesture() {
    if (root.classList.contains('mobile-menu-open')) {
      return;
    }

    const deltaX = touchEndX - touchStartX;
    const deltaY = touchEndY - touchStartY;

    if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) > 60) {
      const currentSlide = document.getElementById(`slide-${activeSlideId}`);
      if (!currentSlide) return;

      // On mobile, swipe follows the same prev/next as the bottom bar.
      const isMobile = root.dataset.presentationMode === 'mobile';
      const prev = currentSlide.getAttribute(isMobile ? 'data-mobile-prev' : 'data-prev');
      const next = currentSlide.getAttribute(isMobile ? 'data-mobile-next' : 'data-next');

      if (deltaX < 0) {
        if (next) {
          window.location.hash = `#${next}`;
        }
      } else {
        if (prev) {
          window.location.hash = `#${prev}`;
        }
      }
    }
  }
</script>
