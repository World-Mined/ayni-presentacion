---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PWA from '../components/PWA.astro';
import InstallPrompt from '../components/InstallPrompt.astro';
import DesktopSlideHeader from '../components/DesktopSlideHeader.astro';
import NutritionSidebar from '../components/NutritionSidebar.astro';
import WorldGenLogo from '../components/WorldGenLogo.astro';
import Icon from '../components/Icon.astro';
import MobileMenu from '../components/mobile/MobileMenu.astro';
import MobileStage from '../components/mobile/MobileStage.astro';
import { SLIDES } from '../data/slides';
import { SlideId } from '../data/slide-ids';
import { NUTRITION_FACTS, NUTRITION_SIDEBAR_ANCHOR } from '../data/nutrition';
import { getMobileBackAction, getMobileNextAction } from '../data/mobile-scenes';

---

<Layout title="AYNI - El Retorno Sagrado de la Energía">
  
  <!-- Presentation Viewport Container -->
  <div class="slide-container">
    <div id="presentation-wrapper" class="slide-content-wrapper">
      
      {SLIDES.map((slide) => {
        const mobileBackAction = getMobileBackAction(slide);
        const mobileNextAction = getMobileNextAction(slide);
        const isInitialSlide = slide.id === SlideId.Home;
        const isMobileFormulaImage = slide.id.endsWith('-formula');
        const nutritionFacts = NUTRITION_FACTS[slide.id];
        const ingredientsLink = (slide.header?.activeTab && !isMobileFormulaImage)
          ? slide.header.nextSlide
          : undefined;

        return (
          <section
            id={`slide-${slide.id}`}
            class="slide"
            data-slide-id={slide.id}
            data-prev={(slide.header?.disableArrows || slide.header?.disablePrevArrow) ? "" : (slide.header?.prevSlide || "")}
            data-next={(slide.header?.disableArrows || slide.header?.disableNextArrow) ? "" : (slide.header?.nextSlide || "")}
            data-close={slide.header?.disableClose ? "" : (slide.header?.closeTo || "")}
            data-mobile-prev={mobileBackAction?.target || ""}
            data-mobile-next={mobileNextAction?.target || ""}
          >
            <div class="slide-backdrop" aria-hidden="true">
              <Image
                src={slide.bgImage}
                alt=""
                class="slide-backdrop-img"
                widths={[960, 1440, 1920]}
                sizes="100vw"
                quality={82}
              />
            </div>

            <div class="desktop-scroll-canvas">
            <div class="slide-frame">
              <!-- Slide Background Artwork -->
              <div class="slide-bg">
                <Image
                  src={slide.bgImage}
                  alt={slide.name}
                  class="slide-bg-img"
                  widths={[960, 1440, 1920]}
                  sizes="100vw"
                  quality={82}
                  priority={isInitialSlide}
                />
              </div>

              {slide.buttons && (
                <div class="buttons-container">
                  {slide.buttons.map((btn) => (
                    btn.disabled ? (
                      <div
                        class="interactive-btn disabled"
                        style={`left: ${btn.x}px; top: ${btn.y}px; width: ${btn.width}px; height: ${btn.height}px;`}
                      >
                        <Image
                          src={btn.image}
                          alt={btn.name}
                          class="btn-card-img"
                          widths={[250, 375, 500]}
                          sizes="26vw"
                          quality={82}
                        />
                      </div>
                    ) : (
                      <a
                        href={`#${btn.linkTo}`}
                        class="interactive-btn"
                        style={`left: ${btn.x}px; top: ${btn.y}px; width: ${btn.width}px; height: ${btn.height}px;`}
                      >
                        <Image
                          src={btn.image}
                          alt={btn.name}
                          class="btn-card-img"
                          widths={[250, 375, 500]}
                          sizes="26vw"
                          quality={82}
                        />
                      </a>
                    )
                  ))}
                </div>
              )}

              {ingredientsLink && (
                <a href={`#${ingredientsLink}`} class="slide-pill slide-pill--ingredients">
                  <span>Ver ingredientes</span>
                  <Icon name="arrow-forward" />
                </a>
              )}

              {nutritionFacts && (
                <button type="button" class="slide-pill slide-pill--nutrition" data-nutrition-open>
                  <span>Ver tabla nutricional</span>
                  <Icon name="arrow-forward" />
                </button>
              )}

              <WorldGenLogo />
            </div>
            </div>

            {slide.header && <DesktopSlideHeader header={slide.header} />}

            {nutritionFacts && (
              <NutritionSidebar facts={nutritionFacts} anchor={NUTRITION_SIDEBAR_ANCHOR} />
            )}

            <MobileStage
              slide={slide}
              backAction={mobileBackAction}
              nextAction={mobileNextAction}
              priority={isInitialSlide}
            />
          </section>
        );
      })}

    </div>
  </div>

  <MobileMenu />
  <!-- PWA components -->
  <PWA />
  <InstallPrompt />

</Layout>

<style>
  .slide-backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-color: #000000;
  }

  .slide-backdrop-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(26px) brightness(0.34) saturate(0.86);
    transform: scale(1.08);
    opacity: 0.92;
    pointer-events: none;
  }

  .slide-pill {
    position: absolute;
    right: 120px;
    bottom: 40px;
    z-index: 30;
    display: flex;
    height: 48px;
    box-sizing: border-box;
    align-items: center;
    justify-content: center;
    padding: 12px 16px 12px 20px;
    border: 1px solid var(--color-brand-gold);
    border-radius: 100px;
    background: rgba(0, 0, 0, 0.25);
    color: var(--color-brand-gold);
    cursor: pointer;
    font-family: 'Montserrat', sans-serif;
    font-size: 20px;
    font-weight: 600;
    gap: 10px;
    line-height: 24px;
    text-decoration: none;
    transition: background-color 0.2s, border-color 0.2s, transform 0.2s;
  }

  .slide-pill span {
    text-decoration: underline;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .slide-pill--ingredients {
    width: 275px;
  }

  .slide-pill--nutrition {
    width: 338px;
  }

  .slide-pill:hover {
    background: rgba(243, 200, 100, 0.14);
    transform: scale(1.02);
  }

  .slide-pill:active {
    transform: scale(0.98);
  }

  .slide-pill:focus-visible {
    outline: 2px solid var(--color-brand-gold);
    outline-offset: 3px;
  }

  html[data-presentation-mode='mobile'] .slide-pill {
    display: none;
  }

  .slide.nutrition-open .slide-pill--nutrition {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }

  .slide-frame {
    position: absolute;
    top: 0;
    left: 0;
    width: 1920px;
    height: 1080px;
    transform-origin: top left;
    transform: translate3d(var(--slide-frame-left), var(--slide-frame-top), 0) scale(var(--slide-frame-scale));
    will-change: transform;
  }

  /* La navegación queda inerte: con la tabla abierta no se cambia de producto.
     El header vive en otro componente, de ahí el :global. */
  .slide.nutrition-open .buttons-container,
  .slide.nutrition-open .slide-pill,
  .slide.nutrition-open :global(.worldgen-logo) {
    pointer-events: none;
  }

  .slide.nutrition-open :global(.desktop-slide-header) {
    opacity: 0.35;
    pointer-events: none;
    transition: opacity 0.28s ease;
  }

  .slide.nutrition-open :global(.header-left),
  .slide.nutrition-open :global(.header-center) {
    pointer-events: none;
  }

  .desktop-scroll-canvas {
    display: contents;
  }

  html[data-presentation-mode='desktop'] .slide {
    overflow: auto;
    overscroll-behavior: auto;
    scrollbar-color: var(--color-brand-gold) rgba(0, 0, 0, 0.72);
    scrollbar-width: thin;
  }

  html[data-presentation-mode='desktop'][data-desktop-scale-mode='contain'] .slide {
    overflow: hidden;
  }

  html[data-presentation-mode='desktop'] .slide::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  html[data-presentation-mode='desktop'] .slide::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.72);
  }

  html[data-presentation-mode='desktop'] .slide::-webkit-scrollbar-thumb {
    border: 2px solid rgba(0, 0, 0, 0.72);
    border-radius: 999px;
    background: var(--color-brand-gold);
  }

  html[data-presentation-mode='desktop'] .slide .desktop-scroll-canvas {
    position: relative;
    display: block;
    width: max(100%, var(--slide-rendered-width));
    height: max(100%, var(--slide-rendered-height));
  }

  html[data-presentation-mode='desktop'] .slide .slide-frame {
    top: 50%;
    left: 50%;
    transform-origin: center;
    transform: translate3d(-50%, -50%, 0) scale(var(--slide-frame-scale));
  }

  /* Layout & Scaling Wrapper */
  .slide-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  
  .slide-bg-img {
    width: 100%;
    height: 100%;
    object-fit: fill;
    pointer-events: none;
  }

  html[data-presentation-mode='compact'] .slide-backdrop-img {
    filter: blur(18px) brightness(0.3) saturate(0.82);
    transform: scale(1.12);
  }

  /* Interactive overlay buttons */
  .buttons-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 5;
    pointer-events: none;
  }

  .interactive-btn {
    position: absolute;
    display: block;
    pointer-events: auto;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    transform: scale(1);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.3s ease;
  }

  .interactive-btn:hover {
    transform: scale(1.03);
    box-shadow: 0 0 35px rgba(243, 200, 100, 0.4);
  }

  .interactive-btn:active {
    transform: scale(0.98);
  }

  .interactive-btn.disabled {
    pointer-events: none;
    opacity: 0.3;
    filter: grayscale(100%);
    box-shadow: none;
  }

  .btn-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

</style>

<script>
  import { initPresentation } from '../scripts/presentation/presentation';

  initPresentation();
</script>
