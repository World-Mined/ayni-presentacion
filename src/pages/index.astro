---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import PWA from '../components/PWA.astro';
import InstallPrompt from '../components/InstallPrompt.astro';
import DesktopSlideHeader from '../components/DesktopSlideHeader.astro';
import { SLIDES, type Slide } from '../data/slides';
import {
  MOBILE_FIGMA_BACKGROUNDS,
  MOBILE_HOME_BACKGROUND,
  MOBILE_HOME_CARD_IMAGES,
  MOBILE_MENU_ASSETS,
  MOBILE_PRICING_ASSETS,
  MOBILE_PRODUCTS_BACKGROUND,
  MOBILE_PRODUCTS_CARD_IMAGES,
} from '../data/images';

const MOBILE_PRICING_CARDS = [
  {
    pack: '05 DOYPACK',
    price: 'S/.450.00',
    points: '60 PUNTOS',
  },
  {
    pack: '08 DOYPACK',
    price: 'S/.720.00',
    points: '100 PUNTOS',
  },
] as const;

interface MobileComposedSceneCard {
  name: string;
  image: ImageMetadata;
  linkTo?: string;
  disabled?: boolean;
}

interface MobileComposedSceneConfig {
  id: 'home' | 'productos';
  background: ImageMetadata;
  stackTop: number;
  cards: MobileComposedSceneCard[];
  footer?: {
    backTarget: string;
    nextTarget?: string;
  };
}

const MOBILE_COMPOSED_SCENE_STACKS = {
  home: {
    top: 271,
  },
  productos: {
    top: 260,
  },
} as const;

function getMobileBackAction(slide: Slide) {
  if (slide.id === 'home' || slide.id === 'precios') {
    return null;
  }

  if (slide.id === 'productos') {
    return {
      target: 'home',
      label: 'Atrás',
    };
  }

  const target = slide.header?.prevSlide || slide.header?.closeTo;
  if (!target) {
    return null;
  }

  return {
    target,
    label: 'Atrás',
  };
}

function getMobileNextAction(slide: Slide) {
  if (slide.id === 'home') {
    return null;
  }

  if (slide.id === 'productos') {
    return null;
  }

  if (slide.id === 'precios') {
    return {
      target: slide.header?.closeTo || 'home',
      label: 'Ir a inicio',
    };
  }

  if (slide.header?.nextSlide) {
    return {
      target: slide.header.nextSlide,
      label: 'Siguiente',
    };
  }

  if ((slide.id === 'bonos-2' || slide.id === 'precios') && slide.header?.closeTo) {
    return {
      target: slide.header.closeTo,
      label: 'Ir a inicio',
    };
  }

  return null;
}

function toMobileCqw(value: number) {
  return `${(value / 390) * 100}cqw`;
}

function getMobileComposedScene(slide: Slide): MobileComposedSceneConfig | null {
  if (slide.id === 'home') {
    return {
      id: 'home',
      background: MOBILE_HOME_BACKGROUND,
      stackTop: MOBILE_COMPOSED_SCENE_STACKS.home.top,
      cards: (slide.buttons || []).map((button) => ({
        name: button.name,
        image: MOBILE_HOME_CARD_IMAGES[button.name] || button.image,
        linkTo: button.disabled ? undefined : button.linkTo,
        disabled: button.disabled,
      })),
    };
  }

  if (slide.id === 'productos') {
    return {
      id: 'productos',
      background: MOBILE_PRODUCTS_BACKGROUND,
      stackTop: MOBILE_COMPOSED_SCENE_STACKS.productos.top,
      cards: (slide.buttons || []).map((button) => ({
        name: button.name,
        image: MOBILE_PRODUCTS_CARD_IMAGES[button.name] || button.image,
        linkTo: button.linkTo,
      })),
      footer: {
        backTarget: slide.header?.closeTo || 'home',
      },
    };
  }

  return null;
}

---

<Layout title="AYNI - El Retorno Sagrado de la Energía">
  
  <!-- Presentation Viewport Container -->
  <div class="slide-container">
    <div id="presentation-wrapper" class="slide-content-wrapper">
      
      {SLIDES.map((slide) => {
        const mobileBackAction = getMobileBackAction(slide);
        const mobileNextAction = getMobileNextAction(slide);
        const mobileComposedScene = getMobileComposedScene(slide);
        const mobileFigmaBg = MOBILE_FIGMA_BACKGROUNDS[slide.id] || null;
        const isMobilePricingScene = slide.id === 'precios';
        const isInitialSlide = slide.id === 'home';
        // Product slides keep their original poster artwork, but mobile always
        // fits it to the viewport width so the document never pans sideways.
        const isMobileProductImage = !mobileComposedScene && !!slide.header?.activeTab;
        const isMobileFormulaImage = slide.id.endsWith('-formula');

        return (
          <section
            id={`slide-${slide.id}`}
            class="slide"
            data-slide-id={slide.id}
            data-prev={(slide.header?.disableArrows || slide.header?.disablePrevArrow) ? "" : (slide.header?.prevSlide || "")}
            data-next={(slide.header?.disableArrows || slide.header?.disableNextArrow) ? "" : (slide.header?.nextSlide || "")}
            data-close={slide.header?.disableClose ? "" : (slide.header?.closeTo || "")}
            data-mobile-prev={mobileBackAction?.target || ""}
            data-mobile-next={mobileNextAction?.target || ""}
          >
            <div class="slide-backdrop" aria-hidden="true">
              <Image
                src={slide.bgImage}
                alt=""
                class="slide-backdrop-img"
                widths={[960, 1440, 1920]}
                sizes="100vw"
                quality={82}
              />
            </div>

            <div class="desktop-scroll-canvas">
            <div class="slide-frame">
              <!-- Slide Background Artwork -->
              <div class="slide-bg">
                <Image
                  src={slide.bgImage}
                  alt={slide.name}
                  class="slide-bg-img"
                  widths={[960, 1440, 1920]}
                  sizes="100vw"
                  quality={82}
                  priority={isInitialSlide}
                />
              </div>

              {slide.buttons && (
                <div class="buttons-container">
                  {slide.buttons.map((btn) => (
                    btn.disabled ? (
                      <div
                        class="interactive-btn disabled"
                        style={`left: ${btn.x}px; top: ${btn.y}px; width: ${btn.width}px; height: ${btn.height}px;`}
                      >
                        <Image
                          src={btn.image}
                          alt={btn.name}
                          class="btn-card-img"
                          widths={[250, 375, 500]}
                          sizes="26vw"
                          quality={82}
                        />
                      </div>
                    ) : (
                      <a
                        href={`#${btn.linkTo}`}
                        class="interactive-btn"
                        style={`left: ${btn.x}px; top: ${btn.y}px; width: ${btn.width}px; height: ${btn.height}px;`}
                      >
                        <Image
                          src={btn.image}
                          alt={btn.name}
                          class="btn-card-img"
                          widths={[250, 375, 500]}
                          sizes="26vw"
                          quality={82}
                        />
                      </a>
                    )
                  ))}
                </div>
              )}
            </div>
            </div>

            {slide.header && <DesktopSlideHeader header={slide.header} />}

            <div class="mobile-stage">
              <div class="mobile-backdrop" aria-hidden="true">
                <Image
                  src={isMobilePricingScene
                    ? MOBILE_PRICING_ASSETS.background
                    : mobileFigmaBg
                    || mobileComposedScene?.background
                    || (slide.id === 'home'
                      ? MOBILE_HOME_BACKGROUND
                      : slide.id === 'productos'
                        ? MOBILE_PRODUCTS_BACKGROUND
                        : slide.bgImage)}
                  alt=""
                  class="mobile-backdrop-img"
                  widths={[390, 780, 1080]}
                  sizes="100vw"
                  quality={82}
                />
              </div>

              <div class:list={['mobile-scroll', isMobileProductImage && 'mobile-scroll--product']}>
                {isMobilePricingScene ? (
                  <div class="mobile-scene mobile-pricing-scene">
                    <Image
                      src={MOBILE_PRICING_ASSETS.background}
                      alt=""
                      class="mobile-pricing-background"
                      widths={[390, 780, 1080]}
                      sizes="100vw"
                      quality={82}
                    />
                    <div class="mobile-pricing-glow" aria-hidden="true"></div>

                    <Image
                      src={MOBILE_PRICING_ASSETS.logo}
                      alt="AYNI"
                      class="mobile-pricing-logo"
                      widths={[121, 241]}
                      sizes="31vw"
                      quality={82}
                    />

                    <div class="mobile-pricing-heading">
                      <span>DESCUBRE Y CONECTA CON</span>
                      <strong>EL PODER DE LA NATURALEZA</strong>
                    </div>

                    <div class="mobile-pricing-products" aria-label="Productos AYNI">
                      <Image
                        src={MOBILE_PRICING_ASSETS.moravi}
                        alt="Moravi 360"
                        class="mobile-pricing-product mobile-pricing-product--moravi"
                        widths={[220, 440, 660]}
                        sizes="48vw"
                        quality={82}
                      />
                      <Image
                        src={MOBILE_PRICING_ASSETS.capucci}
                        alt="Capucci 360"
                        class="mobile-pricing-product mobile-pricing-product--capucci"
                        widths={[220, 440, 660]}
                        sizes="56vw"
                        quality={82}
                      />
                      <Image
                        src={MOBILE_PRICING_ASSETS.reset}
                        alt="Reset 360"
                        class="mobile-pricing-product mobile-pricing-product--reset"
                        widths={[220, 440, 660]}
                        sizes="48vw"
                        quality={82}
                      />
                    </div>

                    <div class="mobile-pricing-cards" aria-label="Precios de paquetes AYNI">
                      {MOBILE_PRICING_CARDS.map((card) => (
                        <div class="mobile-pricing-card">
                          <span class="mobile-pricing-pack">{card.pack}</span>
                          <strong class="mobile-pricing-price">{card.price}</strong>
                          <span class="mobile-pricing-points">{card.points}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                ) : mobileComposedScene ? (
                  <div class:list={['mobile-scene', 'mobile-composed-scene', `mobile-composed-scene--${mobileComposedScene.id}`]}>
                    <Image
                      src={mobileComposedScene.background}
                      alt={slide.name}
                      class="mobile-composed-scene-bg"
                      widths={[390, 780, 1080]}
                      sizes="100vw"
                      quality={82}
                      priority={isInitialSlide}
                    />

                    <div
                      class="mobile-composed-stack"
                      style={`--mobile-stack-top: ${toMobileCqw(mobileComposedScene.stackTop)};`}
                    >
                      {mobileComposedScene.cards.map((card) => (
                        card.linkTo ? (
                          <a href={`#${card.linkTo}`} class="mobile-composed-card" aria-label={card.name}>
                            <Image
                              src={card.image}
                              alt={card.name}
                              class="mobile-composed-card-image"
                              widths={[358, 716]}
                              sizes="92vw"
                              quality={82}
                            />
                          </a>
                        ) : (
                          <div class="mobile-composed-card mobile-composed-card--static" aria-label={card.name}>
                            <Image
                              src={card.image}
                              alt={card.name}
                              class="mobile-composed-card-image"
                              widths={[358, 716]}
                              sizes="92vw"
                              quality={82}
                            />
                          </div>
                        )
                      ))}
                    </div>
                  </div>
                ) : (
                  <div class:list={[
                    'mobile-scene',
                    'mobile-image-scene',
                    isMobileProductImage && 'mobile-image-scene--product',
                    isMobileFormulaImage && 'mobile-image-scene--formula',
                  ]}>
                    <Image
                      src={mobileFigmaBg || slide.bgImage}
                      alt={slide.name}
                      class:list={['mobile-slide-image', isMobileProductImage && 'mobile-slide-image--product']}
                      widths={[390, 780, 1080]}
                      sizes={isMobileProductImage ? '125vw' : '100vw'}
                      quality={82}
                    />
                  </div>
                )}
              </div>

              <header class="mobile-nav-bar">
                <button type="button" class="mobile-menu-btn" data-mobile-menu-open aria-label="Abrir menú">
                  <img src="/assets/mobile-topbar/menu-icon.svg" alt="" class="mobile-menu-icon" />
                </button>
              </header>

              {slide.id !== 'home' && (
                <footer class="mobile-footer">
                  {mobileBackAction ? (
                    <a href={`#${mobileBackAction.target}`} class="mobile-footer-link">
                      <img src="/assets/mobile-arrow-left.svg" alt="" class="mobile-footer-icon" />
                      <span>{mobileBackAction.label}</span>
                    </a>
                  ) : slide.id !== 'precios' ? (
                    <span class="mobile-footer-link mobile-footer-link--hidden">Atrás</span>
                  ) : null}

                  {mobileNextAction ? (
                    <a href={`#${mobileNextAction.target}`} class="mobile-footer-link mobile-footer-link--next">
                      <span>{mobileNextAction.label}</span>
                      {slide.id !== 'precios' && (
                        <img src="/assets/mobile-arrow-right.svg" alt="" class="mobile-footer-icon" />
                      )}
                    </a>
                  ) : (
                    <span class="mobile-footer-link mobile-footer-link--hidden mobile-footer-link--next">Siguiente</span>
                  )}
                </footer>
              )}
            </div>
          </section>
        );
      })}

    </div>
  </div>

  <div id="mobile-menu-overlay" class="mobile-menu-overlay" hidden>
    <div class="mobile-menu-panel" role="dialog" aria-modal="true" aria-label="Menu de navegacion">
      <div class="mobile-menu-content">
        <div class="mobile-menu-header">
          <Image
            src={MOBILE_MENU_ASSETS.ayniLogo}
            alt="AYNI"
            class="mobile-menu-brand"
            widths={[92, 184]}
            sizes="92px"
            quality={82}
          />
          <button type="button" class="mobile-menu-close" data-mobile-menu-close aria-label="Cerrar menú">
            <img src="/assets/mobile-topbar/close-icon.svg" alt="" />
          </button>
        </div>

        <nav class="mobile-menu-nav" aria-label="Secciones mobile">
          <a href="#home" class="mobile-menu-link" data-mobile-menu-link>Inicio</a>
          <a href="#productos" class="mobile-menu-link" data-mobile-menu-link>Qué es AYNI</a>
          <a href="#bonos-1" class="mobile-menu-link" data-mobile-menu-link>Bonos</a>
          <div class="mobile-menu-divider" aria-hidden="true"></div>
          <div class="mobile-menu-section-label">Productos</div>
          <a href="#capucci-360" class="mobile-menu-link" data-mobile-menu-link>Capucci 360</a>
          <a href="#moravi-360" class="mobile-menu-link" data-mobile-menu-link>Moravi 360</a>
          <a href="#reset-360" class="mobile-menu-link" data-mobile-menu-link>Reset 360</a>
          <div class="mobile-menu-divider" aria-hidden="true"></div>
          <a
            href="https://worldgen.vip/"
            class="mobile-menu-worldgen"
            target="_blank"
            rel="noopener noreferrer"
            data-mobile-menu-link
            aria-label="Visitar el sitio web de World GEN"
          >
            <Image
              src={MOBILE_MENU_ASSETS.worldgenLogo}
              alt="World GEN"
              class="mobile-menu-worldgen-logo"
              widths={[168, 336]}
              sizes="168px"
              quality={82}
            />
          </a>
        </nav>
      </div>

      <button type="button" class="mobile-menu-dismiss" data-mobile-menu-close>
        Cerrar
      </button>
    </div>
  </div>

  <!-- PWA components -->
  <PWA />
  <InstallPrompt />

</Layout>

<style>
  .slide-backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-color: #000000;
  }

  .slide-backdrop-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(26px) brightness(0.34) saturate(0.86);
    transform: scale(1.08);
    opacity: 0.92;
    pointer-events: none;
  }

  .slide-frame {
    position: absolute;
    top: 0;
    left: 0;
    width: 1920px;
    height: 1080px;
    transform-origin: top left;
    transform: translate3d(var(--slide-frame-left), var(--slide-frame-top), 0) scale(var(--slide-frame-scale));
    will-change: transform;
  }

  .desktop-scroll-canvas {
    display: contents;
  }

  html[data-presentation-mode='desktop'] .slide {
    overflow: auto;
    overscroll-behavior: auto;
    scrollbar-color: #f3c864 rgba(0, 0, 0, 0.72);
    scrollbar-width: thin;
  }

  html[data-presentation-mode='desktop'][data-desktop-scale-mode='contain'] .slide {
    overflow: hidden;
  }

  html[data-presentation-mode='desktop'] .slide::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  html[data-presentation-mode='desktop'] .slide::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.72);
  }

  html[data-presentation-mode='desktop'] .slide::-webkit-scrollbar-thumb {
    border: 2px solid rgba(0, 0, 0, 0.72);
    border-radius: 999px;
    background: #f3c864;
  }

  html[data-presentation-mode='desktop'] .slide .desktop-scroll-canvas {
    position: relative;
    display: block;
    width: max(100%, var(--slide-rendered-width));
    height: max(100%, var(--slide-rendered-height));
  }

  html[data-presentation-mode='desktop'] .slide .slide-frame {
    top: 50%;
    left: 50%;
    transform-origin: center;
    transform: translate3d(-50%, -50%, 0) scale(var(--slide-frame-scale));
  }

  .mobile-stage {
    display: none;
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-color: #000000;
    max-width: 100%;
    overscroll-behavior-x: none;
  }

  html[data-presentation-mode='mobile'] .slide-backdrop,
  html[data-presentation-mode='mobile'] .slide-frame {
    display: none;
  }

  html[data-presentation-mode='mobile'] .mobile-stage {
    display: block;
  }

  html[data-presentation-mode='mobile'] .slide-container,
  html[data-presentation-mode='mobile'] .slide-content-wrapper,
  html[data-presentation-mode='mobile'] .slide,
  html[data-presentation-mode='mobile'] .mobile-stage {
    width: var(--mobile-vw, 100%);
    max-width: 100%;
    height: var(--mobile-vh, 100dvh);
    overflow-x: clip;
  }

  .mobile-backdrop {
    position: absolute;
    inset: 0;
  }

  .mobile-backdrop-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(18px) brightness(0.22) saturate(0.72);
    transform: scale(1.14);
    opacity: 0.92;
  }

  .slide[data-slide-id='home'] .mobile-backdrop-img,
  .slide[data-slide-id='productos'] .mobile-backdrop-img {
    filter: none;
    transform: none;
    opacity: 1;
    object-position: center center;
  }

  .slide[data-slide-id='home'] .mobile-backdrop,
  .slide[data-slide-id='productos'] .mobile-backdrop {
    display: none;
  }

  /* ---- Unified mobile shell (navbar + scroll + footer) ---- */

  .mobile-scroll {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow-y: auto;
    overflow-x: hidden;
    overflow-x: clip;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    overscroll-behavior-x: none;
    touch-action: pan-y;
    -webkit-overflow-scrolling: touch;
    scrollbar-color: #f3c864 rgba(0, 0, 0, 0.72);
    scrollbar-width: thin;
    /* Image/content starts at the very top, under the pinned navbar
       (the artwork already reserves space for the top bar). */
    padding-top: 0;
    padding-bottom: calc(56px + env(safe-area-inset-bottom));
  }

  .mobile-scroll::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  .mobile-scroll::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.72);
  }

  .mobile-scroll::-webkit-scrollbar-thumb {
    border: 2px solid rgba(0, 0, 0, 0.72);
    border-radius: 999px;
    background: #f3c864;
  }

  .slide[data-slide-id='home'] .mobile-scroll,
  .slide[data-slide-id='precios'] .mobile-scroll {
    padding-bottom: 0;
  }

  .mobile-nav-bar {
    box-sizing: border-box;
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    z-index: 5;
    display: flex;
    width: 100%;
    height: 56px;
    align-items: center;
    justify-content: flex-end;
    padding: 0 16px;
    background: #000000;
    line-height: 1;
  }

  .mobile-menu-btn,
  .mobile-menu-close,
  .mobile-menu-dismiss {
    appearance: none;
    border: 0;
    background: transparent;
    color: #f3c864;
    font: inherit;
    cursor: pointer;
  }

  .mobile-menu-btn {
    display: inline-flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .mobile-menu-icon {
    display: block;
    width: 40px;
    height: 40px;
  }

  .mobile-scene {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  /* Slide image: fit width, scroll vertically to reveal the rest */
  .mobile-image-scene {
    display: block;
    width: 100%;
  }

  .mobile-slide-image {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Both bonus artworks are 9:16 posters. Their responsive canvas fills tall
     phones, keeps at least the full viewport width on tablets, and remains a
     real vertical scroll area so content hidden behind the fixed bars can be
     reached naturally. */
  .slide:is([data-slide-id='bonos-1'], [data-slide-id='bonos-2']) .mobile-scroll {
    box-sizing: border-box;
    overflow-y: auto;
    overflow-x: hidden;
    overflow-x: clip;
    overscroll-behavior-y: contain;
    padding-bottom: calc(56px + env(safe-area-inset-bottom));
  }

  .slide:is([data-slide-id='bonos-1'], [data-slide-id='bonos-2']) .mobile-image-scene {
    position: relative;
    left: 50%;
    width: max(100%, calc(var(--mobile-vh) * 0.5625));
    max-width: none;
    transform: translateX(-50%);
  }

  .slide:is([data-slide-id='bonos-1'], [data-slide-id='bonos-2']) .mobile-slide-image {
    width: 100%;
    height: auto;
    max-width: none;
  }

  /* The AYNI Estrella artwork places its logo very close to the poster edge.
     Keep it below the pinned navbar while preserving normal vertical scroll. */
  .slide[data-slide-id='bonos-2'] .mobile-scroll {
    padding-top: 40px;
  }

  /* Product artwork only scrolls vertically on mobile. Its width is always
     constrained to the visual viewport, including iPhone Safari. */
  .mobile-scroll--product {
    overflow-y: auto;
    overflow-x: hidden;
    overflow-x: clip;
    overscroll-behavior-x: none;
    overscroll-behavior-y: contain;
    touch-action: pan-y;
  }

  .mobile-image-scene--product {
    position: relative;
    left: 50%;
    display: block;
    width: max(125vw, 390px, calc((var(--mobile-vh) - 56px) * 0.5625));
    max-width: none;
    transform: translateX(-50%);
  }

  .slide[data-slide-id='reset-360'] .mobile-image-scene--product {
    left: calc(50% + 8px);
    width: max(122vw, 390px, calc((var(--mobile-vh) - 50px) * 0.5625));
    margin-top: -6px;
    margin-left: 0;
  }

  /* Formula slides are also product scenes; scope the override to the double
     class so it wins on intent, not on declaration order. */
  .mobile-image-scene--product.mobile-image-scene--formula {
    width: max(106vw, 390px, calc((var(--mobile-vh) - 112px) * 0.5625));
    margin-top: 56px;
  }

  .slide[data-slide-id='moravi-formula'] .mobile-image-scene--formula {
    left: calc(50% - 7px);
    width: max(112vw, 390px, calc((var(--mobile-vh) - 65px) * 0.5625));
    margin-top: 9px;
    margin-right: 0;
  }
  .slide[data-slide-id='reset-formula'] .mobile-image-scene--formula {
